# vpanel configuration
# Copy to .env and adjust

# Panel web port
PANEL_PORT=3001
# Panel REST API port
API_PORT=3002

# Public URL of the panel (used for email links, webhooks)
PANEL_URL=http://localhost:3001

# JWT secret - CHANGE THIS
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES=7d

# Database file
DB_PATH=./data/vpanel.db

# VM storage directory (QEMU disk images)
VM_DIR=./vms

# Auto SSH port range for new VMs (inclusive)
AUTO_PORT_MIN=25501
AUTO_PORT_MAX=25600

# Auto VNC port range for new VMs (used by the noVNC graphical console)
AUTO_VNC_PORT_MIN=25901
AUTO_VNC_PORT_MAX=26000

# Auto agent port range for new VMs (vPanel agent -> File Manager API)
AUTO_AGENT_PORT_MIN=26101
AUTO_AGENT_PORT_MAX=26200

# Default admin account fallback (used only by `npm run createuser`)
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@vpanel.local
ADMIN_PASSWORD=admin12345

# SMTP (optional, used for Forgot Password / Email Verification)
MAIL_HOST=
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASS=
MAIL_FROM=vpanel <no-reply@vpanel.local>

# Enable registration (1/0)
ALLOW_REGISTER=1

# 4kwallpapers.com API key (optional)
WALLPAPERS_API_KEY=

# Log level
LOG_LEVEL=info
