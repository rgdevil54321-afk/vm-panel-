# Groq API Configuration
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Ollama Configuration (optional)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=

# Server Configuration
HOST=0.0.0.0
PORT=8000

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW=60

# API Keys File
API_KEY_FILE=api_keys.db

# Admin Dashboard (required for /admin/* endpoints, header: X-Admin-Token)
# Change this in production!
ADMIN_TOKEN=vlix-admin-token

# Require a valid API key on /v1/* endpoints (true/false)
REQUIRE_API_KEY=false

# Sandboxed file tools root directory (used by /v1/tools/*)
TOOL_WORKSPACE=data/workspace

# CORS origins allowed to call this API (comma-separated, * for all)
CORS_ORIGINS=*

# Logging
LOG_LEVEL=info
