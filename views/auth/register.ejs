<%- include('../partials/head', { title: 'Register' }) %>
<%- include('../partials/ambient') %>
<style>
.vrg-sso { display: flex; align-items: center; justify-content: center; gap: 10px; width: 100%; padding: 12px; border-radius: 10px;
  background: linear-gradient(135deg, #5865F2, #4752C4); color: #fff; font-weight: 700; font-size: 14px; text-decoration: none;
  border: 1px solid rgba(255,255,255,0.18); box-shadow: 0 10px 26px rgba(88,101,242,0.4); font-family: inherit;
  transition: transform 0.15s ease, box-shadow 0.15s ease, filter 0.15s ease; }
.vrg-sso:hover { transform: translateY(-1px); filter: brightness(1.07); box-shadow: 0 14px 32px rgba(88,101,242,0.55); }
.vrg-or { position: relative; margin: 18px 0 14px; text-align: center; }
.vrg-or::before { content: ""; position: absolute; top: 50%; left: 0; right: 0; height: 1px; background: var(--border); }
.vrg-or span { position: relative; background: var(--bg-card); padding: 0 12px; font-size: 11.5px; color: var(--text-dim); font-weight: 600; letter-spacing: 0.6px; }
</style>
<div class="auth-wrap">
  <div class="auth-card" style="position:relative;overflow:hidden">
    <div style="position:absolute;top:-50px;left:50%;transform:translateX(-50%);width:200px;height:120px;background:var(--accent);filter:blur(80px);opacity:0.35;pointer-events:none"></div>
    
    <div class="auth-logo" style="display:flex;flex-direction:column;align-items:center;margin-bottom:18px">
      <% const pn = settings['panel.name'] || 'Venlix Nodes'; %>
      <div style="width:48px;height:48px;border-radius:14px;background:linear-gradient(135deg, var(--accent), var(--accent-2));display:grid;place-items:center;color:#fff;box-shadow:0 0 20px var(--accent-glow);margin-bottom:12px">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" width="24" height="24"><rect x="2" y="2" width="20" height="8" rx="2"/><rect x="2" y="14" width="20" height="8" rx="2"/><path d="M6 6h.01M6 18h.01"/></svg>
      </div>
      <span style="font-size:24px;font-weight:800;letter-spacing:-0.5px;background:linear-gradient(90deg,#fff 40%,var(--accent-2));-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent"><%= pn %></span>
    </div>

    <h1 class="auth-title" style="font-size:20px;font-weight:700">Create your account</h1>
    <p class="auth-sub" style="margin-bottom:20px">Deploy and manage high-performance cloud instances</p>

    <% if (typeof allowed !== 'undefined' && !allowed) { %>
      <div class="alert alert-error mb-3">Registration is currently disabled by the administrator.</div>
      <p class="muted text-sm mb-4" style="text-align:center">New user registrations are currently closed. If you already have an account, please sign in below.</p>
      <a href="/login" class="btn btn-primary btn-block" style="padding:12px;font-weight:700;font-size:14px">
        Sign In to Your Account
      </a>
    <% } else { %>

      <% if (typeof error !== 'undefined' && error) { %><div class="alert alert-error"><%= error %></div><% } %>
      <% if (typeof success !== 'undefined' && success) { %><div class="alert alert-success"><%= success %></div><% } %>

      <% if (typeof discordLogin !== 'undefined' && discordLogin) { %>
        <a href="/auth/discord" class="vrg-sso">
          <svg viewBox="0 0 24 24" fill="currentColor" width="17" height="17"><path d="M20.317 4.3698a19.7913 19.7913 0 00-4.8851-1.5152.0741.0741 0 00-.0785.0371c-.211.3753-.4447.8648-.6083 1.2495-1.8447-.2762-3.68-.2762-5.4862 0-.1636-.3933-.4058-.8742-.6177-1.2495a.077.077 0 00-.0785-.037 19.7363 19.7363 0 00-4.8852 1.515.0699.0699 0 00-.0321.0277C.5334 9.0458-.319 13.5799.0992 18.0578a.0821.0821 0 00.0312.0561c2.0528 1.5076 4.0413 2.4228 5.9929 3.0294a.0777.0777 0 00.0842-.0276c.4616-.6304.8731-1.2952 1.226-1.9942a.076.076 0 00-.0416-.1057c-.6528-.2476-1.2743-.5495-1.8722-.8923a.077.077 0 01-.0076-.1277c.1258-.0943.2517-.1923.3718-.2914a.0743.0743 0 01.0776-.0105c3.9278 1.7933 8.18 1.7933 12.0614 0a.0739.0739 0 01.0785.0095c.1202.099.246.1981.3728.2924a.077.077 0 01-.0066.1276 12.2986 12.2986 0 01-1.873.8917.0766.0766 0 00-.0407.1067c.3604.698.7719 1.3628 1.225 1.9932a.076.076 0 00.0842.0286c1.961-.6067 3.9495-1.5219 6.0023-3.0294a.077.077 0 00.0313-.0552c.5004-5.177-.8382-9.6739-3.5485-13.6554a.061.061 0 00-.0312-.0286zM8.02 15.3312c-1.1825 0-2.1569-1.0857-2.1569-2.419 0-1.3332.9555-2.4189 2.157-2.4189 1.2108 0 2.1757 1.0952 2.1568 2.419 0 1.3332-.9555 2.4189-2.1569 2.4189zm7.9748 0c-1.1825 0-2.1569-1.0857-2.1569-2.419 0-1.3332.9554-2.4189 2.1569-2.4189 1.2108 0 2.1757 1.0952 2.1568 2.419 0 1.3332-.946 2.4189-2.1568 2.4189z"/></svg>
          Create account with Discord
        </a>
        <div class="vrg-or"><span>OR SIGN UP WITH EMAIL</span></div>
      <% } %>

      <form method="post" action="/register">
        <div class="form-group">
          <label for="name">Full Display Name</label>
          <input type="text" id="name" name="name" value="<%= typeof name !== 'undefined' ? name : '' %>" placeholder="John Doe"/>
        </div>
        <div class="form-row">
          <div class="form-group">
            <label for="username">Username</label>
            <input type="text" id="username" name="username" value="<%= typeof username !== 'undefined' ? username : '' %>" placeholder="johndoe" required/>
          </div>
          <div class="form-group">
            <label for="email">Email</label>
            <input type="email" id="email" name="email" value="<%= typeof email !== 'undefined' ? email : '' %>" placeholder="john@example.com" required/>
          </div>
        </div>
        <div class="form-row">
          <div class="form-group">
            <label for="password">Password</label>
            <input type="password" id="password" name="password" placeholder="••••••••" required/>
          </div>
          <div class="form-group">
            <label for="password2">Confirm Password</label>
            <input type="password" id="password2" name="password2" placeholder="••••••••" required/>
          </div>
        </div>
        <button type="submit" class="btn btn-primary btn-block mt-2" style="padding:12px;font-weight:700;font-size:14px">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="15" height="15" style="vertical-align:-2px;margin-right:6px"><path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="8.5" cy="7" r="4"/><line x1="20" y1="8" x2="20" y2="14"/><line x1="23" y1="11" x2="17" y2="11"/></svg>
          Create Account
        </button>
      </form>

      <div style="position:relative;margin:24px 0 16px 0;text-align:center">
        <div style="position:absolute;top:50%;left:0;right:0;height:1px;background:var(--border)"></div>
        <span style="position:relative;background:var(--bg-card);padding:0 12px;font-size:12px;color:var(--text-dim);font-weight:600">Already have an account?</span>
      </div>

      <a href="/login" class="btn btn-block" style="padding:12px;font-size:14px;font-weight:700;background:rgba(255,255,255,0.06);border:1px solid var(--border);color:#fff;text-align:center;display:block;border-radius:10px;transition:all 0.2s ease">
        Sign In
      </a>

    <% } %>
  </div>
</div>
<%- include('../partials/foot') %>
