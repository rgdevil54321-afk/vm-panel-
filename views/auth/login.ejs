<%- include('../partials/head', { title: 'Login' }) %>
<%- include('../partials/ambient') %>
<style>
.vlx-split { display: grid; grid-template-columns: 1.05fr 1fr; width: 100%; max-width: 980px; min-height: 560px;
  background: rgba(15, 23, 42, 0.85); border: 1px solid var(--border); border-radius: var(--radius-lg);
  backdrop-filter: blur(24px); -webkit-backdrop-filter: blur(24px); overflow: hidden;
  box-shadow: 0 24px 60px rgba(0, 0, 0, 0.65); animation: vpCardIn 0.4s cubic-bezier(0.2, 0.7, 0.3, 1) both; }
.vlx-art { position: relative; padding: 42px 38px; display: flex; flex-direction: column; justify-content: space-between;
  background: radial-gradient(120% 90% at 15% 10%, color-mix(in srgb, var(--accent) 30%, transparent), transparent 60%),
    radial-gradient(90% 80% at 90% 90%, color-mix(in srgb, var(--accent-2) 26%, transparent), transparent 55%),
    linear-gradient(160deg, #0b1224 0%, #0d1530 100%); overflow: hidden; }
.vlx-art::after { content: ""; position: absolute; inset: 0; opacity: 0.25; pointer-events: none;
  background-image: radial-gradient(color-mix(in srgb, var(--accent) 55%, transparent) 1px, transparent 1.4px);
  background-size: 26px 26px; }
.vlx-art > * { position: relative; z-index: 1; }
.vlx-art h2 { font-size: 30px; line-height: 1.2; font-weight: 800; letter-spacing: -0.6px; margin: 18px 0 10px; color: #fff; }
.vlx-art h2 span { background: linear-gradient(90deg, var(--accent), var(--accent-2)); -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent; }
.vlx-art p { font-size: 13.5px; color: var(--text-muted); line-height: 1.65; max-width: 340px; }
.vlx-feats { list-style: none; padding: 0; margin: 20px 0 0; display: flex; flex-direction: column; gap: 11px; }
.vlx-feats li { display: flex; gap: 10px; align-items: center; font-size: 13px; color: var(--text); }
.vlx-feats .tick { width: 20px; height: 20px; border-radius: 6px; flex: 0 0 20px; display: grid; place-items: center;
  background: color-mix(in srgb, var(--accent) 22%, transparent); color: var(--accent-2); }
.vlx-stats { display: flex; gap: 10px; }
.vlx-stats div { flex: 1; background: rgba(255,255,255,0.05); border: 1px solid var(--border); border-radius: 12px; padding: 10px 12px; }
.vlx-stats b { display: block; font-size: 16px; color: #fff; letter-spacing: -0.3px; }
.vlx-stats span { font-size: 10.5px; color: var(--text-dim); text-transform: uppercase; letter-spacing: 0.7px; }
.vlx-form { padding: 42px 38px; position: relative; display: flex; flex-direction: column; justify-content: center; }
.vlx-form::before { content: ""; position: absolute; inset: 0; border-radius: inherit; pointer-events: none;
  background: linear-gradient(135deg, color-mix(in srgb, var(--accent) 10%, transparent), transparent 45%); }
.vlx-form > * { position: relative; z-index: 1; }
.vlx-field { position: relative; }
.vlx-field label { display: block; font-size: 12px; font-weight: 600; color: var(--text-muted); margin-bottom: 7px; letter-spacing: 0.2px; }
.vlx-field input { width: 100%; padding: 12px 14px; padding-left: 40px; background: rgba(255,255,255,0.05);
  border: 1px solid var(--border); border-radius: 11px; color: #fff; font-size: 14px; outline: none;
  transition: border-color 0.15s ease, box-shadow 0.15s ease, background 0.15s ease; font-family: inherit; }
.vlx-field input::placeholder { color: rgba(255,255,255,0.32); }
.vlx-field input:focus { border-color: var(--accent); background: rgba(255,255,255,0.07); box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent) 22%, transparent); }
.vlx-field .ico { position: absolute; left: 13px; top: 37px; width: 16px; height: 16px; color: var(--text-dim); pointer-events: none; transition: color 0.15s ease; }
.vlx-field input:focus ~ .ico { color: var(--accent-2); }
.vlx-eye { position: absolute; right: 8px; top: 37px; background: none; border: 0; cursor: pointer; color: var(--text-dim);
  padding: 5px; border-radius: 8px; display: grid; place-items: center; transition: color 0.15s ease; }
.vlx-eye:hover { color: #fff; }
.vlx-submit { width: 100%; margin-top: 22px; padding: 13px; font-size: 14.5px; font-weight: 700; color: #fff; cursor: pointer;
  background: linear-gradient(135deg, var(--accent), var(--accent-2)); border: 1px solid color-mix(in srgb, var(--accent) 55%, transparent);
  border-radius: 12px; box-shadow: 0 10px 26px color-mix(in srgb, var(--accent) 35%, transparent);
  transition: transform 0.15s ease, box-shadow 0.15s ease, filter 0.15s ease; font-family: inherit; }
.vlx-submit:hover { transform: translateY(-1px); filter: brightness(1.07); box-shadow: 0 14px 32px color-mix(in srgb, var(--accent) 45%, transparent); }
.vlx-submit:active { transform: translateY(0); }
.vlx-sec { display: flex; align-items: center; gap: 12px; margin: 20px 0 14px; color: var(--text-dim); font-size: 11.5px; font-weight: 600; }
.vlx-sec::before, .vlx-sec::after { content: ""; height: 1px; background: var(--border); flex: 1; }
.vlx-alt { display: flex; flex-direction: column; gap: 10px; }
.vlx-alt a { display: flex; align-items: center; justify-content: center; gap: 8px; padding: 11px; border-radius: 11px;
  font-size: 13.5px; font-weight: 700; color: #fff; text-align: center; text-decoration: none; transition: all 0.16s ease; }
.vlx-alt .reg { background: rgba(255,255,255,0.06); border: 1px solid var(--border); }
.vlx-alt .reg:hover { background: rgba(255,255,255,0.1); transform: translateY(-1px); }
.vlx-alt .dc { background: linear-gradient(135deg, #5865F2, #7289DA); border: 1px solid rgba(255,255,255,0.15);
  box-shadow: 0 6px 18px rgba(88,101,242,0.35); }
.vlx-alt .dc:hover { transform: translateY(-1px); box-shadow: 0 10px 24px rgba(88,101,242,0.5); }
.vlx-foot { display: flex; justify-content: space-between; gap: 8px; flex-wrap: wrap; margin-top: 18px; }
.vlx-foot a { font-size: 12.5px; color: var(--text-dim); text-decoration: none; }
.vlx-foot a:hover { color: var(--accent-2); }
.vlx-logo { display: flex; align-items: center; gap: 12px; }
.vlx-logo .mark { width: 46px; height: 46px; border-radius: 14px; display: grid; place-items: center; color: #fff;
  background: linear-gradient(135deg, var(--accent), var(--accent-2)); box-shadow: 0 0 22px var(--accent-glow); }
.vlx-logo img { height: 46px; border-radius: 12px; }
.vlx-logo .name { font-size: 20px; font-weight: 800; letter-spacing: -0.4px; background: linear-gradient(90deg, #fff 45%, var(--accent-2));
  -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent; }
@media (max-width: 860px) {
  .vlx-split { grid-template-columns: 1fr; max-width: 460px; }
  .vlx-art { display: none; }
  .vlx-form { padding: 34px 26px; }
}
</style>
<div class="auth-wrap">
  <div class="vlx-split">
    <aside class="vlx-art">
      <div>
        <div class="vlx-logo">
          <% const pn = settings['panel.name'] || 'Venlix Nodes'; let lg='';
            if (settings['panel.logo_mode']==='upload' && settings['panel.logo_file']) lg=settings['panel.logo_file'];
            else if (settings['panel.logo_mode']==='url' && settings['panel.logo_url']) lg=settings['panel.logo_url']; %>
          <% if (lg) { %>
            <img src="<%= lg %>" alt="logo"/>
          <% } else { %>
            <div class="mark"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" width="24" height="24"><rect x="2" y="2" width="20" height="8" rx="2"/><rect x="2" y="14" width="20" height="8" rx="2"/><path d="M6 6h.01M6 18h.01"/></svg></div>
            <span class="name"><%= pn %></span>
          <% } %>
        </div>
        <h2>Deploy cloud VPS in <span>seconds</span></h2>
        <p>Full root access, instant provisioning, live console, backups and schedules — all from one sleek control panel.</p>
        <ul class="vlx-feats">
          <li><span class="tick"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" width="11" height="11"><path d="M20 6L9 17l-5-5"/></svg></span> KVM virtualization with dedicated resources</li>
          <li><span class="tick"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" width="11" height="11"><path d="M20 6L9 17l-5-5"/></svg></span> Web terminal, file manager &amp; scheduled tasks</li>
          <li><span class="tick"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" width="11" height="11"><path d="M20 6L9 17l-5-5"/></svg></span> Slot-limited backups with one-click restore</li>
          <li><span class="tick"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" width="11" height="11"><path d="M20 6L9 17l-5-5"/></svg></span> IP spoofing, custom neofetch &amp; Discord bot</li>
        </ul>
      </div>
      <div class="vlx-stats">
        <div><b>99.9%</b><span>Uptime</span></div>
        <div><b>&lt;30s</b><span>Boot time</span></div>
        <div><b>24/7</b><span>Support</span></div>
      </div>
    </aside>

    <section class="vlx-form">
      <div class="vx-login-glow" aria-hidden="true"></div>
      <div style="text-align:center;margin-bottom:24px">
        <div class="vlx-logo" style="justify-content:center">
          <div class="mark" style="width:42px;height:42px"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" width="21" height="21"><rect x="2" y="2" width="20" height="8" rx="2"/><rect x="2" y="14" width="20" height="8" rx="2"/><path d="M6 6h.01M6 18h.01"/></svg></div>
        </div>
        <h1 class="auth-title" style="font-size:22px;margin-top:14px">Welcome back</h1>
        <p class="auth-sub" style="margin-bottom:0">Sign in to manage your virtual cloud instances</p>
      </div>

      <% if (typeof error !== 'undefined' && error) { %>
        <div class="alert alert-error"><%= error %></div>
      <% } %>
      <% if (typeof success !== 'undefined' && success) { %>
        <div class="alert alert-success"><%= success %></div>
      <% } %>

      <form method="post" action="/login">
        <div class="vlx-field" style="margin-bottom:15px">
          <label for="username">Username or Email</label>
          <input type="text" id="username" name="username" value="<%= typeof username !== 'undefined' ? username : '' %>" required autofocus placeholder="admin"/>
          <svg class="ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
        </div>
        <div class="vlx-field" style="margin-bottom:15px">
          <label for="password">Password</label>
          <input type="password" id="password" name="password" required placeholder="••••••••"/>
          <svg class="ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
          <button type="button" class="vlx-eye" onclick="togglePw()" aria-label="Show password" id="pwEye">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8S1 12 1 12z"/><circle cx="12" cy="12" r="3"/></svg>
          </button>
        </div>
        <% if (typeof tfa !== 'undefined' && tfa) { %>
        <div class="vlx-field" style="margin-bottom:15px">
          <label for="code">Two-Factor Authenticator Code</label>
          <input type="text" id="code" name="code" placeholder="6-digit code" inputmode="numeric" required autocomplete="one-time-code"/>
          <svg class="ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="16" rx="2"/><path d="M7 9h4M7 13h10"/></svg>
        </div>
        <% } %>
        <button type="submit" class="vlx-submit">Sign In</button>
      </form>

      <div class="vlx-sec"><span>OR</span></div>

      <div class="vlx-alt">
        <a href="/register" class="reg">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="15" height="15"><path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="8.5" cy="7" r="4"/><line x1="20" y1="8" x2="20" y2="14"/><line x1="23" y1="11" x2="17" y2="11"/></svg>
          Create New Account
        </a>
        <% if (settings['panel.discord_enabled'] !== '0' && settings['panel.discord_enabled'] !== 0 && settings['panel.discord_enabled'] !== false) { const dUrl = settings['panel.discord_url'] || 'https://discord.gg/venlixnodes'; %>
        <a href="<%= dUrl %>" target="_blank" rel="noopener noreferrer" class="dc">
          <svg viewBox="0 0 24 24" fill="currentColor" width="16" height="16"><path d="M20.317 4.3698a19.7913 19.7913 0 00-4.8851-1.5152.0741.0741 0 00-.0785.0371c-.211.3753-.4447.8648-.6083 1.2495-1.8447-.2762-3.68-.2762-5.4862 0-.1636-.3933-.4058-.8742-.6177-1.2495a.077.077 0 00-.0785-.037 19.7363 19.7363 0 00-4.8852 1.515.0699.0699 0 00-.0321.0277C.5334 9.0458-.319 13.5799.0992 18.0578a.0821.0821 0 00.0312.0561c2.0528 1.5076 4.0413 2.4228 5.9929 3.0294a.0777.0777 0 00.0842-.0276c.4616-.6304.8731-1.2952 1.226-1.9942a.076.076 0 00-.0416-.1057c-.6528-.2476-1.2743-.5495-1.8722-.8923a.077.077 0 01-.0076-.1277c.1258-.0943.2517-.1923.3718-.2914a.0743.0743 0 01.0776-.0105c3.9278 1.7933 8.18 1.7933 12.0614 0a.0739.0739 0 01.0785.0095c.1202.099.246.1981.3728.2924a.077.077 0 01-.0066.1276 12.2986 12.2986 0 01-1.873.8917.0766.0766 0 00-.0407.1067c.3604.698.7719 1.3628 1.225 1.9932a.076.076 0 00.0842.0286c1.961-.6067 3.9495-1.5219 6.0023-3.0294a.077.077 0 00.0313-.0552c.5004-5.177-.8382-9.6739-3.5485-13.6554a.061.061 0 00-.0312-.0286zM8.02 15.3312c-1.1825 0-2.1569-1.0857-2.1569-2.419 0-1.3332.9555-2.4189 2.157-2.4189 1.2108 0 2.1757 1.0952 2.1568 2.419 0 1.3332-.9555 2.4189-2.1569 2.4189zm7.9748 0c-1.1825 0-2.1569-1.0857-2.1569-2.419 0-1.3332.9554-2.4189 2.1569-2.4189 1.2108 0 2.1757 1.0952 2.1568 2.419 0 1.3332-.946 2.4189-2.1568 2.4189z"/></svg>
          Join our Discord
        </a>
        <% } %>
      </div>

      <div class="vlx-foot">
        <a href="/forgot">Forgot your password?</a>
        <a href="/admin/login">Administrator? Enter the Admin Portal →</a>
      </div>
    </section>
  </div>
</div>
<script>
function togglePw() {
  const inp = document.getElementById('password');
  const show = inp.type === 'password';
  inp.type = show ? 'text' : 'password';
  document.getElementById('pwEye').innerHTML = show
    ? '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"/><line x1="1" y1="1" x2="23" y2="23"/></svg>'
    : '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8S1 12 1 12z"/><circle cx="12" cy="12" r="3"/></svg>';
}
</script>
<%- include('../partials/foot') %>
