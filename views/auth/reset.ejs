<%- include('../partials/head', { title: 'Reset Password' }) %>
<%- include('../partials/ambient') %>
<div class="auth-wrap">
  <div class="auth-card" style="position:relative;overflow:hidden">
    <div style="position:absolute;top:-50px;left:50%;transform:translateX(-50%);width:200px;height:120px;background:var(--accent);filter:blur(80px);opacity:0.35;pointer-events:none"></div>

    <div class="auth-logo" style="display:flex;flex-direction:column;align-items:center;margin-bottom:18px">
      <% const pn = settings['panel.name'] || 'Venlix Nodes'; %>
      <div style="width:48px;height:48px;border-radius:14px;background:linear-gradient(135deg, var(--accent), var(--accent-2));display:grid;place-items:center;color:#fff;box-shadow:0 0 20px var(--accent-glow);margin-bottom:12px">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" width="24" height="24"><rect x="2" y="2" width="20" height="8" rx="2"/><rect x="2" y="14" width="20" height="8" rx="2"/><path d="M6 6h.01M6 18h.01"/></svg>
      </div>
      <span style="font-size:24px;font-weight:800;letter-spacing:-0.5px;background:linear-gradient(90deg,#fff 40%,var(--accent-2));-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent"><%= pn %></span>
    </div>

    <h1 class="auth-title" style="font-size:20px;font-weight:700">Set New Password</h1>
    <p class="auth-sub" style="margin-bottom:20px">Choose a strong password for your account</p>

    <% if (typeof error !== 'undefined' && error) { %><div class="alert alert-error"><%= error %></div><% } %>
    <% if (typeof success !== 'undefined' && success) { %><div class="alert alert-success"><%= success %></div><% } %>

    <% if (typeof success !== 'undefined' && success) { %>
      <div class="auth-foot mt-3"><a href="/login" class="btn btn-primary btn-block" style="padding:12px">Sign in now</a></div>
    <% } else { %>
    <form method="post" action="/reset">
      <input type="hidden" name="token" value="<%= typeof token !== 'undefined' ? token : '' %>"/>
      <div class="form-group">
        <label for="password">New Password</label>
        <input type="password" id="password" name="password" placeholder="••••••••" required/>
      </div>
      <div class="form-group">
        <label for="password2">Confirm New Password</label>
        <input type="password" id="password2" name="password2" placeholder="••••••••" required/>
      </div>
      <button type="submit" class="btn btn-primary btn-block mt-2" style="padding:12px;font-weight:700">Save Password</button>
    </form>
    <div class="auth-foot" style="margin-top:20px"><a href="/login" style="font-weight:600">Back to login</a></div>
    <% } %>
  </div>
</div>
<%- include('../partials/foot') %>
