<%- include('../partials/head', { title: 'Admin Portal' }) %>
<%- include('../partials/ambient') %>
<div class="auth-wrap">
  <div class="auth-card auth-card--admin" style="position:relative;overflow:hidden">
    <!-- Animated ops-glow behind card -->
    <div class="vx-login-glow vx-login-glow--admin" aria-hidden="true"></div>

    <div class="auth-logo" style="display:flex;flex-direction:column;align-items:center;margin-bottom:18px">
      <div style="width:54px;height:54px;border-radius:14px;background:linear-gradient(135deg,#f59e0b,#ef4444);display:grid;place-items:center;color:#12060a;box-shadow:0 0 24px rgba(245,158,11,0.45);margin-bottom:12px">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" width="26" height="26"><path d="M12 2l7 4v6c0 5-3.5 8.5-7 10-3.5-1.5-7-5-7-10V6z"/><path d="M12 8v5M12 16h.01"/></svg>
      </div>
      <span class="admin-portal-kicker" style="font-size:11px;font-weight:800;letter-spacing:3px;color:#f59e0b">VENLIX</span>
      <span style="font-size:26px;font-weight:900;letter-spacing:-0.5px;background:linear-gradient(90deg,#f59e0b,#ef4444);-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent">Admin Portal</span>
    </div>

    <h1 class="auth-title" style="font-size:15px;font-weight:700;color:#fbbf24;text-align:center;letter-spacing:1.5px;margin-bottom:4px">RESTRICTED ACCESS</h1>
    <p class="auth-sub" style="margin-bottom:22px;text-align:center">Administrator authentication required to continue</p>

    <% if (typeof error !== 'undefined' && error) { %>
      <div class="alert alert-error"><%= error %></div>
    <% } %>
    <% if (typeof success !== 'undefined' && success) { %>
      <div class="alert alert-success"><%= success %></div>
    <% } %>

    <form method="post" action="/admin/login">
      <div class="form-group">
        <label for="username">Administrator Username</label>
        <input type="text" id="username" name="username" value="<%= typeof username !== 'undefined' ? username : '' %>" required autofocus placeholder="admin" class="admin-input"/>
      </div>
      <div class="form-group">
        <label for="password" style="margin:0">Password</label>
        <input type="password" id="password" name="password" required placeholder="••••••••" class="admin-input"/>
      </div>
      <% if (typeof tfa !== 'undefined' && tfa) { %>
      <div class="form-group">
        <label for="code">Two-Factor Authenticator Code</label>
        <input type="text" id="code" name="code" placeholder="6-digit code" inputmode="numeric" required class="admin-input"/>
      </div>
      <% } %>
      <button type="submit" class="btn btn-block mt-3" style="padding:12px;font-size:14px;font-weight:800;background:linear-gradient(135deg,#f59e0b,#ef4444);color:#12060a;border:none;box-shadow:0 8px 24px rgba(245,158,11,0.35)">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" width="15" height="15" style="vertical-align:-2px;margin-right:6px"><path d="M12 2l7 4v6c0 5-3.5 8.5-7 10-3.5-1.5-7-5-7-10V6z"/></svg>
        Access Admin Portal
      </button>
    </form>

    <div class="auth-foot" style="margin-top:22px;display:flex;justify-content:center;gap:16px">
      <a href="/forgot" style="font-size:12.5px;color:var(--text-dim)">Forgot password?</a>
      <span style="color:var(--border)">|</span>
      <a href="/login" style="font-size:12.5px;color:#f59e0b;font-weight:600">← User Panel Login</a>
    </div>
  </div>
</div>
<%- include('../partials/foot') %>