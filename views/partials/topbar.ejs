<%
const panelName = settings['panel.name'] || 'Venlix Nodes';
let logo = '';
if (settings['panel.logo_mode'] === 'upload' && settings['panel.logo_file']) logo = settings['panel.logo_file'];
else if (settings['panel.logo_mode'] === 'url' && settings['panel.logo_url']) logo = settings['panel.logo_url'];
%>
<div id="impersonationBanner" style="display:none;position:fixed;top:0;left:0;right:0;z-index:10000;background:linear-gradient(90deg,#f59e0b,#ef4444);color:#0b1020;padding:8px 14px;font-size:13px;font-weight:700;text-align:center;box-shadow:0 4px 18px rgba(0,0,0,0.35)">
  <span><%= t('topbar.impersonation') %></span>
  <button onclick="endImpersonation()" style="margin-left:10px;background:#0b1020;color:#fff;border:none;border-radius:8px;padding:4px 14px;font-size:12px;font-weight:700;cursor:pointer"><%= t('topbar.returnAdmin') %></button>
</div>
<div class="topbar">
  <button class="icon-btn hamburger" id="hamburger" aria-label="menu" style="display:none">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18M3 12h18M3 18h18"/></svg>
  </button>
  <a href="/dashboard" class="brand">
    <% if (logo) { %>
      <img src="<%= logo %>" alt="logo" style="height:32px;border-radius:8px"/>
    <% } else { %>
      <div class="brand-icon">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" width="18" height="18"><rect x="2" y="2" width="20" height="8" rx="2"/><rect x="2" y="14" width="20" height="8" rx="2"/><path d="M6 6h.01M6 18h.01"/></svg>
      </div>
    <% } %>
    <span class="brand-text"><%= panelName %></span>
    <% if (typeof admin !== 'undefined' && admin) { %><span class="admin-badge">ADMIN</span><% } %>
  </a>

  <div class="topbar-right">
    <% if (user) { %>
      <div class="topbar-search">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="15" height="15"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
        <input type="search" placeholder="<%= t('topbar.search') %>" id="globalSearch" autocomplete="off"/>
      </div>

      <% if (user.role === 'admin' || user.root_admin) { %>
        <a class="btn btn-sm hide-mobile" href="/admin" style="box-shadow:none;border-color:var(--border)">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
          Admin
        </a>
      <% } %>

      <div class="user-menu" id="userMenu">
        <button type="button" class="user-menu-btn" id="userMenuBtn" aria-haspopup="menu" aria-expanded="false">
          <div class="avatar">
            <% if (user.avatar) { %>
              <img src="<%= user.avatar %>"/>
            <% } else { %>
              <%= (user.username[0] || 'U').toUpperCase() %>
            <% } %>
          </div>
          <span class="ug-text">
            <span class="ug-name" style="display:block"><%= user.username %></span>
            <span class="ug-role" style="display:block"><%= user.role || 'user' %></span>
          </span>
          <svg class="ug-caret" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" width="13" height="13"><path d="m6 9 6 6 6-6"/></svg>
        </button>
        <div class="user-menu-dd" role="menu">
          <div class="um-head"><%= user.username %></div>
          <a href="/profile" role="menuitem">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
            <%= t('nav.profile') %>
          </a>
          <a href="/settings" role="menuitem">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z"/><circle cx="12" cy="12" r="3"/></svg>
            <%= t('nav.settings') %>
          </a>
          <div class="um-sep"></div>
          <a href="/logout" role="menuitem" class="um-danger">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4M16 17l5-5-5-5M21 12H9"/></svg>
            <%= t('topbar.logout') %>
          </a>
        </div>
      </div>
    <% } %>
  </div>
</div>
