<%
const panelName = settings['panel.name'] || 'Venlix Nodes';
let logo = '';
if (settings['panel.logo_mode'] === 'upload' && settings['panel.logo_file']) logo = settings['panel.logo_file'];
else if (settings['panel.logo_mode'] === 'url' && settings['panel.logo_url']) logo = settings['panel.logo_url'];
%>
<div class="topbar">
  <button class="icon-btn hamburger" onclick="document.querySelector('.sidebar').classList.toggle('open')" aria-label="menu" style="display:none">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18M3 12h18M3 18h18"/></svg>
  </button>
  <a href="/dashboard" class="brand">
    <% if (logo) { %>
      <img src="<%= logo %>" alt="logo" style="height:32px;border-radius:8px"/>
    <% } else { %>
      <div class="brand-icon">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" width="18" height="18"><rect x="2" y="2" width="20" height="8" rx="2"/><rect x="2" y="14" width="20" height="8" rx="2"/><path d="M6 6h.01M6 18h.01"/></svg>
      </div>
    <% } %>
    <span class="brand-text"><%= panelName %></span>
  </a>

  <div class="topbar-right">
    <% if (user) { %>
      <div class="topbar-search">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="15" height="15"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
        <input type="search" placeholder="Search servers..." id="globalSearch" autocomplete="off"/>
      </div>

      <% if (user.role === 'admin' || user.root_admin) { %>
        <a class="btn btn-sm btn-primary hide-mobile" href="/admin/servers/create" style="box-shadow:none">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14"><path d="M12 5v14M5 12h14"/></svg>
          New Server
        </a>
      <% } %>

      <div class="flex" style="gap:10px;align-items:center;background:var(--glass);border:1px solid var(--border);border-radius:30px;padding:3px 12px 3px 4px">
        <div class="avatar">
          <% if (user.avatar) { %>
            <img src="<%= user.avatar %>"/>
          <% } else { %>
            <%= (user.username[0] || 'U').toUpperCase() %>
          <% } %>
        </div>
        <div style="line-height:1.2">
          <div style="font-weight:600;font-size:13px"><%= user.username %></div>
          <div class="muted text-sm" style="font-size:10.5px;text-transform:capitalize"><%= user.role || 'user' %></div>
        </div>
        <a href="/logout" title="Logout" style="color:var(--text-dim);margin-left:4px;display:flex;align-items:center" onmouseover="this.style.color='var(--red)'" onmouseout="this.style.color='var(--text-dim)'">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="15" height="15"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4M16 17l5-5-5-5M21 12H9"/></svg>
        </a>
      </div>
    <% } %>
  </div>
</div>
