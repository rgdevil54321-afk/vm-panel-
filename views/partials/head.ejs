<%
const panelName = settings['panel.name'] || 'Venlix Nodes';
const favName = settings['panel.favicon_name'] || panelName;
let favicon = '';
if (settings['panel.favicon_mode'] === 'upload' && settings['panel.favicon_file']) favicon = settings['panel.favicon_file'];
else if (settings['panel.favicon_mode'] === 'url' && settings['panel.favicon_url']) favicon = settings['panel.favicon_url'];
if (!favicon) {
  favicon = "data:image/svg+xml," + encodeURIComponent('<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64"><rect width="64" height="64" rx="14" fill="%236366f1"/><text x="32" y="44" font-size="34" font-family="Arial" font-weight="bold" fill="#fff" text-anchor="middle">' + (favName[0] || 'V').toUpperCase() + '</text></svg>');
}
const accent = settings['panel.accent'] || '#6366f1';
const theme = settings['panel.theme'] || 'dark';
const navbarTransparent = settings['panel.navbar_transparent'] === '1' || settings['panel.navbar_transparent'] === 1 || settings['panel.navbar_transparent'] === true;
const navbarBlur = settings['panel.navbar_blur'] === '1' || settings['panel.navbar_blur'] === 1 || settings['panel.navbar_blur'] === true;
const navbarStyle = settings['panel.navbar_style'] || 'glass';
const panelDesc = settings['panel.description'] || settings['panel.meta_description'] || ('High-performance KVM VPS hosting — ' + panelName + '. Fast NVMe storage, DDoS protection and private Tailscale networking.');
const baseUrl = (typeof siteUrl !== 'undefined' && siteUrl) ? siteUrl : '';
const ogImgRaw = settings['panel.og_image'] || settings['panel.logo_url'] || settings['panel.logo_file'] || '/og-image.svg';
const ogImage = /^https?:\/\//i.test(ogImgRaw) ? ogImgRaw : (baseUrl + ogImgRaw);
const shareTitle = settings['panel.og_title'] || (panelName + ' - VPS Panel');
%><!DOCTYPE html>
<html lang="<%= typeof lang !== 'undefined' ? lang : 'en' %>" dir="<%= typeof uiDir !== 'undefined' ? uiDir : 'ltr' %>" data-theme="<%= theme %>">
<head>
<meta charset="utf-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1"/>
<meta name="referrer" content="no-referrer"/>
<title><%= panelName %> - <%= title %></title>
<meta name="description" content="<%= panelDesc %>"/>
<meta property="og:type" content="website"/>
<meta property="og:site_name" content="<%= panelName %>"/>
<meta property="og:title" content="<%= shareTitle %>"/>
<meta property="og:description" content="<%= panelDesc %>"/>
<meta property="og:image" content="<%= ogImage %>"/>
<% if (baseUrl) { %><meta property="og:url" content="<%= baseUrl %>/"/><% } %>
<meta name="twitter:card" content="summary_large_image"/>
<meta name="twitter:title" content="<%= shareTitle %>"/>
<meta name="twitter:description" content="<%= panelDesc %>"/>
<meta name="twitter:image" content="<%= ogImage %>"/>
<link rel="icon" href="<%= favicon %>"/>
<link rel="stylesheet" href="/css/panel.css?v=<%= panelBootId %>"/>
<link rel="stylesheet" href="/css/polish.css?v=<%= panelBootId %>"/>
<link rel="stylesheet" href="/css/v2.css?v=<%= panelBootId %>"/>
<script src="/js/audio.js?v=<%= panelBootId %>" defer></script>
<script src="/js/secretblur.js?v=<%= panelBootId %>" defer></script>
<% if (typeof styles !== 'undefined') { for (const s of styles) { %><link rel="stylesheet" href="<%= s %>"/><% } } %>
<% if (typeof scripts !== 'undefined') { for (const s of scripts) { %><script src="<%= s %>"></script><% } } %>
<style>:root { --accent: <%= accent %>; }</style>
<script>
window.VP_CONFIG = { apiPort: 3002 };
window.APP_SETTINGS = <%- JSON.stringify({
  music_mode: 'none',
  music_title: settings['panel.name'] || 'Music',
  ambient_user_enabled: typeof user !== 'undefined' && user ? (user.music_enabled === 1 || user.music_enabled === '1' || user.music_enabled === true) : false,
  ambient_user_volume: (typeof user !== 'undefined' && user && user.music_volume !== undefined && user.music_volume !== null) ? Number(user.music_volume) : 35,
  sfx_user_enabled: typeof user !== 'undefined' && user ? (user.sfx_enabled === undefined ? true : (user.sfx_enabled === 1 || user.sfx_enabled === '1' || user.sfx_enabled === true)) : true,
  sfx_user_volume: (typeof user !== 'undefined' && user && user.sfx_volume !== undefined && user.sfx_volume !== null) ? Number(user.sfx_volume) : 40,
  secret_blur: (typeof user !== 'undefined' && user && user.secret_blur_set === 1) ? (user.secret_blur === 1 || user.secret_blur === '1' || user.secret_blur === true) : (String(settings['panel.secret_blur']) === '1' || settings['panel.secret_blur'] === true)
}) %>;
function vpApiBase() {
  return '';
}
function vpToken() {
  const m = document.cookie.match(/(?:^|;\s*)token=([^;]+)/);
  return m ? m[1] : '';
}
</script>
</head>
<body class="<%= navbarStyle === 'glass' ? '' : 'nav-' + navbarStyle %> <%= navbarTransparent ? 'nav-transparent' : '' %> <%= navbarBlur ? 'nav-blur' : '' %> <%= settings['panel.bg_mode'] !== 'color' ? 'bg-visible' : '' %> <%= typeof admin !== 'undefined' && admin ? 'admin-portal' : '' %>">
