<%- include('../partials/head', { title: 'Create Virtual Machine' }) %>
<%- include('../partials/ambient') %>
<%- include('../partials/topbar') %>
<%- include('../partials/sidebar') %>
<div class="main">
  <div class="flex-between mb-3">
    <div>
      <div class="muted text-sm" style="font-size:12px;margin-bottom:2px">
        <a href="/admin" style="color:var(--text-dim)">Admin</a> / <a href="/admin/servers" style="color:var(--text-dim)">Servers</a> / Create
      </div>
      <h2 style="font-size:24px;font-weight:700;display:flex;align-items:center;gap:10px">
        <span style="display:inline-flex;align-items:center;justify-content:center;width:34px;height:34px;border-radius:10px;background:color-mix(in srgb, var(--accent) 25%, transparent);color:var(--accent)">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="20" height="20"><path d="M12 5v14M5 12h14"/></svg>
        </span>
        Create Virtual Machine
      </h2>
    </div>
    <a class="btn btn-sm" href="/admin/servers">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14" style="vertical-align:-2px;margin-right:4px"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
      Back to Servers
    </a>
  </div>

  <!-- Quick Template Presets -->
  <div class="card mb-4" style="background:var(--glass);border:1px solid var(--border);padding:18px">
    <div class="flex-between mb-2">
      <div style="font-weight:600;font-size:14px"> Quick Sizing Presets</div>
      <span class="muted text-sm">Click a preset to auto-configure hardware resources</span>
    </div>
    <div class="grid grid-4" style="gap:12px">
      <button type="button" class="preset-card" onclick="applyPreset(1, 1024, '10G', this)">
        <div class="preset-name"> Starter</div>
        <div class="preset-spec">1 vCPU · 1024 MB RAM</div>
        <div class="preset-disk">10 GB SSD</div>
      </button>
      <button type="button" class="preset-card active" onclick="applyPreset(2, 2048, '20G', this)">
        <div class="preset-badge">Popular</div>
        <div class="preset-name">Standard</div>
        <div class="preset-spec">2 vCPUs · 2048 MB RAM</div>
        <div class="preset-disk">20 GB SSD</div>
      </button>
      <button type="button" class="preset-card" onclick="applyPreset(4, 4096, '40G', this)">
        <div class="preset-name">🔥 Compute / Dev</div>
        <div class="preset-spec">4 vCPUs · 4096 MB RAM</div>
        <div class="preset-disk">40 GB SSD</div>
      </button>
      <button type="button" class="preset-card" onclick="applyPreset(8, 8192, '80G', this)">
        <div class="preset-name">💎 Powerhouse</div>
        <div class="preset-spec">8 vCPUs · 8192 MB RAM</div>
        <div class="preset-disk">80 GB SSD</div>
      </button>
    </div>
  </div>

  <div class="grid" style="grid-template-columns: 1fr 340px; gap: 24px; align-items: start;">
    <!-- Main Configuration Form -->
    <div style="display:flex;flex-direction:column;gap:22px">
      
      <!-- 0. Deploy Target Node -->
      <div class="card" style="padding:22px">
        <div class="card-title" style="margin-bottom:16px;font-size:16px">0 · Deploy Target Node</div>
        <div class="form-group">
          <label>Hypervisor Node *</label>
          <select id="fNode" onchange="updateSummary()">
            <% for (const n of nodes) { %>
              <option value="<%= n.id %>" <%= n.id === 1 ? 'selected' : '' %>>
                <%= n.name %> (<%= n.host %>:<%= n.port %>)<%= n.status === 'online' ? ' — Online' : ' — Offline' %>
              </option>
            <% } %>
          </select>
          <div class="form-hint">Choose which node will provision and run this virtual machine. Pick the local Primary Node or any connected remote node.</div>
        </div>
      </div>

      <!-- 1. Operating System Selection -->
      <div class="card" style="padding:22px">
        <div class="flex-between mb-3">
          <div class="card-title" style="margin:0;font-size:16px">1 · Operating System</div>
          <div class="os-filters">
            <button type="button" class="os-filter-btn active" onclick="filterOs('all', this)">All</button>
            <button type="button" class="os-filter-btn" onclick="filterOs('ubuntu', this)">Ubuntu</button>
            <button type="button" class="os-filter-btn" onclick="filterOs('debian', this)">Debian</button>
            <button type="button" class="os-filter-btn" onclick="filterOs('fedora', this)">Fedora</button>
            <button type="button" class="os-filter-btn" onclick="filterOs('rhel', this)">RHEL/Enterprise</button>
          </div>
        </div>

        <div class="grid grid-3" id="osGrid" style="gap:12px">
          <% for (let i = 0; i < osList.length; i++) { 
             const o = osList[i]; 
             const distro = (o[1] || '').toLowerCase();
             const name = o[0];
             let color = 'var(--accent)';
             let icon = '🐧';
             if (distro.includes('ubuntu')) { color = '#e95420'; icon = '🟠'; }
             else if (distro.includes('debian')) { color = '#d70a53'; icon = '🔴'; }
             else if (distro.includes('fedora')) { color = '#294172'; icon = '🔵'; }
             else if (distro.includes('centos')) { color = '#93227f'; icon = '🟣'; }
             else if (distro.includes('alma')) { color = '#0ea5e9'; icon = '🌐'; }
             else if (distro.includes('rocky')) { color = '#10b981'; icon = '🟢'; }
          %>
            <label class="os-select-card <%= i === 0 ? 'selected' : '' %>" data-distro="<%= distro %>" style="cursor:pointer;position:relative;border:2px solid <%= i === 0 ? 'var(--accent)' : 'var(--border)' %>;border-radius:14px;padding:14px;display:flex;align-items:center;gap:12px;background:var(--glass);transition:all 0.18s ease">
              <input type="radio" name="os" value="<%= o[0] %>" data-username="<%= o[4] || 'root' %>" <%= i === 0 ? 'checked' : '' %> style="display:none" onchange="selectOsCard(this)"/>
              <div style="font-size:24px;width:38px;height:38px;border-radius:10px;background:rgba(255,255,255,0.06);display:grid;place-items:center;flex-shrink:0"><%= icon %></div>
              <div style="flex:1;min-width:0">
                <div style="font-weight:700;font-size:14px;color:var(--text)"><%= o[0] %></div>
                <div class="muted text-sm mono" style="font-size:11px"><%= o[2] || 'standard' %> · x86_64</div>
              </div>
              <div class="os-check" style="width:18px;height:18px;border-radius:50%;background:<%= i === 0 ? 'var(--accent)' : 'transparent' %>;border:2px solid <%= i === 0 ? 'var(--accent)' : 'var(--border)' %>;display:grid;place-items:center">
                <svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="3" width="10" height="10" style="display:<%= i === 0 ? 'block' : 'none' %>"><path d="M20 6L9 17l-5-5"/></svg>
              </div>
            </label>
          <% } %>
        </div>
      </div>

      <!-- 2. Hardware Resources -->
      <div class="card" style="padding:22px">
        <div class="card-title" style="margin-bottom:18px;font-size:16px">2 · Hardware Sizing &amp; Resources</div>
        
        <!-- vCPUs -->
        <div class="form-group mb-4">
          <div class="flex-between mb-1">
            <label style="font-weight:600;font-size:13px">Virtual CPUs (Cores)</label>
            <span id="cpuValBadge" class="pill pill-blue mono font-bold">2 Cores</span>
          </div>
          <div class="flex" style="gap:14px;align-items:center">
            <input type="range" min="1" max="16" step="1" value="<%= settings['vm.default_cpus'] || '2' %>" id="fCpusRange" style="flex:1" oninput="syncCpu(this.value)"/>
            <input type="number" min="1" max="32" value="<%= settings['vm.default_cpus'] || '2' %>" id="fCpus" style="width:75px" oninput="syncCpu(this.value)"/>
          </div>
        </div>

        <!-- RAM -->
        <div class="form-group mb-4">
          <div class="flex-between mb-1">
            <label style="font-weight:600;font-size:13px">Memory (RAM)</label>
            <span id="memValBadge" class="pill pill-green mono font-bold">2048 MB (2.0 GB)</span>
          </div>
          <div class="flex" style="gap:14px;align-items:center">
            <input type="range" min="512" max="16384" step="256" value="<%= settings['vm.default_memory'] || '2048' %>" id="fMemRange" style="flex:1" oninput="syncMem(this.value)"/>
            <input type="number" min="256" max="65536" step="128" value="<%= settings['vm.default_memory'] || '2048' %>" id="fMem" style="width:90px" oninput="syncMem(this.value)"/>
          </div>
          <div class="flex mt-2" style="gap:6px">
            <button type="button" class="btn btn-sm" onclick="syncMem(1024)">1 GB</button>
            <button type="button" class="btn btn-sm" onclick="syncMem(2048)">2 GB</button>
            <button type="button" class="btn btn-sm" onclick="syncMem(4096)">4 GB</button>
            <button type="button" class="btn btn-sm" onclick="syncMem(8192)">8 GB</button>
            <button type="button" class="btn btn-sm" onclick="syncMem(16384)">16 GB</button>
          </div>
        </div>

        <!-- Storage Disk -->
        <div class="form-group">
          <div class="flex-between mb-1">
            <label style="font-weight:600;font-size:13px">Disk Storage</label>
            <span id="diskValBadge" class="pill pill-yellow mono font-bold"><%= settings['vm.default_disk'] || '20G' %></span>
          </div>
          <div class="flex" style="gap:10px;align-items:center">
            <input id="fDisk" value="<%= settings['vm.default_disk'] || '20G' %>" placeholder="20G" oninput="updateSummary()"/>
            <div class="flex" style="gap:6px">
              <button type="button" class="btn btn-sm" onclick="setDisk('10G')">10G</button>
              <button type="button" class="btn btn-sm" onclick="setDisk('20G')">20G</button>
              <button type="button" class="btn btn-sm" onclick="setDisk('40G')">40G</button>
              <button type="button" class="btn btn-sm" onclick="setDisk('80G')">80G</button>
            </div>
          </div>
          <div class="form-hint">Format: 20G, 50G, 100G (QEMU QCOW2 dynamic storage)</div>
        </div>
      </div>

      <!-- 3. Identity & Credentials -->
      <div class="card" style="padding:22px">
        <div class="card-title" style="margin-bottom:18px;font-size:16px">3 · Identity &amp; Credentials</div>
        
        <div class="form-row">
          <div class="form-group">
            <label>Virtual Machine Name *</label>
            <input id="fName" placeholder="e.g. web-server-01" required oninput="nameChanged(this.value)"/>
            <div class="form-hint">Alphanumeric, hyphens and underscores</div>
          </div>
          <div class="form-group">
            <label>Hostname</label>
            <input id="fHost" placeholder="auto from name" oninput="updateSummary()"/>
          </div>
        </div>

        <div class="form-row">
          <div class="form-group">
            <label>SSH Username</label>
            <div class="flex" style="gap:6px">
              <input id="fUser" value="root" placeholder="root" oninput="updateSummary()"/>
              <button type="button" class="btn btn-sm" onclick="setUser('root')">root</button>
              <button type="button" class="btn btn-sm" id="btnDistroUser" onclick="setDistroUser()">ubuntu</button>
            </div>
          </div>
          <div class="form-group">
            <label>SSH Password</label>
            <div class="flex" style="gap:6px">
              <input type="text" id="fPass" placeholder="Enter or generate password" oninput="updateSummary()"/>
              <button type="button" class="btn btn-sm btn-primary" onclick="genPassword()" title="Generate strong password">🎲 Gen</button>
              <button type="button" class="btn btn-sm" onclick="copyPassword()" title="Copy password">📋</button>
            </div>
          </div>
        </div>

        <div class="form-group mt-2">
          <label>Server Owner</label>
          <select id="fOwner" onchange="updateSummary()">
            <option value="<%= user.id %>"><%= user.username %> (you - Administrator)</option>
            <% for (const u of users) { %>
              <% if (u.id !== user.id) { %>
                <option value="<%= u.id %>"><%= u.username %> · <%= u.email %></option>
              <% } %>
            <% } %>
          </select>
        </div>
      </div>

      <!-- 4. Networking & Ports -->
      <div class="card" style="padding:22px">
        <div class="card-title" style="margin-bottom:18px;font-size:16px">4 · Networking &amp; Port Forwarding</div>
        
        <div class="form-group">
          <div class="flex-between mb-1">
            <label>SSH Port Mapping</label>
            <span class="muted text-sm">Auto-allocated from pool: <%= settings['vm.auto_port_min'] || '25501' %>-<%= settings['vm.auto_port_max'] || '25600' %></span>
          </div>
          <input id="fPort" placeholder="auto (leave blank for automatic port allocation)" oninput="updateSummary()"/>
        </div>

        <div class="form-group">
          <label>Additional Port Forwards</label>
          <div class="flex mb-2" style="gap:8px">
            <input id="fFwdCustom" placeholder="e.g. 8080:80, 8443:443" oninput="customFwdsChanged(this.value)"/>
          </div>
          <div class="flex flex-wrap" style="gap:6px">
            <span class="muted text-sm" style="margin-right:4px">Quick Add:</span>
            <button type="button" class="btn btn-sm" onclick="addFwd('80:80')">+ HTTP (80)</button>
            <button type="button" class="btn btn-sm" onclick="addFwd('443:443')">+ HTTPS (443)</button>
            <button type="button" class="btn btn-sm" onclick="addFwd('3000:3000')">+ Node/Web (3000)</button>
            <button type="button" class="btn btn-sm" onclick="addFwd('8080:8080')">+ Proxy (8080)</button>
          </div>
          <input type="hidden" id="fFwds" value=""/>
        </div>

        <div class="form-row mt-3">
          <label class="check" style="cursor:pointer">
            <input type="checkbox" id="fStartBoot" onchange="updateSummary()"/>
            <span>Start VM automatically when panel boots</span>
          </label>
          <label class="check" style="cursor:pointer">
            <input type="checkbox" id="fGui"/>
            <span>GUI Window Display (host display)</span>
          </label>
        </div>
      </div>

      <!-- 5. Image Source -->
      <div class="card" style="padding:22px">
        <div class="card-title" style="margin-bottom:14px;font-size:16px">5 · Image Source</div>
        
        <div class="grid grid-2 mb-3" style="gap:10px">
          <label class="img-mode-card active" id="modeDownloadLabel" onclick="setImgMode('download')">
            <input type="radio" name="imgSrc" value="download" checked style="display:none"/>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="26" height="26" style="opacity:0.85"><path d="M7 18a4.5 4.5 0 0 1 0-9 6 6 0 0 1 11.6-1.6A4 4 0 0 1 18 18H7z"/></svg>
            <div>
              <div style="font-weight:600">Official Cloud Image</div>
              <div class="muted text-sm" style="font-size:11px">Auto-downloaded &amp; verified (Recommended)</div>
            </div>
          </label>
          <label class="img-mode-card" id="modeUploadLabel" onclick="setImgMode('upload')">
            <input type="radio" name="imgSrc" value="upload" style="display:none"/>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="26" height="26" style="opacity:0.85"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M17 8l-5-5-5 5M12 3v13"/></svg>
            <div>
              <div style="font-weight:600">Custom Image Upload</div>
              <div class="muted text-sm" style="font-size:11px">Upload local .qcow2 or .img disk</div>
            </div>
          </label>
        </div>

        <div id="uploadBox" style="display:none;border:2px dashed var(--border);border-radius:14px;padding:24px;text-align:center;background:rgba(0,0,0,0.2)">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="38" height="38" style="opacity:0.6;margin-bottom:8px"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M7 10l5 5 5-5M12 15V3"/></svg>
          <div style="font-weight:600;margin-bottom:4px">Select your QCOW2 / RAW image file</div>
          <div class="muted text-sm mb-3">Supported formats: .qcow2, .img, .qcow (Max: 10GB)</div>
          <label class="btn btn-primary btn-sm" style="display:inline-flex;align-items:center;gap:6px;cursor:pointer">
            <span>Browse Files</span>
            <input type="file" id="fImg" accept=".qcow2,.img,.qcow" style="display:none" onchange="fileSelected(this)"/>
          </label>
          <div id="imgName" class="mono text-sm mt-2" style="color:var(--accent-2)"></div>
        </div>
      </div>
    </div>

    <!-- Live Inspector Sidebar & Launch Card -->
    <div style="position:sticky;top:calc(var(--topbar-h) + 20px);display:flex;flex-direction:column;gap:16px">
      <div class="card" style="padding:22px;border:1px solid var(--accent);background:color-mix(in srgb, var(--accent) 6%, var(--glass-strong));box-shadow:0 12px 30px rgba(0,0,0,0.3)">
        <div class="flex-between mb-3" style="border-bottom:1px solid var(--border);padding-bottom:12px">
          <div style="font-weight:700;font-size:16px">Deployment Summary</div>
          <span class="pill pill-green" id="summaryStatus">Ready</span>
        </div>

        <div style="display:flex;flex-direction:column;gap:12px;font-size:13px">
          <div class="flex-between">
            <span class="muted">OS &amp; Distro</span>
            <span class="font-bold" id="sumOs">Ubuntu 24.04</span>
          </div>
          <div class="flex-between">
            <span class="muted">Target Node</span>
            <span class="mono font-bold" id="sumNode">Primary Node</span>
          </div>
          <div class="flex-between">
            <span class="muted">VM Name</span>
            <span class="mono font-bold" id="sumName">my-vm</span>
          </div>
          <div class="flex-between">
            <span class="muted">vCPUs</span>
            <span class="mono" id="sumCpu">2 Cores</span>
          </div>
          <div class="flex-between">
            <span class="muted">Memory</span>
            <span class="mono" id="sumMem">2048 MB</span>
          </div>
          <div class="flex-between">
            <span class="muted">Disk Size</span>
            <span class="mono" id="sumDisk">20G</span>
          </div>
          <div class="flex-between">
            <span class="muted">SSH User</span>
            <span class="mono" id="sumUser">root</span>
          </div>
          <div class="flex-between">
            <span class="muted">SSH Port</span>
            <span class="mono" id="sumPort">Auto (25501-25600)</span>
          </div>
          <div class="flex-between">
            <span class="muted">Owner</span>
            <span id="sumOwner"><%= user.username %></span>
          </div>
        </div>

        <hr class="hr" style="margin:16px 0"/>

        <button class="btn btn-primary btn-block" style="padding:14px;font-size:15px;font-weight:700;letter-spacing:0.3px;display:flex;align-items:center;justify-content:center;gap:8px" id="btnCreate" onclick="createVm()">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18"><path d="M13 2 3 14h9l-1 8 10-12h-9l1-8z"/></svg>
          Deploy Virtual Machine
        </button>
        <div id="createProgress" class="muted text-sm text-center mt-2" style="display:none">
          Deploying VM and preparing storage...
        </div>
      </div>
    </div>
  </div>
</div>
<%- include('../partials/music') %>
<%- include('../partials/foot') %>

<style>
.preset-card {
  background: var(--glass);
  border: 1px solid var(--border);
  border-radius: 12px;
  padding: 14px;
  text-align: left;
  cursor: pointer;
  transition: all 0.16s ease;
  position: relative;
  color: var(--text);
}
.preset-card:hover {
  background: color-mix(in srgb, var(--accent) 12%, var(--glass));
  border-color: var(--accent);
  transform: translateY(-2px);
}
.preset-card.active {
  background: color-mix(in srgb, var(--accent) 22%, var(--glass));
  border-color: var(--accent);
  box-shadow: 0 0 16px rgba(99, 102, 241, 0.2);
}
.preset-name { font-weight: 700; font-size: 14px; margin-bottom: 2px; }
.preset-spec { font-size: 12px; color: var(--text-dim); }
.preset-disk { font-size: 11px; color: var(--accent-2); margin-top: 4px; font-weight: 600; }
.preset-badge {
  position: absolute; top: -8px; right: 10px;
  background: var(--accent); color: #fff;
  font-size: 10px; font-weight: 700; padding: 2px 7px;
  border-radius: 10px; text-transform: uppercase;
}

.os-filters { display: flex; gap: 6px; }
.os-filter-btn {
  background: transparent; border: 1px solid var(--border);
  color: var(--text-dim); padding: 4px 10px; border-radius: 8px;
  font-size: 12px; cursor: pointer; transition: 0.15s;
}
.os-filter-btn:hover { color: var(--text); }
.os-filter-btn.active {
  background: var(--accent); color: #fff; border-color: var(--accent);
}

.os-select-card:hover {
  border-color: color-mix(in srgb, var(--accent) 60%, transparent);
  transform: translateY(-1px);
}
.os-select-card.selected {
  border-color: var(--accent) !important;
  background: color-mix(in srgb, var(--accent) 14%, var(--glass)) !important;
  box-shadow: 0 0 16px rgba(99, 102, 241, 0.25);
}

.img-mode-card {
  border: 1px solid var(--border);
  border-radius: 12px;
  padding: 14px;
  display: flex;
  align-items: center;
  gap: 12px;
  background: var(--glass);
  cursor: pointer;
  transition: all 0.15s;
}
.img-mode-card:hover { border-color: var(--accent); }
.img-mode-card.active {
  border-color: var(--accent);
  background: color-mix(in srgb, var(--accent) 18%, var(--glass));
}
</style>

<script>
let currentDistroUser = 'ubuntu';

function slugify(text) {
  return String(text || '')
    .toLowerCase()
    .trim()
    .replace(/[^\w\s-]/g, '')
    .replace(/[\s_-]+/g, '-')
    .replace(/^-+|-+$/g, '');
}

function nameChanged(val) {
  const slug = slugify(val);
  const host = document.getElementById('fHost');
  if (!host.dataset.manual) {
    host.value = slug;
  }
  updateSummary();
}
document.getElementById('fHost').addEventListener('input', function() {
  this.dataset.manual = 'true';
});

function genPassword() {
  const chars = 'ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnopqrstuvwxyz23456789!@#$%';
  let pass = '';
  for (let i = 0; i < 14; i++) {
    pass += chars.charAt(Math.floor(Math.random() * chars.length));
  }
  document.getElementById('fPass').value = pass;
  VP.toast('Generated strong password', 'info');
  updateSummary();
}

function copyPassword() {
  const p = document.getElementById('fPass').value;
  if (!p) return VP.toast('No password to copy', 'error');
  navigator.clipboard.writeText(p)
    .then(() => VP.toast('Password copied!', 'success'))
    .catch(() => VP.toast('Failed to copy', 'error'));
}

function setUser(u) {
  document.getElementById('fUser').value = u;
  updateSummary();
}

function setDistroUser() {
  setUser(currentDistroUser);
}

function selectOsCard(input) {
  document.querySelectorAll('.os-select-card').forEach((c) => {
    c.classList.remove('selected');
    const check = c.querySelector('.os-check');
    if (check) {
      check.style.background = 'transparent';
      check.style.borderColor = 'var(--border)';
      const svg = check.querySelector('svg');
      if (svg) svg.style.display = 'none';
    }
  });
  const label = input.closest('label');
  label.classList.add('selected');
  const check = label.querySelector('.os-check');
  if (check) {
    check.style.background = 'var(--accent)';
    check.style.borderColor = 'var(--accent)';
    const svg = check.querySelector('svg');
    if (svg) svg.style.display = 'block';
  }

  currentDistroUser = input.dataset.username || 'ubuntu';
  document.getElementById('btnDistroUser').textContent = currentDistroUser;
  updateSummary();
}

function filterOs(category, btn) {
  document.querySelectorAll('.os-filter-btn').forEach(b => b.classList.remove('active'));
  btn.classList.add('active');
  const cards = document.querySelectorAll('.os-select-card');
  cards.forEach(card => {
    const d = card.dataset.distro || '';
    if (category === 'all') {
      card.style.display = 'flex';
    } else if (category === 'rhel') {
      card.style.display = (d.includes('centos') || d.includes('alma') || d.includes('rocky') || d.includes('fedora')) ? 'flex' : 'none';
    } else {
      card.style.display = d.includes(category) ? 'flex' : 'none';
    }
  });
}

function syncCpu(v) {
  v = Math.max(1, Math.min(32, parseInt(v, 10) || 1));
  document.getElementById('fCpus').value = v;
  document.getElementById('fCpusRange').value = v;
  document.getElementById('cpuValBadge').textContent = v + (v === 1 ? ' Core' : ' Cores');
  updateSummary();
}

function syncMem(v) {
  v = Math.max(256, Math.min(65536, parseInt(v, 10) || 512));
  document.getElementById('fMem').value = v;
  document.getElementById('fMemRange').value = v;
  const gb = (v / 1024).toFixed(1);
  document.getElementById('memValBadge').textContent = `${v} MB (${gb} GB)`;
  updateSummary();
}

function setDisk(d) {
  document.getElementById('fDisk').value = d;
  document.getElementById('diskValBadge').textContent = d;
  updateSummary();
}

function applyPreset(cpus, mem, disk, btn) {
  document.querySelectorAll('.preset-card').forEach(b => b.classList.remove('active'));
  btn.classList.add('active');
  syncCpu(cpus);
  syncMem(mem);
  setDisk(disk);
  VP.toast(`Applied ${btn.querySelector('.preset-name').textContent.trim()} preset`, 'info');
}

function addFwd(pair) {
  const cur = (document.getElementById('fFwdCustom').value || '').split(',').map(s=>s.trim()).filter(Boolean);
  if (!cur.includes(pair)) {
    cur.push(pair);
    document.getElementById('fFwdCustom').value = cur.join(', ');
    customFwdsChanged(document.getElementById('fFwdCustom').value);
  }
}

function customFwdsChanged(val) {
  document.getElementById('fFwds').value = val;
  updateSummary();
}

function setImgMode(mode) {
  document.getElementById('modeDownloadLabel').classList.toggle('active', mode === 'download');
  document.getElementById('modeUploadLabel').classList.toggle('active', mode === 'upload');
  document.getElementById('uploadBox').style.display = mode === 'upload' ? 'block' : 'none';
  updateSummary();
}

function fileSelected(input) {
  const f = input.files[0];
  const el = document.getElementById('imgName');
  if (f) {
    el.textContent = `Selected: ${f.name} (${VP.fmtBytes(f.size)})`;
  } else {
    el.textContent = '';
  }
}

function updateSummary() {
  const osEl = document.querySelector('input[name="os"]:checked');
  const osName = osEl ? osEl.value : 'Ubuntu 24.04';
  const name = document.getElementById('fName').value || 'my-vm';
  const cpus = document.getElementById('fCpus').value || '2';
  const mem = document.getElementById('fMem').value || '2048';
  const disk = document.getElementById('fDisk').value || '20G';
  const user = document.getElementById('fUser').value || 'root';
  const port = document.getElementById('fPort').value || 'Auto (25501-25600)';
  const ownerSel = document.getElementById('fOwner');
  const owner = ownerSel ? ownerSel.options[ownerSel.selectedIndex].text.split('·')[0].trim() : '';
  const nodeSel = document.getElementById('fNode');
  const nodeLabel = nodeSel ? nodeSel.options[nodeSel.selectedIndex].text.split(' (')[0].trim() : 'Primary Node';

  document.getElementById('sumOs').textContent = osName;
  document.getElementById('sumNode').textContent = nodeLabel;
  document.getElementById('sumName').textContent = slugify(name);
  document.getElementById('sumCpu').textContent = cpus + (cpus === '1' ? ' Core' : ' Cores');
  document.getElementById('sumMem').textContent = mem + ' MB (' + (parseInt(mem,10)/1024).toFixed(1) + ' GB)';
  document.getElementById('sumDisk').textContent = disk.toUpperCase();
  document.getElementById('sumUser').textContent = user;
  document.getElementById('sumPort').textContent = port ? port : 'Auto';
  document.getElementById('sumOwner').textContent = owner;
}

async function createVm() {
  const nameInput = document.getElementById('fName');
  const rawName = nameInput.value.trim();
  const slug = slugify(rawName);

  if (!slug) {
    nameInput.focus();
    return VP.toast('Please enter a valid VM name', 'error');
  }

  const btn = document.getElementById('btnCreate');
  const prog = document.getElementById('createProgress');
  btn.disabled = true;
  btn.innerHTML = '<svg class="spin" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18"><circle cx="12" cy="12" r="10" stroke-opacity="0.25"/><path d="M12 2a10 10 0 0 1 10 10"/></svg> Creating Server...';
  prog.style.display = 'block';

  const fd = new FormData();
  fd.append('os', (document.querySelector('input[name="os"]:checked') || {}).value);
  fd.append('name', slug);
  fd.append('hostname', document.getElementById('fHost').value || slug);
  fd.append('username', document.getElementById('fUser').value || 'root');
  fd.append('password', document.getElementById('fPass').value || '');
  fd.append('memory', document.getElementById('fMem').value || '2048');
  fd.append('cpus', document.getElementById('fCpus').value || '2');
  fd.append('disk_size', (document.getElementById('fDisk').value || '20G').toUpperCase());
  fd.append('ssh_port', document.getElementById('fPort').value || '');
  
  const rawFwds = document.getElementById('fFwdCustom').value || '';
  const parsedFwds = rawFwds.split(',').map(s=>s.trim()).filter(Boolean).map(p=>{
    const[h,g]=p.split(':');
    return { host: parseInt(h,10), guest: parseInt(g,10) };
  }).filter(p => !isNaN(p.host) && !isNaN(p.guest));
  fd.append('port_forwards', JSON.stringify(parsedFwds));

  fd.append('start_on_boot', document.getElementById('fStartBoot').checked ? '1' : '0');
  fd.append('gui_mode', document.getElementById('fGui').checked ? '1' : '0');
  fd.append('owner_id', document.getElementById('fOwner').value);
  fd.append('node_id', (document.getElementById('fNode') || {}).value || '1');

  if ((document.querySelector('input[name="imgSrc"]:checked') || {}).value === 'upload') {
    const f = document.getElementById('fImg').files[0];
    if (f) fd.append('image', f);
  }

  try {
    const r = await fetch('/admin/servers/create', { method: 'POST', body: fd });
    const d = await r.json();
    if (!r.ok) throw new Error(d.error || 'Failed to create server');
    VP.toast('VM Created successfully! SSH Port: ' + d.vm.ssh_port, 'success');
    setTimeout(() => { location.href = '/admin/servers/' + d.vm.id; }, 900);
  } catch (e) {
    VP.toast(e.message, 'error');
    btn.disabled = false;
    btn.innerHTML = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18"><path d="M13 2 3 14h9l-1 8 10-12h-9l1-8z"/></svg> Deploy Virtual Machine';
    prog.style.display = 'none';
  }
}

// Initial password & summary setup
const urlParams = new URLSearchParams(window.location.search);
const targetOwner = urlParams.get('owner_id');
if (targetOwner && document.getElementById('fOwner')) {
  document.getElementById('fOwner').value = targetOwner;
}
genPassword();
updateSummary();
</script>
