  background: rgba(255,255,255,0.12); border-radius: 22px; transition: 0.2s;
}
.slider:before {
  position: absolute; content: ""; height: 16px; width: 16px; left: 3px; top: 3px;
  background: #fff; border-radius: 50%; transition: 0.2s;
}
.switch input:checked + .slider { background: var(--accent); }
.switch input:checked + .slider:before { transform: translateX(18px); }

textarea { resize: vertical; }
</style>

<script>
let currentDistroUser = 'ubuntu';
let TOTAL_STEPS = 9;
let currentStep = 1;
let dataDiskSeq = 0;

/* ---------- Step navigation ---------- */
function goto(step, force) {
  if (!force) {
    if (step < currentStep) { currentStep = step; renderSteps(); return; }
    const valid = validateStep(currentStep);
    if (!valid) { document.getElementById('stepErr').textContent = 'Complete the required fields first.'; return; }
  }
  document.getElementById('stepErr').textContent = '';
  currentStep = step;
  renderSteps();
}
function renderSteps() {
  document.querySelectorAll('.wizard-step').forEach((el) => { el.style.display = 'none'; });
  const active = document.getElementById('step-' + currentStep);
  if (active) active.style.display = 'block';
  document.querySelectorAll('.wstep').forEach((b) => {
    const n = parseInt(b.dataset.step, 10);
    b.classList.toggle('active', n === currentStep);
    b.classList.toggle('done', n < currentStep);
  });
  document.getElementById('btnPrev').style.visibility = currentStep === 1 ? 'hidden' : 'visible';
  document.getElementById('btnNext').textContent = currentStep === TOTAL_STEPS ? '' : 'Continue →';
  document.getElementById('btnNext').style.display = currentStep === TOTAL_STEPS ? 'none' : 'inline-flex';
  window.scrollTo({ top: 0, behavior: 'smooth' });
  updateSummary();
}
function nextStep() {
  if (!validateStep(currentStep)) { document.getElementById('stepErr').textContent = 'Complete the required fields first.'; return; }
  document.getElementById('stepErr').textContent = '';
  if (currentStep < TOTAL_STEPS) { currentStep++; renderSteps(); }
}
function prevStep() { if (currentStep > 1) { currentStep--; renderSteps(); } }
function validateStep(step) {
  if (step === 1) {
    const slug = slugify(document.getElementById('fName').value || '');
    if (!slug) return false;
  }
  if (step === 4) {
    // every data disk must have a valid size
    const rows = document.querySelectorAll('#dataDisksList .data-disk-row');
    for (const r of rows) {
      if (!/^[0-9]+[GM]$/i.test(r.querySelector('.dd-size').value)) return false;
    }
  }
  return true;
}

/* ---------- Data disks ---------- */
function addDataDisk() {
  dataDiskSeq++;
  document.getElementById('dataDisksEmpty').style.display = 'none';
  const row = document.createElement('div');
  row.className = 'data-disk-row';
  row.innerHTML = `
    <input class="dd-name" placeholder="label (e.g. data)" oninput="updateSummary()"/>
    <select class="dd-size" onchange="updateSummary()">
      ${['10G','20G','40G','80G','100G'].map((s) => `<option value="${s}">${s}</option>`).join('')}
    </select>
    <select class="dd-bus" onchange="updateSummary()">
      <option value="virtio" selected>virtio</option>
      <option value="sata">sata</option>
      <option value="scsi">scsi</option>
    </select>
    <button type="button" class="btn btn-sm" style="color:#f87171" title="Remove" onclick="this.closest('.data-disk-row').remove();collectDataDisks();updateSummary();">✕</button>
  `;
  document.getElementById('dataDisksList').appendChild(row);
  updateSummary();
}
function collectDataDisks() {
  const out = [];
  document.querySelectorAll('#dataDisksList .data-disk-row').forEach((r) => {
    out.push({ size: r.querySelector('.dd-size').value, name: r.querySelector('.dd-name').value, bus: r.querySelector('.dd-bus').value });
  });
  return out;
}

/* ---------- Existing helpers ---------- */
function slugify(text) {
  return String(text || '').toLowerCase().trim()
    .replace(/[^\w\s-]/g, '').replace(/[\s_-]+/g, '-').replace(/^-+|-+$/g, '');
}
function nameChanged(val) {
  const slug = slugify(val);
  const host = document.getElementById('fHost');
  if (!host.dataset.manual) host.value = slug;
  updateSummary();
}
document.getElementById('fHost').addEventListener('input', function(){ this.dataset.manual = 'true'; });
function genPassword() {
  const chars = 'ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnopqrstuvwxyz23456789!@#$%';
  let pass = ''; for (let i = 0; i < 14; i++) pass += chars.charAt(Math.floor(Math.random()*chars.length));
  document.getElementById('fPass').value = pass;
  VP.toast('Generated strong password', 'info'); updateSummary();
}
function copyPassword() {
  const p = document.getElementById('fPass').value;
  if (!p) return VP.toast('No password to copy', 'error');
  navigator.clipboard.writeText(p).then(()=>VP.toast('Password copied!','success')).catch(()=>VP.toast('Failed to copy','error'));
}
function setUser(u){ document.getElementById('fUser').value = u; updateSummary(); }
function setDistroUser(){ setUser(currentDistroUser); }
function selectOsCard(input) {
  document.querySelectorAll('.os-select-card').forEach((c) => {
    c.classList.remove('selected');
    const check = c.querySelector('.os-check');
    if (check) { check.style.background='transparent'; check.style.borderColor='var(--border)'; const svg=check.querySelector('svg'); if(svg) svg.style.display='none'; }
  });
  const label = input.closest('label');
  label.classList.add('selected');
  const check = label.querySelector('.os-check');
  if (check) { check.style.background='var(--accent)'; check.style.borderColor='var(--accent)'; const svg=check.querySelector('svg'); if(svg) svg.style.display='block'; }
  currentDistroUser = input.dataset.username || 'ubuntu';
  document.getElementById('btnDistroUser').textContent = currentDistroUser;
  updateSummary();
}
function filterOs(category, btn) {
  document.querySelectorAll('.os-filter-btn').forEach(b=>b.classList.remove('active'));
  btn.classList.add('active');
  document.querySelectorAll('.os-select-card').forEach(card => {
    const d = card.dataset.distro || '';
    if (category === 'all') card.style.display = 'flex';
    else if (category === 'rhel') card.style.display = (d.includes('centos')||d.includes('alma')||d.includes('rocky')||d.includes('fedora'))?'flex':'none';
    else card.style.display = d.includes(category)?'flex':'none';
  });
}
function syncCpu(v){
  v = Math.max(1, Math.min(32, parseInt(v,10)||1));
  document.getElementById('fCpus').value = v;
  document.getElementById('fCpusRange').value = v;
  // keep topology consistent: 1 socket, vCores per socket, unchanged threads
  document.getElementById('fSockets').value = 1;
  document.getElementById('fCoresPerSocket').value = v;
  document.getElementById('cpuValBadge').textContent = v + (v===1?' Core':' Cores');
  updateSummary();
}
function syncTopology(){
  const s = Math.max(1, parseInt(document.getElementById('fSockets').value,10)||1);
  const c = Math.max(1, parseInt(document.getElementById('fCoresPerSocket').value,10)||1);
  const t = Math.max(1, parseInt(document.getElementById('fThreads').value,10)||1);
  let total = s*c*t;
  total = Math.min(32, total);
  document.getElementById('fCpus').value = total;
  document.getElementById('fCpusRange').value = total;
  document.getElementById('cpuValBadge').textContent = total + (total===1?' Core':' Cores');
  updateSummary();
}
function syncMem(v){
  v = Math.max(256, Math.min(65536, parseInt(v,10)||512));
  document.getElementById('fMem').value = v;
  document.getElementById('fMemRange').value = v;
  const gb = (v/1024).toFixed(1);
  document.getElementById('memValBadge').textContent = `${v} MB (${gb} GB)`;
  updateSummary();
}
function setDisk(d){ document.getElementById('fDisk').value=d; document.getElementById('diskValBadge').textContent=d; updateSummary(); }
function applyPreset(cpus, mem, disk, btn){
  document.querySelectorAll('.preset-card').forEach(b=>b.classList.remove('active'));
  btn.classList.add('active');
  syncCpu(cpus); syncMem(mem); setDisk(disk);
  VP.toast(`Applied ${btn.querySelector('.preset-name').textContent.trim()} preset`,'info');
}
function addFwd(pair){
  const cur=(document.getElementById('fFwdCustom').value||'').split(',').map(s=>s.trim()).filter(Boolean);
  if(!cur.includes(pair)){ cur.push(pair); document.getElementById('fFwdCustom').value=cur.join(', '); customFwdsChanged(document.getElementById('fFwdCustom').value); }
}
function customFwdsChanged(val){ document.getElementById('fFwds').value=val; updateSummary(); }
function setImgMode(mode){
  document.getElementById('modeDownloadLabel').classList.toggle('active',mode==='download');
  document.getElementById('modeUploadLabel').classList.toggle('active',mode==='upload');
  document.getElementById('uploadBox').style.display = mode==='upload'?'block':'none';
  updateSummary();
}
function fileSelected(input){
  const f=input.files[0]; const el=document.getElementById('imgName');
  el.textContent = f ? `Selected: ${f.name} (${VP.fmtBytes(f.size)})` : '';
}

/* ---------- Summary ---------- */
function field(idFallback, def){ const el = document.getElementById(idFallback); return el ? (el.value || def) : def; }
function updateSummary(){
  const osEl = document.querySelector('input[name="os"]:checked');
  const osName = osEl ? osEl.value : 'Ubuntu 24.04';
  const name = field('fName','my-vm');
  const cpus = field('fCpus','2');
  const mem = field('fMem','2048');
  const disk = field('fDisk','20G');
  const user = field('fUser','root');
  const port = field('fPort','') || 'Auto';
  const ownerSel = document.getElementById('fOwner');
  const owner = ownerSel ? ownerSel.options[ownerSel.selectedIndex].text.split('·')[0].trim() : '';
  const nodeSel = document.getElementById('fNode');
  const nodeLabel = nodeSel ? nodeSel.options[nodeSel.selectedIndex].text.split(' (')[0].trim() : 'Primary Node';
  const region = field('fRegion','—') || '—';

  const s = { os:osName, node:nodeLabel, name:slugify(name), cpu:cpus+' core(s)', mem, disk, user, port, owner, region };
  const sets = {
    sumOs: s.os, sumNode: s.node, sumName: s.name, sumCpu: s.cpu, sumMem: s.mem+' MB',
    sumDisk: s.disk.toUpperCase(), sumUser: s.user, sumPort: port, sumOwner: owner, sumRegion: s.region,
    sumFirmware: (document.getElementById('fFirmware').value||'bios').toUpperCase(),
    liveOs: s.os, liveNode: s.node, liveName: s.name, liveCpu: s.cpu, liveMem: s.mem+' MB',
    liveDisk: s.disk.toUpperCase(), liveUser: s.user, livePort: s.port, liveOwner: owner,
  };
  for (const [k,v] of Object.entries(sets)) { const el=document.getElementById(k); if(el) el.textContent=v; }
  // packages count
  const pkgs = document.getElementById('fPackages').value.split('\n').map(x=>x.trim()).filter(Boolean);
  document.getElementById('sumPkgs').textContent = pkgs.length ? pkgs.length + ' package(s)' : 'None';
}

/* ---------- Create ---------- */
async function createVm(){
  const rawName = document.getElementById('fName').value.trim();
  const slug = slugify(rawName);
  if(!slug){ document.getElementById('fName').focus(); return VP.toast('Please enter a valid VM name','error'); }

  const btn = document.getElementById('btnCreate');
  const prog = document.getElementById('createProgress');
  btn.disabled = true;
  btn.innerHTML = '<svg class="spin" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18"><circle cx="12" cy="12" r="10" stroke-opacity="0.25"/><path d="M12 2a10 10 0 0 1 10 10"/></svg> Creating Server...';
  prog.style.display = 'block';

  const fd = new FormData();
  fd.append('os', (document.querySelector('input[name="os"]:checked')||{}).value);
  fd.append('name', slug);
  fd.append('hostname', document.getElementById('fHost').value || slug);
  fd.append('username', document.getElementById('fUser').value || 'root');
  fd.append('password', document.getElementById('fPass').value || '');
  fd.append('memory', document.getElementById('fMem').value || '2048');
  fd.append('cpus', document.getElementById('fCpus').value || '2');
  fd.append('disk_size', (document.getElementById('fDisk').value || '20G').toUpperCase());
  fd.append('ssh_port', document.getElementById('fPort').value || '');

  const rawFwds = document.getElementById('fFwdCustom').value || '';
  const parsedFwds = rawFwds.split(',').map(s=>s.trim()).filter(Boolean).map(p=>{ const[h,g]=p.split(':'); return { host:parseInt(h,10), guest:parseInt(g,10) }; }).filter(p=>!isNaN(p.host)&&!isNaN(p.guest));
  fd.append('port_forwards', JSON.stringify(parsedFwds));

  // Basics / identity
  fd.append('description', document.getElementById('fDesc').value || '');
  fd.append('tag', document.getElementById('fTag').value || '');
  fd.append('region', document.getElementById('fRegion').value || '');
  fd.append('vmid', document.getElementById('fVmid').value || '');

  // CPU
  fd.append('cpu_sockets', document.getElementById('fSockets').value || '1');
  fd.append('cores_per_socket', document.getElementById('fCoresPerSocket').value || '1');
  fd.append('threads_per_core', document.getElementById('fThreads').value || '1');
  fd.append('cpu_model', document.getElementById('fCpuModel').value || 'default');
  fd.append('cpu_units', document.getElementById('fCpuUnits').value || '1024');
  fd.append('cpu_limit', document.getElementById('fCpuLimit').value || '0');

  // RAM
  fd.append('mem_min', document.getElementById('fMemMin').value || '0');
  fd.append('mem_max', document.getElementById('fMemMax').value || '0');
  fd.append('ballooning', document.getElementById('fBalloon').checked ? '1' : '0');
  fd.append('memory_hotplug', document.getElementById('fMemHotplug').checked ? (document.getElementById('fMemMax').value || document.getElementById('fMem').value) : '0');

  // Storage
  fd.append('storage_pool', document.getElementById('fPool').value || 'default');
  fd.append('disk_format', document.getElementById('fFormat').value || 'qcow2');
  fd.append('additional_disks', JSON.stringify(collectDataDisks()));

  // Boot / firmware
  fd.append('boot_order', document.getElementById('fBootOrder').value || 'c');
  fd.append('firmware', document.getElementById('fFirmware').value || 'bios');
  fd.append('machine_type', document.getElementById('fMachine').value || 'pc');
  fd.append('secure_boot', document.getElementById('fSecureBoot').checked ? '1' : '0');
  fd.append('tpm', document.getElementById('fTpm').checked ? '1' : '0');

  // Network
  fd.append('nic_model', document.getElementById('fNicModel').value || 'virtio');
  fd.append('nic_count', document.getElementById('fNicCount').value || '1');

  // Auth & cloud-init
  const sshKeys = document.getElementById('fSshKeys').value.split('\n').map(x=>x.trim()).filter(Boolean);
  if (sshKeys.length) fd.append('ssh_keys', JSON.stringify(sshKeys));
  fd.append('timezone', document.getElementById('fTimezone').value || 'UTC');
  fd.append('locale', document.getElementById('fLocale').value || 'en_US.UTF-8');
  fd.append('cloudinit_packages', JSON.stringify(document.getElementById('fPackages').value.split('\n').map(x=>x.trim()).filter(Boolean)));
  fd.append('cloudinit_commands', JSON.stringify(document.getElementById('fCommands').value.split('\n').map(x=>x.trim()).filter(Boolean)));
  fd.append('cloudinit_userdata', document.getElementById('fUserData').value || '');

  // Deployment
  fd.append('start_on_boot', document.getElementById('fStartBoot').checked ? '1' : '0');
  fd.append('gui_mode', document.getElementById('fGui').checked ? '1' : '0');
  fd.append('install_guest_agent', document.getElementById('fGuestAgent').checked ? '1' : '0');
  fd.append('enable_monitoring', document.getElementById('fMonitoring').checked ? '1' : '0');
  fd.append('enable_backups', document.getElementById('fBackups').checked ? '1' : '0');
  fd.append('backup_schedule', document.getElementById('fBackupSched').value || '');

  fd.append('owner_id', document.getElementById('fOwner').value);
  fd.append('node_id', (document.getElementById('fNode')||{}).value || '1');

  if ((document.querySelector('input[name="imgSrc"]:checked')||{}).value === 'upload') {
    const f = document.getElementById('fImg').files[0];
    if (f) fd.append('image', f);
  }

  try {
    const r = await fetch('/admin/servers/create', { method: 'POST', body: fd });
    const d = await r.json();
    if (!r.ok) throw new Error(d.error || 'Failed to create server');
    VP.toast('VM Created successfully! SSH Port: ' + d.vm.ssh_port, 'success');
    setTimeout(()=>{ location.href = '/admin/servers/' + d.vm.id; }, 900);
  } catch (e) {
    VP.toast(e.message, 'error');
    btn.disabled = false;
    btn.innerHTML = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18"><path d="M13 2 3 14h9l-1 8 10-12h-9l1-8z"/></svg> Deploy Virtual Machine';
    prog.style.display = 'none';
  }
}

/* ---------- Ignore IPv4/IPv6: fields intentionally omitted — addressing is fully automatic (slirp user networking). ---------- */

// Init
const urlParams = new URLSearchParams(window.location.search);
const targetOwner = urlParams.get('owner_id');
if (targetOwner && document.getElementById('fOwner')) document.getElementById('fOwner').value = targetOwner;
// Seed one data disk template
genPassword();
renderSteps();
</script>
