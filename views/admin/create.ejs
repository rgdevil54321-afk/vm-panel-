<style>
.wizard-steps {
  display: flex; gap: 6px; flex-wrap: wrap;
  margin-bottom: 18px; padding: 10px;
  background: var(--glass); border: 1px solid var(--border);
  border-radius: 14px;
}
.wstep {
  display: flex; align-items: center; gap: 8px;
  background: transparent; border: none; cursor: pointer;
  padding: 8px 12px; border-radius: 10px; color: var(--text-dim);
  font-size: 13px; font-weight: 600; transition: 0.15s;
}
.wstep:hover { background: rgba(255,255,255,0.05); color: var(--text); }
.wstep.active {
  background: color-mix(in srgb, var(--accent) 22%, transparent);
  color: var(--accent); box-shadow: 0 0 0 1px var(--accent) inset;
}
.wstep.done { color: var(--accent); }
.wstep.done .ws-num { background: var(--accent); color: #fff; }
.ws-num {
  width: 22px; height: 22px; border-radius: 50%;
  display: grid; place-items: center; font-size: 12px; font-weight: 700;
  background: rgba(255,255,255,0.08);
}
.ws-label { display: inline-block; }
@media (max-width: 720px) { .ws-label { display: none; } }

.wizard-step { animation: fadeIn 0.2s ease; }
@keyframes fadeIn { from { opacity: 0; transform: translateY(4px); } to { opacity: 1; transform: none; } }

.step-nav {
  display: flex; justify-content: space-between; align-items: center; gap: 10px;
  margin-top: 22px; padding-top: 18px; border-top: 1px solid var(--border); flex-wrap: wrap;
}
.step-nav .btn { min-width: 130px; justify-content: center; }

.rv-card {
  background: var(--glass); border: 1px solid var(--border);
  border-radius: 10px; padding: 12px 14px;
}
.rv-lbl { font-size: 11px; text-transform: uppercase; letter-spacing: 0.5px; color: var(--text-dim); margin-bottom: 4px; }
.rv-val { font-size: 13px; font-weight: 600; color: var(--text); }

.data-disk-row {
  display: grid; grid-template-columns: 1fr 130px 110px 34px; gap: 10px;
  align-items: center; margin-bottom: 10px;
}
.data-disk-row input, .data-disk-row select {
  padding: 8px 10px; font-size: 13px;
}

.preset-card {
  background: var(--glass);
  border: 1px solid var(--border);
  border-radius: 12px;
  padding: 14px;
  text-align: left;
  cursor: pointer;
  transition: all 0.16s ease;
  position: relative;
  color: var(--text);
}
.preset-card:hover {
  background: color-mix(in srgb, var(--accent) 12%, var(--glass));
  border-color: var(--accent);
  transform: translateY(-2px);
}
.preset-card.active {
  background: color-mix(in srgb, var(--accent) 22%, var(--glass));
  border-color: var(--accent);
  box-shadow: 0 0 16px rgba(99, 102, 241, 0.2);
}
.preset-name { font-weight: 700; font-size: 14px; margin-bottom: 2px; }
.preset-spec { font-size: 12px; color: var(--text-dim); }
.preset-disk { font-size: 11px; color: var(--accent-2); margin-top: 4px; font-weight: 600; }
.preset-badge {
  position: absolute; top: -8px; right: 10px;
  background: var(--accent); color: #fff;
  font-size: 10px; font-weight: 700; padding: 2px 7px;
  border-radius: 10px; text-transform: uppercase;
}

.os-filters { display: flex; gap: 6px; flex-wrap: wrap; }
.os-filter-btn {
  background: transparent; border: 1px solid var(--border);
  color: var(--text-dim); padding: 4px 10px; border-radius: 8px;
  font-size: 12px; cursor: pointer; transition: 0.15s;
}
.os-filter-btn:hover { color: var(--text); }
.os-filter-btn.active { background: var(--accent); color: #fff; border-color: var(--accent); }

.os-select-card:hover { border-color: color-mix(in srgb, var(--accent) 60%, transparent); transform: translateY(-1px); }
.os-select-card.selected { border-color: var(--accent) !important; background: color-mix(in srgb, var(--accent) 14%, var(--glass)) !important; box-shadow: 0 0 16px rgba(99, 102, 241, 0.25); }

.img-mode-card {
  border: 1px solid var(--border); border-radius: 12px; padding: 14px;
  display: flex; align-items: center; gap: 12px;
  background: var(--glass); cursor: pointer; transition: all 0.15s;
}
.img-mode-card:hover { border-color: var(--accent); }
.img-mode-card.active { border-color: var(--accent); background: color-mix(in srgb, var(--accent) 18%, var(--glass)); }

.cpu-model-card {
  border: 1px solid var(--border); border-radius: 10px; padding: 10px 14px;
  background: var(--glass); cursor: pointer; transition: all 0.15s;
  display: flex; align-items: center; gap: 10px; position: relative;
}
.cpu-model-card:hover { border-color: var(--accent); background: color-mix(in srgb, var(--accent) 8%, var(--glass)); }
.cpu-model-card.selected { border-color: var(--accent); background: color-mix(in srgb, var(--accent) 16%, var(--glass)); box-shadow: 0 0 12px rgba(99, 102, 241, 0.2); }
.cpu-model-card .cpu-check {
  width: 16px; height: 16px; border-radius: 50%; border: 2px solid var(--border);
  display: grid; place-items: center; flex-shrink: 0; transition: 0.15s;
}
.cpu-model-card.selected .cpu-check { border-color: var(--accent); background: var(--accent); }

.switch { position: relative; display: inline-block; width: 40px; height: 22px; flex-shrink: 0; }
.switch input { opacity: 0; width: 0; height: 0; }
.slider {
