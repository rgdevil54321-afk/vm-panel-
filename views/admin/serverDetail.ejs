<%- include('../partials/head', { title: vm.name + ' - Admin' }) %>
<%- include('../partials/ambient') %>
<%- include('../partials/topbar') %>
<%- include('../partials/sidebar') %>
<div class="main">
  <%
    const _v4 = String(vm.ip_address || '').trim();
    const _static = ['ipv4_shared', 'ipv4_dedicated', 'dual'].includes(String(vm.ip_mode || '')) && !!_v4;
  %>
  <div class="flex-between mb-3">
    <div>
      <div class="muted text-sm" style="margin-bottom:2px">
        <a href="/admin/servers" style="color:var(--text-dim)">Admin / Servers</a> / <%= vm.name %>
      </div>
      <h2 style="font-size:24px;font-weight:800;letter-spacing:-0.3px;display:flex;align-items:center;gap:12px">
        <%= vm.name %>
        <span class="pill <%= vm.status === 'running' ? 'pill-green' : 'pill-gray' %>">
          <%= vm.status %>
        </span>
      </h2>
    </div>

    <!-- Power & Admin Action Bar -->
    <div class="flex" style="gap:8px">
      <% if (vm.status === 'running') { %>
        <button class="btn btn-sm btn-danger" onclick="action('stop')">Stop</button>
        <button class="btn btn-sm btn-primary" onclick="action('restart')">Restart</button>
      <% } else { %>
        <button class="btn btn-sm btn-green" onclick="action('start')">Start</button>
      <% } %>
      <a class="btn btn-sm" href="/servers/<%= vm.id %>/console">Terminal</a>
      <a class="btn btn-sm" href="/servers/<%= vm.id %>/console?tab=bootlog">Live Boot Logs</a>
      <button class="btn btn-sm btn-primary" onclick="openEdit()">Edit Server</button>
      <button class="btn btn-sm" onclick="openRenew()">Renew</button>
      <button class="btn btn-sm btn-danger" onclick="del()">Delete Server</button>
    </div>
  </div>

  <!-- Specs Cards -->
  <div class="grid grid-4 mb-4">
    <div class="stat">
      <div class="stat-icon" style="background:rgba(99,102,241,0.15);color:#818cf8">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
      </div>
      <div>
        <div class="stat-value"><%= vm.cpus %></div>
        <div class="stat-label">vCPUs</div>
        <% if (specs.hasSpoof && specs.spoof.cpu) { %><div class="muted text-sm mono" style="margin-top:4px;color:#a78bfa">spoof: <%= specs.spoof.cpu %></div><% } %>
      </div>
    </div>

    <div class="stat">
      <div class="stat-icon" style="background:rgba(56,189,248,0.15);color:#38bdf8">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="2" width="20" height="8" rx="2"/><rect x="2" y="14" width="20" height="8" rx="2"/><path d="M6 6h.01M6 18h.01"/></svg>
      </div>
      <div>
        <div class="stat-value"><%= vm.memory %> MB</div>
        <div class="stat-label">Memory</div>
        <% if (specs.hasSpoof && specs.spoof.mem) { %><div class="muted text-sm mono" style="margin-top:4px;color:#a78bfa">spoof: <%= specs.spoof.mem %></div><% } %>
      </div>
    </div>

    <div class="stat">
      <div class="stat-icon" style="background:rgba(245,158,11,0.15);color:#fbbf24">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12a9 9 0 1 1-2.64-6.36M21 3v6h-6"/></svg>
      </div>
      <div>
        <div class="stat-value"><%= vm.disk_size %></div>
        <div class="stat-label">Disk Size</div>
        <% if (specs.hasSpoof && specs.spoof.disk) { %><div class="muted text-sm mono" style="margin-top:4px;color:#a78bfa">spoof: <%= specs.spoof.disk %></div><% } %>
      </div>
    </div>

    <div class="stat">
      <div class="stat-icon" style="background:rgba(16,185,129,0.15);color:#34d399">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 8v4l2 2M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20z"/></svg>
      </div>
      <div>
        <div class="stat-value"><%= vm.status === 'running' ? (Math.floor(uptime/60) + 'm') : '—' %></div>
        <div class="stat-label">Uptime</div>
      </div>
    </div>
  </div>

  <div class="grid grid-2">
    <!-- Server Details -->
    <div class="card">
      <div class="card-title">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18"><rect x="2" y="2" width="20" height="8" rx="2"/><rect x="2" y="14" width="20" height="8" rx="2"/><path d="M6 6h.01M6 18h.01"/></svg>
        Server Configuration &amp; Metadata
      </div>
      <div class="table-wrap">
        <table>
          <tbody>
            <tr><td class="muted" style="width:130px">UUID</td><td class="mono"><%= vm.uuid %></td></tr>
            <tr>
              <td class="muted">Owner</td>
              <td>
                <div class="flex-between">
                  <div>
                    <span class="font-bold"><%= vm.owner_name %></span> &lt;<%= vm.owner_email %>&gt;
                  </div>
                  <% if (typeof allUsers !== 'undefined' && allUsers.length > 1) { %>
                    <button type="button" class="btn btn-sm" onclick="openTransferModal()" style="font-size:11.5px;padding:3px 8px">
                      Transfer Owner
                    </button>
                  <% } %>
                </div>
              </td>
            </tr>
            <tr><td class="muted">OS / Codename</td><td><span class="pill pill-blue font-bold"><%= vm.os_type %> <%= vm.codename %></span></td></tr>
            <tr><td class="muted">SSH Command</td><td>
              <span class="mono" id="sshcmd" data-secret>ssh -p <%= _static ? 22 : vm.ssh_port %> <%= vm.username %>@<%= _static ? _v4 : (vm.node_host || 'localhost') %></span> <button type="button" class="btn btn-sm" style="font-size:11.5px;padding:3px 8px" onclick="copyText('sshcmd', this)">Copy</button>
              <% if (_static) { %><div class="muted text-sm mono" style="margin-top:3px">fallback (always works): ssh -p <%= vm.ssh_port %> <%= vm.username %>@<%= vm.node_host || 'localhost' %></div><% } %>
              <div style="margin-top:6px"><button type="button" class="btn btn-sm btn-primary" style="font-size:11.5px;padding:3px 8px" onclick="loadTmate(false, this)">Get Remote SSH (tmate)</button> <button type="button" class="btn btn-sm" style="font-size:11.5px;padding:3px 8px" onclick="loadTmate(true, this)" title="Start a fresh tmate session and get a new address">Regenerate SSH</button></div>
            </td></tr>
            <tr><td class="muted">Terminal</td><td><a href="/servers/<%= vm.id %>/console" class="btn btn-sm">Launch Web Terminal</a></td></tr>
            <tr><td class="muted">SSH Password</td><td><span class="mono" id="sshpass" data-secret><%= vm.password %></span> <button type="button" class="btn btn-sm" style="font-size:11.5px;padding:3px 8px" onclick="copyText('sshpass', this)">Copy</button> <button type="button" class="btn btn-sm" style="font-size:11.5px;padding:3px 8px" onclick="regenPass(this)">Regenerate</button></td></tr>
            <tr><td class="muted">Disk Image File</td><td class="mono truncate text-sm" style="max-width:240px"><%= vm.img_file %></td></tr>
            <tr><td class="muted">Port Forwards</td><td class="mono"><% if (vm.port_forwards && vm.port_forwards.length) { %><% for (const f of vm.port_forwards) { %><span class="pill pill-gray" style="margin-right:4px"><%= f.host %>:<%= f.guest %></span><% } %><% } else { %>None<% } %></td></tr>
            <tr><td class="muted">VPS Type</td><td><span class="pill pill-blue font-bold"><%= (vm.vps_type || 'kvm').toUpperCase() %></span></td></tr>
            <tr>
              <td class="muted">Expires</td>
              <td>
                <% const _ex = vm.expiry || null; %>
                <% if (_ex && _ex.at) { %>
                  <span class="pill <%= _ex.expired ? 'pill-red' : (_ex.days_left <= 3 ? 'pill-yellow' : 'pill-green') %>">
                    <%= _ex.expired ? 'EXPIRED' : (_ex.days_left + 'd left') %>
                  </span>
                  <span class="muted text-sm" style="margin-left:6px"><%= new Date(_ex.at).toLocaleString() %></span>
                <% } else { %>
                  <span class="pill pill-gray">Never</span>
                <% } %>
                <button type="button" class="btn btn-sm btn-primary" style="margin-left:8px" onclick="openRenew()">Renew</button>
              </td>
            </tr>
            <tr>
              <td class="muted">Backup Slots</td>
              <td>
                <span class="pill <%= backups.length >= (vm.backup_slots || 5) ? 'pill-yellow' : 'pill-green' %>">
                  <%= backups.length %> / <%= vm.backup_slots || 5 %> used
                </span>
              </td>
            </tr>
            <tr><td class="muted">Created At</td><td class="muted"><%= new Date(vm.created_at).toLocaleString() %></td></tr>
          </tbody>
        </table>
      </div>
    </div>

    <!-- Network Configuration -->
    <div class="card" style="margin-top:18px">
      <div class="card-title">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18"><path d="M5 12.55a11 11 0 0 1 14.08 0M1.42 9a16 16 0 0 1 21.16 0M8.53 16.11a6 6 0 0 1 6.95 0M12 20h.01"/></svg>
        Network Configuration
      </div>
      <div class="table-wrap">
        <table>
          <tbody>
            <tr>
              <td class="muted" style="width:130px">Network Mode</td>
              <td>
                <select id="net_ip_mode" style="width:100%;padding:9px 10px;border-radius:8px">
                  <option value="nat" <%= vm.ip_mode === 'nat' ? 'selected' : '' %>>NAT (default)</option>
                  <option value="ipv4_shared" <%= vm.ip_mode === 'ipv4_shared' ? 'selected' : '' %>>IPv4 shared</option>
                  <option value="ipv4_dedicated" <%= vm.ip_mode === 'ipv4_dedicated' ? 'selected' : '' %>>IPv4 dedicated</option>
                  <option value="ipv6" <%= vm.ip_mode === 'ipv6' ? 'selected' : '' %>>IPv6 only</option>
                  <option value="dual" <%= vm.ip_mode === 'dual' ? 'selected' : '' %>>Dual stack</option>
                </select>
              </td>
            </tr>
            <tr><td class="muted">IPv4 Address</td><td><input id="net_ip_address" list="hostIps" value="<%= vm.ip_address || '' %>" placeholder="10.10.0.5 (pick from host, or type)" style="width:100%;padding:8px 10px;border-radius:8px" oninput="netEdit('4')" onchange="netEdit('4')"/><datalist id="hostIps"></datalist><datalist id="hostIps6"></datalist></td></tr>
            <tr><td class="muted">IPv4 Gateway</td><td><input id="net_ip_gateway" value="<%= vm.ip_gateway || '' %>" placeholder="10.10.0.1" style="width:100%;padding:8px 10px;border-radius:8px"/></td></tr>
            <tr><td class="muted">IPv4 Prefix</td><td><input id="net_ip_prefix" value="<%= vm.ip_prefix || '24' %>" placeholder="24" style="width:100%;padding:8px 10px;border-radius:8px"/></td></tr>
            <tr><td class="muted">IPv6 Address</td><td><input id="net_ipv6_address" list="hostIps6" value="<%= vm.ipv6_address || '' %>" placeholder="2001:db8::5" style="width:100%;padding:8px 10px;border-radius:8px" oninput="netEdit('6')" onchange="netEdit('6')"/></td></tr>
            <tr><td class="muted">IPv6 Gateway</td><td><input id="net_ipv6_gateway" value="<%= vm.ipv6_gateway || '' %>" placeholder="2001:db8::1" style="width:100%;padding:8px 10px;border-radius:8px"/></td></tr>
            <tr><td class="muted">IPv6 Prefix</td><td><input id="net_ipv6_prefix" value="<%= vm.ipv6_prefix || '64' %>" placeholder="64" style="width:100%;padding:8px 10px;border-radius:8px"/></td></tr>
          </tbody>
        </table>
      </div>
      <div class="flex-between" style="gap:8px;margin-top:10px">
        <span class="muted text-sm">Applies on next boot (Stop → Start). The node-port SSH above keeps working regardless — setting a dedicated IP can't break the terminal.</span>
        <div class="flex" style="gap:8px;flex-shrink:0">
          <button type="button" class="btn" onclick="loadHostNet(this)">Detect Host IP</button>
          <button type="button" class="btn btn-primary" onclick="saveNetwork(this)">Save Network</button>
        </div>
      </div>
      <div id="hostNetInfo" class="muted text-sm mono" style="margin-top:8px;display:none"></div>
    </div>

    <!-- Related Components -->
    <div style="display:flex;flex-direction:column;gap:18px">
      <div class="card">
        <div class="flex-between mb-2">
          <div class="card-title" style="margin:0">Backups (<%= backups.length %>/<%= vm.backup_slots || 5 %> slots)</div>
          <a href="/servers/<%= vm.id %>/backups" class="btn btn-sm">Manage</a>
        </div>
        <% if (backups.length === 0) { %><div class="muted text-sm">No backups created yet</div><% } else { %>
          <% for (const b of backups.slice(0, 4)) { %>
            <div class="flex-between" style="padding:8px 0;border-bottom:1px solid var(--border);font-size:13px">
              <span class="mono truncate" style="max-width:180px"><%= b.name %></span>
              <span class="muted text-sm"><%= Math.round((b.size || 0)/1024/1024) %> MB</span>
            </div>
          <% } %>
        <% } %>
      </div>

      <div class="card">
        <div class="flex-between mb-2">
          <div class="card-title" style="margin:0">Snapshots (<span id="snapCount">…</span>)</div>
          <button class="btn btn-sm btn-primary" onclick="createSnap()">+ New Snapshot</button>
        </div>
        <div id="snapList" class="muted text-sm">Loading snapshots…</div>
      </div>

      <div class="card">
        <div class="flex-between mb-2">
          <div class="card-title" style="margin:0">Storage Volumes</div>
          <a href="/servers/<%= vm.id %>/volumes" class="btn btn-sm">Manage</a>
        </div>
        <div class="muted text-sm">Root disk: <span class="mono"><%= vm.disk_size %></span><% const _ads = Array.isArray(vm.additional_disks) ? vm.additional_disks : (function(){ try { return JSON.parse(vm.additional_disks || '[]') || []; } catch (_) { return []; } })(); %><% if (_ads.length) { %> · <%= _ads.length %> data disk(s)<% } %></div>
      </div>

      <div class="card">
        <div class="flex-between mb-2">
          <div class="card-title" style="margin:0">Subusers (<%= subs.length %>)</div>
          <a href="/servers/<%= vm.id %>/subusers" class="btn btn-sm">Manage</a>
        </div>
        <% if (subs.length === 0) { %><div class="muted text-sm">No subusers assigned to this server</div><% } else { %>
          <% for (const s of subs) { %>
            <div class="flex-between" style="padding:8px 0;border-bottom:1px solid var(--border);font-size:13px">
              <span style="font-weight:600"><%= s.username %></span>
            </div>
          <% } %>
        <% } %>
      </div>
    </div>
  </div>
</div>

<!-- Transfer Ownership Modal -->
<% if (typeof allUsers !== 'undefined' && allUsers.length > 1) { %>
<div id="transferModal" style="display:none">
  <div style="position:fixed;inset:0;background:rgba(0,0,0,0.75);z-index:200;display:grid;place-items:center;padding:20px;backdrop-filter:blur(8px)">
    <div class="card" style="width:min(460px,94vw);box-shadow:0 24px 60px rgba(0,0,0,0.6)">
      <div class="flex-between mb-3">
        <h3 style="font-size:18px;font-weight:700;margin:0">Transfer Server Ownership</h3>
        <button type="button" class="btn btn-sm" onclick="closeTransferModal()">✕</button>
      </div>
      <p class="muted text-sm mb-3">Transfer ownership of <strong><%= vm.name %></strong> to another registered user account.</p>
      
      <div class="form-group mb-4">
        <label>Select New Owner</label>
        <select id="transferOwnerSelect" style="width:100%;padding:10px;border-radius:8px">
          <% for (const u of allUsers) { %>
            <option value="<%= u.id %>" <%= u.id === vm.owner_id ? 'selected disabled' : '' %>>
              <%= u.username %> (<%= u.email %>) <%= u.id === vm.owner_id ? '— Current Owner' : '' %>
            </option>
          <% } %>
        </select>
      </div>

      <div class="flex right" style="gap:8px">
        <button type="button" class="btn" onclick="closeTransferModal()">Cancel</button>
        <button type="button" class="btn btn-primary" onclick="submitTransfer()">Confirm Transfer</button>
      </div>
    </div>
  </div>
</div>
<% } %>

<!-- Edit Server Modal -->
<div id="editModal" style="display:none">
  <div style="position:fixed;inset:0;background:rgba(0,0,0,0.75);z-index:210;display:grid;place-items:center;padding:20px;backdrop-filter:blur(8px)">
    <div class="card" style="width:min(660px,94vw);max-height:88vh;overflow:auto;box-shadow:0 24px 60px rgba(0,0,0,0.6)">
      <div class="flex-between mb-3">
        <h3 style="font-size:18px;font-weight:700;margin:0">Edit <%= vm.name %></h3>
        <button type="button" class="btn btn-sm" onclick="closeEdit()">✕</button>
      </div>

      <div class="card-title mb-2" style="font-size:15px">Basic &amp; Credentials</div>
      <div class="grid grid-2" style="gap:12px">
        <div class="form-group" style="margin:0"><label>Name</label><input id="ed_name" class="input" value="<%= vm.name %>"/></div>
        <div class="form-group" style="margin:0"><label>OS / Distro</label>
          <select id="ed_os_type" class="input">
            <% for (const o of osList) { %>
              <option value="<%= o[1] %>" <%= vm.os_type === o[1] ? 'selected' : '' %>><%= o[0] %></option>
            <% } %>
            <% if (!osList.some((o) => o[1] === vm.os_type)) { %><option value="<%= vm.os_type %>" selected><%= vm.os_type || 'linux' %></option><% } %>
          </select>
        </div>
        <div class="form-group" style="margin:0"><label>Hostname</label><input id="ed_hostname" class="input" value="<%= vm.hostname || '' %>"/></div>
        <div class="form-group" style="margin:0"><label>SSH Username</label><input id="ed_username" class="input" value="<%= vm.username || '' %>"/></div>
        <div class="form-group" style="margin:0"><label>SSH Password</label><input id="ed_password" class="input" value="<%= vm.password || '' %>"/></div>
        <div class="form-group" style="margin:0"><label>Region</label><input id="ed_region" class="input" value="<%= vm.region || '' %>"/></div>
        <div class="form-group" style="margin:0"><label>Tag</label><input id="ed_tag" class="input" value="<%= vm.tag || '' %>"/></div>
        <div class="form-group" style="margin:0"><label>VM ID (vmid)</label><input id="ed_vmid" class="input" value="<%= vm.vmid || '' %>"/></div>
        <div class="form-group" style="margin:0"><label>Timezone</label><input id="ed_timezone" class="input" value="<%= vm.timezone || '' %>" placeholder="UTC"/></div>
        <div class="form-group" style="margin:0"><label>Locale</label><input id="ed_locale" class="input" value="<%= vm.locale || '' %>" placeholder="en_US.UTF-8"/></div>
      </div>

      <div class="card-title mb-2 mt-3" style="font-size:15px">Resources</div>
      <div class="grid grid-2" style="gap:12px">
        <div class="form-group" style="margin:0"><label>Memory (MB)</label><input id="ed_memory" class="input" type="number" value="<%= vm.memory %>"/></div>
        <div class="form-group" style="margin:0"><label>vCPUs</label><input id="ed_cpus" class="input" type="number" value="<%= vm.cpus %>"/></div>
        <div class="form-group" style="margin:0"><label>Disk Size</label><input id="ed_disk_size" class="input" value="<%= vm.disk_size %>"/></div>
        <div class="form-group" style="margin:0;display:flex;align-items:center;gap:14px;padding-top:26px">
          <label class="check" style="cursor:pointer"><input type="checkbox" id="ed_gui_mode" <%= vm.gui_mode ? 'checked' : '' %>/><span>GUI Mode</span></label>
          <label class="check" style="cursor:pointer"><input type="checkbox" id="ed_start_on_boot" <%= vm.start_on_boot ? 'checked' : '' %>/><span>Start on Boot</span></label>
        </div>
        <div class="form-group" style="margin:0"><label>Startup Command</label><input id="ed_startup_command" class="input" value="<%= vm.startup_command || '' %>"/></div>
        <div class="form-group" style="margin:0"><label>Notes</label><textarea id="ed_notes" class="input" rows="2"><%= vm.notes || '' %></textarea></div>
        <div class="form-group" style="margin:0"><label>VPS Type</label>
          <select id="ed_vps_type" class="input">
            <% for (const vt of ['kvm', 'nat', 'storage', 'highcpu', 'gaming', 'backup']) { %>
              <option value="<%= vt %>" <%= (vm.vps_type || 'kvm') === vt ? 'selected' : '' %>><%= vt.toUpperCase() %></option>
            <% } %>
          </select>
        </div>
        <div class="form-group" style="margin:0"><label>Expiry (local time, empty = never)</label>
          <input id="ed_expires_at" class="input" type="datetime-local" value="<%= (() => { const _d = vm.expiry && vm.expiry.at ? new Date(vm.expiry.at) : null; return _d && !isNaN(_d.getTime()) ? new Date(_d.getTime() - _d.getTimezoneOffset() * 60000).toISOString().slice(0, 16) : ''; })() %>"/>
        </div>
        <div class="form-group" style="margin:0"><label>Backup Slots (0 = no backups)</label>
          <input id="ed_backup_slots" class="input" type="number" min="0" step="1" value="<%= vm.backup_slots != null ? vm.backup_slots : 5 %>"/>
        </div>
      </div>

      <div class="card-title mb-2 mt-3" style="font-size:15px">Neofetch Spoof (shown inside the VM)</div>
      <div class="grid grid-2" style="gap:12px">
        <div class="form-group" style="margin:0"><label>CPU</label><input id="ed_nf_cpu" class="input" placeholder="Intel Xeon E5-2697 v4 @ 2.30GHz" value="<%= vm.neofetch_cpu || '' %>"/></div>
        <div class="form-group" style="margin:0"><label>GPU</label><input id="ed_nf_gpu" class="input" placeholder="NVIDIA GeForce RTX 4090" value="<%= vm.neofetch_gpu || '' %>"/></div>
        <div class="form-group" style="margin:0"><label>Memory</label><input id="ed_nf_mem" class="input" placeholder="64GiB" value="<%= vm.neofetch_mem || '' %>"/></div>
        <div class="form-group" style="margin:0"><label>Disk</label><input id="ed_nf_disk" class="input" placeholder="2TB (nvme)" value="<%= vm.neofetch_disk || '' %>"/></div>
      </div>
      <div class="flex" style="gap:10px;margin-top:12px;align-items:center">
        <button type="button" class="btn btn-sm" id="btnApplyNf" onclick="applyNeofetchSpoof(this)">Apply to running VM</button>
        <span class="muted text-sm">Pushes this banner into a server that is already running. Leave blank to use the VM's allocated specs.</span>
      </div>

      <div class="flex right" style="gap:8px;margin-top:18px">
        <span class="muted text-sm" style="margin-right:auto;align-self:center">Password / spoof / OS apply on the next Start. Disk resize keeps existing data.</span>
        <button type="button" class="btn" onclick="closeEdit()">Cancel</button>
        <button type="button" class="btn btn-primary" onclick="saveEdit(this)">Save Changes</button>
      </div>
    </div>
  </div>
</div>

<%- include('../partials/music') %>
<%- include('../partials/foot') %>

<!-- Renew Expiry Modal -->
<div id="renewModal" style="display:none">
  <div style="position:fixed;inset:0;background:rgba(0,0,0,0.75);z-index:220;display:grid;place-items:center;padding:20px;backdrop-filter:blur(8px)">
    <div class="card" style="width:min(460px,94vw);box-shadow:0 24px 60px rgba(0,0,0,0.6)">
      <div class="flex-between mb-3">
        <h3 style="font-size:18px;font-weight:700;margin:0">Renew <%= vm.name %></h3>
        <button type="button" class="btn btn-sm" onclick="closeRenew()">✕</button>
      </div>
      <p class="muted text-sm mb-3">
        <% const _rex = vm.expiry || null; %>
        Current expiry:
        <% if (_rex && _rex.at) { %>
          <strong><%= new Date(_rex.at).toLocaleString() %></strong>
          <%= _rex.expired ? '(expired)' : '(' + _rex.days_left + 'd left)' %>
        <% } else { %>Never (no expiry set)<% } %>
      </p>

      <div class="form-group mb-3">
        <label>Add days</label>
        <div class="flex" style="gap:8px">
          <input id="renewDays" class="input" type="number" min="0" step="1" value="30" style="flex:1"/>
          <button type="button" class="btn" onclick="document.getElementById('renewDays').value=7">+7</button>
          <button type="button" class="btn" onclick="document.getElementById('renewDays').value=30">+30</button>
          <button type="button" class="btn" onclick="document.getElementById('renewDays').value=90">+90</button>
        </div>
        <div class="muted text-sm" style="margin-top:6px">Added on top of the current expiry (or from today if none). Use 0 to clear the expiry.</div>
      </div>

      <div class="form-group mb-3">
        <label>Or set an exact expiry date (overrides "add days")</label>
        <input id="renewTo" class="input" type="datetime-local"/>
      </div>

      <div class="flex right" style="gap:8px">
        <button type="button" class="btn" onclick="closeRenew()">Cancel</button>
        <button type="button" class="btn btn-primary" onclick="submitRenew(this)">Apply Renewal</button>
      </div>
    </div>
  </div>
</div>

<script>
function openEdit() {
  const m = document.getElementById('editModal');
  if (m) m.style.display = 'block';
}

function openRenew() {
  const m = document.getElementById('renewModal');
  if (m) m.style.display = 'block';
}

function closeRenew() {
  const m = document.getElementById('renewModal');
  if (m) m.style.display = 'none';
}

async function submitRenew(btn) {
  const days = parseInt(document.getElementById('renewDays').value || '0', 10) || 0;
  const toVal = document.getElementById('renewTo').value || '';
  const body = { days };
  if (toVal) body.to = new Date(toVal).toISOString();
  try {
    if (btn) btn.disabled = true;
    const r = await VP.api('/admin/servers/<%= vm.id %>/renew', { method: 'POST', body });
    VP.toast('Expiry updated: ' + ((r.vm && r.vm.expiry && r.vm.expiry.at) ? new Date(r.vm.expiry.at).toLocaleString() : 'never expires'), 'success');
    setTimeout(() => location.reload(), 900);
  } catch (e) {
    VP.toast(e.message, 'error');
    if (btn) btn.disabled = false;
  }
}

function closeEdit() {
  const m = document.getElementById('editModal');
  if (m) m.style.display = 'none';
}

async function saveEdit(btn) {
  const val = (id) => (document.getElementById(id) || {}).value || '';
  const chk = (id) => !!(document.getElementById(id) || {}).checked;
  const body = {
    name: val('ed_name'),
    os_type: val('ed_os_type'),
    hostname: val('ed_hostname'),
    username: val('ed_username'),
    password: val('ed_password'),
    region: val('ed_region'),
    tag: val('ed_tag'),
    vmid: val('ed_vmid'),
    timezone: val('ed_timezone'),
    locale: val('ed_locale'),
    memory: val('ed_memory'),
    cpus: val('ed_cpus'),
    disk_size: val('ed_disk_size'),
    gui_mode: chk('ed_gui_mode'),
    start_on_boot: chk('ed_start_on_boot'),
    startup_command: val('ed_startup_command'),
    notes: val('ed_notes'),
    neofetch_cpu: val('ed_nf_cpu'),
    neofetch_mem: val('ed_nf_mem'),
    neofetch_disk: val('ed_nf_disk'),
    neofetch_gpu: val('ed_nf_gpu'),
    vps_type: val('ed_vps_type'),
    expires_at: val('ed_expires_at') ? new Date(val('ed_expires_at')).toISOString() : '',
    backup_slots: val('ed_backup_slots'),
  };
  try {
    if (btn) btn.disabled = true;
    await VP.api('/admin/servers/<%= vm.id %>/update', { method: 'POST', body });
    VP.toast('Server updated — seed refresh applies on next Start', 'success');
    setTimeout(() => location.reload(), 900);
  } catch (e) {
    VP.toast(e.message, 'error');
    if (btn) btn.disabled = false;
  }
}

async function applyNeofetchSpoof(btn) {
  const fields = ['ed_nf_cpu', 'ed_nf_gpu', 'ed_nf_mem', 'ed_nf_disk'];
  const body = {};
  for (const id of fields) {
    const el = document.getElementById(id);
    if (el) body[id.replace('ed_nf_', 'neofetch_')] = el.value.trim();
  }
  if (btn) btn.disabled = true;
  try {
    await VP.api('/admin/servers/<%= vm.id %>/update', { method: 'POST', body });
    await VP.api('/admin/vms/<%= vm.id %>/neofetch-apply', { method: 'POST' });
    VP.toast('Neofetch banner applied to the running VM', 'success');
  } catch (e) {
    VP.toast(e.message, 'error');
  } finally {
    if (btn) btn.disabled = false;
  }
}

async function loadHostNet(btn) {
  const info = document.getElementById('hostNetInfo');
  const dl = document.getElementById('hostIps');
  const dl6 = document.getElementById('hostIps6');
  try {
    if (btn) btn.disabled = true;
    const d = await VP.api('/admin/host/network');
    const set = (id, v) => { const el = document.getElementById(id); if (el && v && !el.value.trim()) el.value = v; };
    const drop = (v) => { const s = String(v || '').trim(); const i = s.lastIndexOf('/'); return i > 0 ? s.slice(0, i).trim() : s; };
    const ips = (d.addresses || []).map((a) => drop(a.cidr || a.addr));
    const ip6s = (d.addresses_v6 || []).map((a) => drop(a.cidr || a.addr));
    set('net_ip_gateway', d.gateway);
    set('net_ipv6_gateway', d.gateway6);
    if (d.addresses && d.addresses[0]) set('net_ip_prefix', String(d.addresses[0].prefix));
    if (d.addresses_v6 && d.addresses_v6[0]) set('net_ipv6_prefix', String(d.addresses_v6[0].prefix));
    if (dl) dl.innerHTML = ips.map((x) => '<option value="' + x + '"></option>').join('');
    if (dl6) dl6.innerHTML = ip6s.map((x) => '<option value="' + x + '"></option>').join('');
    let msg = 'Detected host: ' + (d.primary_interface || '?') + ' · IPv4: ' + (ips.join(', ') || 'none') + (ip6s.length ? ' · IPv6: ' + ip6s.join(', ') : '');
    if (d.gateway) msg += ' · gw4 ' + d.gateway;
    if (d.gateway6) msg += ' · gw6 ' + d.gateway6;
    if (info) { info.textContent = msg; info.style.display = ''; }
    VP.toast('Host network detected — pick an IP above or type your own', 'success');
  } catch (e) {
    VP.toast('Detection failed: ' + e.message, 'error');
    if (info) { info.textContent = ''; info.style.display = 'none'; }
  } finally {
    if (btn) btn.disabled = false;
  }
}

function netEdit(side) {
  const is6 = side === '6';
  const raw = (document.getElementById(is6 ? 'net_ipv6_address' : 'net_ip_address').value || '').trim();
  if (!raw) return;
  const gw = document.getElementById(is6 ? 'net_ipv6_gateway' : 'net_ip_gateway');
  const pre = document.getElementById(is6 ? 'net_ipv6_prefix' : 'net_ip_prefix');
  const prefix = parseInt(pre.value, 10) || (is6 ? 64 : 24);
  if (gw && !gw.value.trim()) gw.value = netGwFrom(raw, prefix);
}
function netGwFrom(ip, prefix) {
  const drop = (v) => { const s = String(v || '').trim(); const i = s.lastIndexOf('/'); return i > 0 ? s.slice(0, i).trim() : s; };
  ip = drop(ip);
  if (ip.includes(':')) {
    let s = ip.toLowerCase(); let head = s, tail = '';
    const d = s.indexOf('::');
    if (d >= 0) { head = s.slice(0, d); tail = s.slice(d + 2); }
    const L = head ? head.split(':') : []; const R = tail ? tail.split(':') : [];
    const G = L.concat(Array(Math.max(0, 8 - L.length - R.length)).fill('0'), R).map((g) => g.padStart(4, '0'));
    if (G.length !== 8) return '';
    const bytes = [];
    for (const g of G) bytes.push(parseInt(g.slice(0, 2), 16), parseInt(g.slice(2, 4), 16));
    const p = Math.max(0, Math.min(128, parseInt(prefix, 10) || 64));
    for (let i = 0; i < 16; i++) {
      const bp = (i + 1) * 8;
      if (p < bp) {
        const k = Math.max(0, 8 - (bp - p));
        bytes[i] = bytes[i] & (k >= 8 ? 255 : (k > 0 ? 256 - (1 << (8 - k)) : 0));
      }
    }
    const out = [];
    for (let i = 0; i < 16; i += 2) out.push(((bytes[i] << 8) | bytes[i + 1]).toString(16).padStart(4, '0'));
    return out.join(':') + ':1';
  }
  const p = Math.max(0, Math.min(32, parseInt(prefix, 10) || 24));
  if (p >= 31) return ip;
  const o = ip.split('.').map(Number);
  if (o.length !== 4 || o.some(isNaN)) return '';
  let r = p; const m = [0, 0, 0, 0];
  for (let i = 0; i < 4; i++) { m[i] = r >= 8 ? 255 : (r > 0 ? 256 - (1 << (8 - r)) : 0); r -= 8; if (r < 0) r = 0; }
  const base = o.map((v, i) => v & m[i]);
  return base.slice(0, 3).join('.') + '.' + (base[3] === 255 ? 254 : base[3] + 1);
}

function openTransferModal() {
  const m = document.getElementById('transferModal');
  if (m) m.style.display = 'block';
}

function closeTransferModal() {
  const m = document.getElementById('transferModal');
  if (m) m.style.display = 'none';
}

async function submitTransfer() {
  const sel = document.getElementById('transferOwnerSelect');
  if (!sel || !sel.value) return;
  try {
    const res = await fetch('/admin/servers/<%= vm.id %>/transfer', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + vpToken() },
      body: JSON.stringify({ owner_id: sel.value })
    });
    const d = await res.json();
    if (!res.ok || !d.ok) throw new Error(d.error || 'Failed to transfer VM');
    VP.toast('Ownership transferred successfully', 'success');
    setTimeout(() => location.reload(), 700);
  } catch (e) {
    VP.toast(e.message, 'error');
  }
}

async function saveNetwork(btn) {
  const get = (id) => (document.getElementById(id) || {}).value || '';
  const body = {
    ip_mode: get('net_ip_mode'),
    ip_address: get('net_ip_address').trim(),
    ip_gateway: get('net_ip_gateway').trim(),
    ip_prefix: get('net_ip_prefix').trim(),
    ipv6_address: get('net_ipv6_address').trim(),
    ipv6_gateway: get('net_ipv6_gateway').trim(),
    ipv6_prefix: get('net_ipv6_prefix').trim(),
  };
  try {
    if (btn) btn.disabled = true;
    await VP.api('/admin/servers/<%= vm.id %>/network', { method: 'POST', body });
    VP.toast('Network saved — applies on next boot (Stop → Start)', 'success');
    setTimeout(() => location.reload(), 900);
  } catch (e) {
    VP.toast(e.message, 'error');
    if (btn) btn.disabled = false;
  }
}

async function action(a) {
  try {
    VP.toast(`Executing ${a}...`, 'info');
    await VP.api('/admin/servers/<%= vm.id %>/action', { method: 'POST', body: { action: a } });
    VP.toast('Command sent', 'success');
    setTimeout(() => location.reload(), 700);
  } catch (e) {
    VP.toast(e.message, 'error');
  }
}

function copyText(id, btn) {
  const el = document.getElementById(id);
  if (!el) return;
  const text = el.textContent.trim();
  const old = btn.textContent;
  if (navigator.clipboard && navigator.clipboard.writeText) {
    navigator.clipboard.writeText(text).then(() => {
      btn.textContent = 'Copied';
      setTimeout(() => (btn.textContent = old), 1200);
    }).catch(() => fallbackCopy(text, btn, old));
  } else {
    fallbackCopy(text, btn, old);
  }
}

function fallbackCopy(text, btn, old) {
  const ta = document.createElement('textarea');
  ta.value = text;
  ta.style.position = 'fixed';
  ta.style.opacity = '0';
  document.body.appendChild(ta);
  ta.select();
  try { document.execCommand('copy'); btn.textContent = 'Copied'; setTimeout(() => (btn.textContent = old), 1200); }
  catch (e) { VP.toast('Copy failed: ' + e.message, 'error'); }
  document.body.removeChild(ta);
}

async function regenPass(btn) {
  const ok = await VP.confirmDialog('Regenerate the SSH password for <%= vm.name %>? The new password takes effect after the VM is rebooted.', { title: 'Regenerate password?' });
  if (!ok) return;
  try {
    btn.disabled = true;
    const r = await VP.api('/admin/servers/<%= vm.id %>/action', { method: 'POST', body: { action: 'regenpass' } });
    VP.toast('Password regenerated', 'success');
    setTimeout(() => location.reload(), 700);
  } catch (e) {
    VP.toast(e.message, 'error');
    btn.disabled = false;
  }
}

async function del() {
  const ok = await VP.confirmDialog('Permanently delete <%= vm.name %> and ALL its disks/backups? This cannot be undone!', { title: 'Delete server?' });
  if (!ok) return;
  try {
    await VP.api('/admin/servers/<%= vm.id %>/action', { method: 'POST', body: { action: 'delete' } });
    VP.toast('Server deleted', 'success');
    setTimeout(() => location.href = '/admin/servers', 800);
  } catch (e) {
    VP.toast(e.message, 'error');
  }
}

async function loadSnapshots() {
  const list = document.getElementById('snapList');
  const count = document.getElementById('snapCount');
  try {
    const d = await VP.api('/admin/servers/<%= vm.id %>/snapshots');
    const snaps = d.snapshots || [];
    if (count) count.textContent = snaps.length;
    if (!list) return;
    if (!snaps.length) { list.textContent = 'No snapshots yet — create one to capture the full VM state.'; return; }
    list.innerHTML = snaps.map((s) =>
      '<div class="flex-between" style="padding:8px 0;border-bottom:1px solid var(--border);font-size:13px">' +
      '<span class="mono truncate" style="max-width:150px" title="' + (s.date || '') + '">' + (s.name || '') + '</span>' +
      '<span style="display:flex;gap:6px;flex-shrink:0">' +
      '<span class="muted text-sm" style="align-self:center">' + (s.size_text || ((s.size_bytes || 0) / 1024 / 1024).toFixed(1) + ' MB') + '</span>' +
      '<button class="btn btn-sm btn-primary" style="font-size:11px;padding:2px 7px" onclick="revertSnap(\'' + s.name.replace(/'/g, "\\'") + '\')">Revert</button>' +
      '<button class="btn btn-sm btn-danger" style="font-size:11px;padding:2px 7px" onclick="delSnap(\'' + s.name.replace(/'/g, "\\'") + '\')">Delete</button>' +
      '</span></div>'
    ).join('');
  } catch (e) {
    if (list) list.textContent = 'Failed to load snapshots: ' + e.message;
  }
}

async function createSnap() {
  const name = prompt('Snapshot name (optional):', 'snapshot-' + Date.now().toString(36));
  if (name === null) return;
  try {
    await VP.api('/admin/servers/<%= vm.id %>/snapshots', { method: 'POST', body: { name } });
    VP.toast('Snapshot created', 'success');
    loadSnapshots();
  } catch (e) { VP.toast(e.message, 'error'); }
}

async function revertSnap(name) {
  const ok = await VP.confirmDialog('Revert <%= vm.name %> to snapshot "' + name + '"? The disk will roll back, interrupting the VM briefly.', { title: 'Revert snapshot?' });
  if (!ok) return;
  try {
    await VP.api(`/admin/servers/<%= vm.id %>/snapshots/${encodeURIComponent(name)}/revert`, { method: 'POST' });
    VP.toast('Reverted to ' + name, 'success');
    setTimeout(() => location.reload(), 1200);
  } catch (e) { VP.toast(e.message, 'error'); }
}

async function delSnap(name) {
  const ok = await VP.confirmDialog('Delete snapshot "' + name + '"?', { title: 'Delete snapshot?' });
  if (!ok) return;
  try {
    await VP.api(`/admin/servers/<%= vm.id %>/snapshots/${encodeURIComponent(name)}/delete`, { method: 'POST' });
    loadSnapshots();
  } catch (e) { VP.toast(e.message, 'error'); }
}

loadSnapshots();

async function loadTmate(regen, btn) {
  if (!btn.disabled) btn.disabled = true;
  const el = document.getElementById('sshcmd');
  el.textContent = 'Connecting to the VM (first boot takes 1-3 min)...';
  try {
    await VP.api('/admin/servers/<%= vm.id %>/action', { method: 'POST', body: { action: 'tmate', regen: !!regen } });
    const started = Date.now();
    const poll = async () => {
      try {
        const s = await VP.api('/admin/servers/<%= vm.id %>/tmate-status');
        if (s.status === 'done' && s.ssh) {
          el.textContent = 'ssh ' + s.ssh;
          VP.toast(regen ? 'New tmate SSH generated' : 'tmate SSH ready', 'success');
          btn.disabled = false;
          return;
        }
        if (s.status === 'error') {
          VP.toast('tmate failed: ' + s.error, 'error');
          el.textContent = 'tmate failed — see toast';
          btn.disabled = false;
          return;
        }
        if (Date.now() - started > 5 * 60 * 1000) {
          VP.toast('Timed out waiting for tmate', 'error');
          btn.disabled = false;
          return;
        }
        setTimeout(poll, 3000);
      } catch (e) {
        VP.toast('tmate failed: ' + e.message, 'error');
        btn.disabled = false;
      }
    };
    setTimeout(poll, 3000);
  } catch (e) {
    VP.toast('tmate failed: ' + e.message, 'error');
    btn.disabled = false;
  }
}

async function reinstallVm(btn) {
  const os = document.getElementById('reinstall_os').value || '';
  const ok = await VP.confirmDialog('Wipe the disk of <%= vm.name %> and reinstall from ' + (os || 'its current OS template') + '? This destroys all data on the disk.', { title: 'Reinstall server?' });
  if (!ok) return;
  try {
    btn.disabled = true;
    const r = await VP.api('/admin/servers/<%= vm.id %>/action', { method: 'POST', body: { action: 'reinstall', os } });
    VP.toast('Reinstall started: ' + ((r.vm && r.vm.name) || 'OK'), 'success');
    setTimeout(() => location.reload(), 900);
  } catch (e) {
    VP.toast(e.message, 'error');
    btn.disabled = false;
  }
}
</script>
