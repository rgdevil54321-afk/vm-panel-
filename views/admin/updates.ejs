<%- include('../partials/head', { title: 'Updates Center' }) %>
<%- include('../partials/ambient') %>
<%- include('../partials/topbar') %>
<%- include('../partials/sidebar') %>
<div class="main">
  <div class="flex-between mb-3">
    <h2 style="font-size:22px">Updates Center</h2>
    <div class="flex" style="gap:8px">
      <button class="btn btn-sm" onclick="checkStatus()">Refresh</button>
      <button class="btn btn-sm" onclick="fetchNow()">Fetch Origin</button>
      <button class="btn btn-sm" onclick="updateAllNodes()">Update All Nodes</button>
    </div>
  </div>

  <div class="card" id="statusCard">
    <div class="card-title">Current Version</div>
    <div class="muted text-sm" id="statusLoading">Checking…</div>
    <div id="statusBody" style="display:none">
      <div class="grid grid-2" style="gap:12px;margin-top:6px">
        <div class="stat" style="padding:14px"><div class="stat-value mono" id="st_sha" style="font-size:20px">-</div><div class="stat-label mono" id="st_branch">-</div></div>
        <div class="stat" style="padding:14px"><div class="stat-value" id="st_msg" style="font-size:16px">-</div><div class="stat-label" id="st_date">-</div></div>
      </div>
      <div id="st_ahead" class="muted text-sm" style="margin-top:8px"></div>
      <div class="flex" style="gap:8px;margin-top:16px">
        <button class="btn btn-primary" id="btnUpdate" onclick="updateNow()">Update Panel</button>
        <button class="btn btn-warning" id="btnRollback" onclick="rollback()">Rollback to Previous</button>
        <span class="muted text-sm" style="align-self:center">Uses <code class="mono">git pull</code> and restarts via pm2.</span>
      </div>
    </div>
  </div>

  <div class="card mt-3">
    <div class="card-title">Recent Commits</div>
    <div class="table-wrap" style="margin-top:10px">
      <table>
        <thead><tr><th>Commit</th><th>Message</th></tr></thead>
        <tbody id="logRows"><tr><td colspan="2" class="muted">Loading…</td></tr></tbody>
      </table>
    </div>
  </div>
</div>
<%- include('../partials/music') %>
<%- include('../partials/foot') %>
<script>
const esc = (s) => String(s == null ? '' : s).replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
const busy = (btn, on) => { if (btn) { btn.disabled = !!on; btn.textContent = on ? btn.dataset.orig || 'Working…' : btn.dataset.orig || ''; } };

async function checkStatus() {
  const body = document.getElementById('statusBody');
  const loading = document.getElementById('statusLoading');
  loading.style.display = '';
  body.style.display = 'none';
  try {
    const res = await VP.api('/admin/updates/status');
    if (!res.ok) throw new Error(res.error || 'Failed to read git status');
    loading.style.display = 'none';
    body.style.display = '';
    document.getElementById('st_sha').textContent = res.current.sha || 'unknown';
    document.getElementById('st_branch').textContent = '@' + res.current.branch;
    document.getElementById('st_msg').textContent = res.current.message || '';
    document.getElementById('st_date').textContent = res.current.date ? new Date(res.current.date).toLocaleString() : '';
    const aheadEl = document.getElementById('st_ahead');
    if (res.ahead && res.ahead.tracking) {
      aheadEl.textContent = res.ahead.behind + ' behind origin, ' + res.ahead.ahead + ' ahead';
      document.getElementById('btnUpdate').style.display = res.ahead.behind > 0 ? '' : 'none';
    } else {
      aheadEl.textContent = 'No upstream tracking configured.';
      document.getElementById('btnUpdate').style.display = '';
    }
    const rows = document.getElementById('logRows');
    rows.innerHTML = (res.log || []).map((l) =>
      '<tr><td class="mono">' + esc(l.sha) + '</td><td class="text-sm">' + esc(l.message) + '</td></tr>'
    ).join('') || '<tr><td colspan="2" class="muted">No history.</td></tr>';
  } catch (e) {
    loading.style.display = 'none';
    body.style.display = 'none';
    document.getElementById('statusLoading').textContent = 'Cannot read git state (is this a git checkout?): ' + e.message;
  }
}

async function fetchNow() {
  try {
    const res = await VP.api('/admin/updates/fetch', { method: 'POST' });
    VP.toast(res.ok ? res.message : (res.message || 'Fetch failed'), res.ok ? 'success' : 'error');
    if (res.ok) checkStatus();
  } catch (e) { VP.toast(e.message, 'error'); }
}
async function updateAllNodes() {
  const ok = await VP.confirmDialog('Push this update to every connected node and reinstall agent code there?', { title: 'Update All Nodes', danger: false, okText: 'Update Nodes' });
  if (!ok) return;
  VP.toast('Pushing update to nodes…', 'success');
  try {
    const res = await VP.api('/admin/updates/nodes', { method: 'POST' });
    const okCount = (res.results || []).filter((r) => r.ok).length;
    VP.toast(res.ok ? `${okCount}/${(res.results || []).length} nodes updated` : (res.message || 'Node update failed'), res.ok ? 'success' : 'error');
  } catch (e) { VP.toast(e.message, 'error'); }
}

async function updateNow() {
  const btn = document.getElementById('btnUpdate');
  const ok = await VP.confirmDialog('Fetch latest and restart the panel? Node agents will need reinstalling when agent code changes.', { title: 'Update Panel', danger: false, okText: 'Update & Restart' });
  if (!ok) return;
  btn.dataset.orig = btn.textContent; btn.textContent = 'Updating…'; btn.disabled = true;
  try {
    const res = await VP.api('/admin/updates/update', { method: 'POST' });
    VP.toast(res.message, res.ok ? 'success' : 'error');
    if (res.ok) setTimeout(checkStatus, 1500);
  } catch (e) { VP.toast(e.message, 'error'); } finally { btn.disabled = false; btn.textContent = btn.dataset.orig || 'Update Panel'; }
}
async function rollback() {
  const btn = document.getElementById('btnRollback');
  const ok = await VP.confirmDialog('Check out the previous commit and restart the panel? Uncommitted local changes will need manual stashing.', { title: 'Rollback', danger: false, okText: 'Rollback & Restart' });
  if (!ok) return;
  btn.dataset.orig = btn.textContent; btn.textContent = 'Rolling back…'; btn.disabled = true;
  try {
    const res = await VP.api('/admin/updates/rollback', { method: 'POST' });
    VP.toast(res.message, res.ok ? 'success' : 'error');
    if (res.ok) setTimeout(checkStatus, 1500);
  } catch (e) { VP.toast(e.message, 'error'); } finally { btn.disabled = false; btn.textContent = btn.dataset.orig || 'Rollback to Previous'; }
}

checkStatus();
</script>