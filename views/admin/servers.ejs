<%- include('../partials/head', { title: 'Server Management' }) %>
<%- include('../partials/ambient') %>
<%- include('../partials/topbar') %>
<%- include('../partials/sidebar') %>
<div class="main">
  <div class="flex-between mb-4">
    <div>
      <h2 style="font-size:24px;font-weight:800;letter-spacing:-0.4px">Server Management</h2>
      <div class="muted" style="margin-top:2px">Manage all virtual machines across your cluster</div>
    </div>
    <a class="btn btn-primary" href="/admin/servers/create">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16"><path d="M12 5v14M5 12h14"/></svg>
      Create Virtual Machine
    </a>
  </div>

  <div class="card">
    <div class="flex-between mb-3">
      <div class="card-title" style="margin:0">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18"><rect x="2" y="2" width="20" height="8" rx="2"/><rect x="2" y="14" width="20" height="8" rx="2"/><path d="M6 6h.01M6 18h.01"/></svg>
        All Cluster Instances (<%= vms.length %>)
      </div>
      <input type="search" id="serverFilter" placeholder="Filter by name, owner, or port..." style="width:240px;padding:6px 12px;font-size:13px"/>
    </div>

    <% if (vms.length === 0) { %>
      <div class="empty">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="2" y="2" width="20" height="8" rx="2"/><rect x="2" y="14" width="20" height="8" rx="2"/><path d="M6 6h.01M6 18h.01"/></svg>
        <p style="font-size:15px;font-weight:600;color:var(--text)">No servers found</p>
        <p class="muted">No virtual machines have been provisioned yet.</p>
        <div class="mt-3"><a href="/admin/servers/create" class="btn btn-primary">Create First Server</a></div>
      </div>
    <% } else { %>
    <div class="table-wrap">
      <table id="serverTable">
        <thead>
          <tr>
            <th>Server Name</th>
            <th>Owner</th>
            <th>OS / Distro</th>
            <th>Hardware Specs</th>
            <th>SSH Port</th>
            <th>Status</th>
            <th>Created</th>
            <th class="right">Actions</th>
          </tr>
        </thead>
        <tbody>
        <% for (const v of vms) { %>
          <tr class="server-row">
            <td>
              <div class="flex" style="gap:10px">
                <div style="width:32px;height:32px;border-radius:9px;background:var(--glass);display:grid;place-items:center;border:1px solid var(--border)">
                  <svg viewBox="0 0 24 24" fill="none" stroke="var(--accent-2)" stroke-width="2" width="16" height="16"><rect x="2" y="2" width="20" height="8" rx="2"/><rect x="2" y="14" width="20" height="8" rx="2"/><path d="M6 6h.01M6 18h.01"/></svg>
                </div>
                <div>
                  <a href="/admin/servers/<%= v.id %>" style="font-weight:700;color:#fff;font-size:13.5px"><%= v.name %></a>
                  <div class="muted text-sm mono" style="font-size:11px"><%= v.username %>@<%= v.hostname || 'localhost' %></div>
                </div>
              </div>
            </td>
            <td>
              <span class="muted font-bold"><%= v.owner_name %></span>
            </td>
            <td><span class="pill pill-blue font-bold"><%= v.os_type || '-' %></span></td>
            <td><span class="muted"><%= v.cpus %> vCPU · <%= v.memory %>MB · <%= v.disk_size %></span></td>
            <td class="mono font-bold" style="color:var(--accent-2)">Port <%= v.ssh_port %></td>
            <td><span class="pill <%= v.status === 'running' ? 'pill-green' : 'pill-gray' %>"><%= v.status %></span></td>
            <td class="muted text-sm"><%= new Date(v.created_at).toLocaleDateString() %></td>
            <td class="right">
              <div class="flex right" style="gap:6px">
                <a class="btn btn-sm" href="/servers/<%= v.id %>/console" title="Open Terminal">Terminal</a>
                <% if (v.status === 'running') { %>
                  <button class="btn btn-sm btn-danger" onclick="action(<%= v.id %>,'stop')">Stop</button>
                  <button class="btn btn-sm btn-primary" onclick="action(<%= v.id %>,'restart')">Restart</button>
                <% } else { %>
                  <button class="btn btn-sm btn-green" onclick="action(<%= v.id %>,'start')">Start</button>
                <% } %>
                <a class="btn btn-sm" href="/admin/servers/<%= v.id %>">Manage</a>
                <button class="btn btn-sm btn-danger" onclick="del(<%= v.id %>)">Delete</button>
              </div>
            </td>
          </tr>
        <% } %>
        </tbody>
      </table>
    </div>
    <% } %>
  </div>
</div>
<%- include('../partials/music') %>
<%- include('../partials/foot') %>

<script>
async function action(id, a) {
  try {
    VP.toast(`Executing ${a}...`, 'info');
    await VP.api('/admin/servers/' + id + '/action', { method: 'POST', body: { action: a } });
    VP.toast(`Action ${a} processed`, 'success');
    setTimeout(() => location.reload(), 700);
  } catch (e) {
    VP.toast(e.message, 'error');
  }
}

async function del(id) {
  const ok = await VP.confirmDialog('Permanently delete this server and all its storage disks? This cannot be undone!', { title: 'Delete server?' });
  if (!ok) return;
  try {
    await VP.api('/admin/servers/' + id + '/action', { method: 'POST', body: { action: 'delete' } });
    VP.toast('Server deleted', 'success');
    setTimeout(() => location.reload(), 800);
  } catch (e) {
    VP.toast(e.message, 'error');
  }
}

document.getElementById('serverFilter')?.addEventListener('input', function() {
  const q = this.value.toLowerCase().trim();
  document.querySelectorAll('.server-row').forEach(row => {
    row.style.display = row.textContent.toLowerCase().includes(q) ? '' : 'none';
  });
});
</script>
