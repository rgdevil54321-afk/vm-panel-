<%- include('../partials/head', { title: 'Discord Bot' }) %>
<%- include('../partials/ambient') %>
<%- include('../partials/topbar') %>
<%- include('../partials/sidebar') %>
<div class="main">
  <div class="flex-between mb-3">
    <h2 style="font-size:22px">Discord Bot</h2>
    <div class="flex" style="gap:8px">
      <button class="btn btn-sm" onclick="loadStatus()">Refresh</button>
      <button class="btn btn-sm btn-primary" onclick="runGuard()">Run PlanGuard Now</button>
    </div>
  </div>

  <div class="card mb-3">
    <div class="card-title">Configuration</div>
    <p class="muted text-sm mb-2">Everything about the bot lives here — token, OAuth client (for linking users), target guild and the PlanGuard DM templates. Save to apply.</p>
    <div class="grid grid-2" style="gap:12px">
      <div class="form-group" style="margin:0">
        <label>Bot Token</label>
        <input id="bc_token" class="input" type="password" value="<%= String(settings['bot.token'] || '') %>" placeholder="MTEyMzQ1..." autocomplete="off" />
      </div>
      <div class="form-group" style="margin:0">
        <label>Guild ID (server the plans run on)</label>
        <input id="bc_guild" class="input" value="<%= String(settings['bot.guild_id'] || '') %>" placeholder="123456789012345678" />
      </div>
      <div class="form-group" style="margin:0">
        <label>OAuth Application ID (Client ID)</label>
        <input id="bc_cid" class="input" value="<%= String(settings['bot.client_id'] || '') %>" placeholder="needed for user Discord linking" />
      </div>
      <div class="form-group" style="margin:0">
        <label>OAuth Client Secret</label>
        <input id="bc_csec" class="input" type="password" value="<%= String(settings['bot.client_secret'] || '') %>" autocomplete="off" />
      </div>
      <div class="form-group" style="margin:0">
        <label>PlanGuard check interval (minutes)</label>
        <input id="bc_interval" class="input" type="number" min="1" value="<%= String(settings['bot.check_interval_min'] || '15') %>" />
      </div>
      <div class="form-group" style="margin:0">
        <label>Presence text <span class="muted">(shows as "Watching …", keeps the bot online)</span></label>
        <input id="bc_presence" class="input" maxlength="128" value="<%= String(settings['bot.presence'] || '') %>" placeholder="e.g. venlix.node" />
      </div>
      <div class="flex" style="align-items:flex-end;gap:14px">
        <label class="switch" style="margin-bottom:8px"><input id="bc_enabled" type="checkbox"<%= String(settings['bot.enabled'] || '0') === '1' ? ' checked' : '' %>/><span class="switch-slider"></span></label>
        <span class="text-sm muted">Bot enabled (sweep runs)</span>
      </div>
      <div class="form-group" style="margin:0">
        <label>Warn DM template <span class="muted">({name} {plan} {need} {have} {grace})</span></label>
        <textarea id="bc_dm_warn" class="input" rows="2" style="resize:vertical"><%= String(settings['bot.dm_warn'] || '') %></textarea>
      </div>
      <div class="form-group" style="margin:0">
        <label>Suspend DM template</label>
        <textarea id="bc_dm_suspend" class="input" rows="2" style="resize:vertical"><%= String(settings['bot.dm_suspend'] || '') %></textarea>
      </div>
      <div class="form-group" style="margin:0">
        <label>Restore DM template</label>
        <textarea id="bc_dm_restore" class="input" rows="2" style="resize:vertical"><%= String(settings['bot.dm_restore'] || '') %></textarea>
      </div>
    </div>
    <div class="flex" style="gap:8px;margin-top:14px">
      <button class="btn btn-primary" onclick="saveBotConfig()">Save Bot Configuration</button>
      <button class="btn" onclick="loadStatus()">Test Connection</button>
    </div>
  </div>

  <div class="card mb-3">
    <div class="card-title">Bot Profile</div>
    <p class="muted text-sm mb-2">Edit the bot's username and avatar directly through Discord — changes apply instantly (the gateway reconnects automatically). Usernames are limited to 2 changes per hour by Discord.</p>
    <div class="grid grid-2" style="gap:12px;align-items:center">
      <div class="flex" style="gap:14px;align-items:center">
        <img id="bp_avatar_img" alt="bot avatar" style="width:56px;height:56px;border-radius:12px;background:#111;object-fit:cover" />
        <div class="form-group" style="margin:0">
          <label>Bot Username</label>
          <input id="bp_username" class="input" placeholder="current username shown after load" />
        </div>
      </div>
      <div class="flex" style="gap:10px;align-items:flex-end">
        <div class="form-group" style="margin:0;flex:1">
          <label>New Avatar <span class="muted">(PNG / JPG / GIF)</span></label>
          <input id="bp_file" type="file" accept="image/*" class="input" />
          <span id="bp_file_name" class="muted text-sm" style="display:block;margin-top:4px"></span>
        </div>
        <button class="btn btn-primary" onclick="saveProfile()">Save Bot Profile</button>
      </div>
    </div>
    <div class="flex" style="gap:8px;margin-top:14px;align-items:center">
      <button class="btn btn-sm" onclick="buildInvite(this)">Build Invite Link</button>
      <input id="bp_invite" class="input" style="flex:1" readonly placeholder="Invite link appears here — add the bot to your server so it shows online" />
      <span id="bp_invite_warn" class="muted text-sm"></span>
    </div>
  </div>

  <div class="grid grid-2" style="gap:16px">
    <div class="card">
      <div class="card-title">Connection</div>
      <div id="botStatus" class="muted text-sm">Checking…</div>
    </div>
    <div class="card">
      <div class="card-title">Test Discord</div>
      <p class="muted text-sm mb-2">Send a DM from the bot to the logged-in user (or a custom Discord ID), verify the token works, or fetch feature data.</p>
      <div class="grid grid-2" style="gap:10px">
        <div class="form-group" style="margin:0"><label>Discord user ID (optional)</label><input id="bt_user" class="input" placeholder="blank = you" /></div>
        <div class="form-group" style="margin:0"><label>Message</label><input id="bt_msg" class="input" value="Venlix panel bot test ✔" /></div>
      </div>
      <div class="flex" style="gap:8px;margin-top:12px">
        <button class="btn btn-primary" onclick="testBot()">Send Test DM</button>
        <button class="btn" onclick="loadGuilds()">Fetch Guilds</button>
        <button class="btn" onclick="loadInvites()">Fetch Invites</button>
        <button class="btn" onclick="lookupMember()">Look up Member</button>
      </div>
      <div class="table-wrap" style="margin-top:14px">
        <table>
          <thead><tr><th>Guild</th><th>ID</th><th>Members</th><th></th><th></th></tr></thead>
          <tbody id="guildRows"><tr><td colspan="5" class="muted">—</td></tr></tbody>
        </table>
      </div>
      <div class="table-wrap" style="margin-top:10px">
        <table>
          <thead><tr><th>Invite Code</th><th>Channel</th><th>Uses</th><th>Max</th></tr></thead>
          <tbody id="inviteRows"><tr><td colspan="4" class="muted">—</td></tr></tbody>
        </table>
      </div>
      <div id="memberBox" class="muted text-sm" style="margin-top:10px"></div>
    </div>
  </div>
</div>
<%- include('../partials/music') %>
<%- include('../partials/foot') %>
<script>
const esc = (s) => String(s == null ? '' : s).replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
let GUILD_ID = '';
let PROFILE = null;
let PROFILE_AVATAR = null;

async function saveBotConfig() {
  const get = (id) => document.getElementById(id).value;
  const body = {
    'bot.token': get('bc_token').trim(),
    'bot.guild_id': get('bc_guild').trim(),
    'bot.client_id': get('bc_cid').trim(),
    'bot.client_secret': get('bc_csec').trim(),
    'bot.enabled': document.getElementById('bc_enabled').checked ? '1' : '0',
    'bot.check_interval_min': get('bc_interval').trim(),
    'bot.presence': get('bc_presence').trim(),
    'bot.dm_warn': get('bc_dm_warn'),
    'bot.dm_suspend': get('bc_dm_suspend'),
    'bot.dm_restore': get('bc_dm_restore'),
  };
  try {
    await VP.api('/admin/bot/config', { method: 'POST', body });
    VP.toast('Bot configuration saved', 'success');
    loadStatus();
  } catch (e) { VP.toast(e.message, 'error'); }
}

async function loadStatus() {
  const box = document.getElementById('botStatus');
  try {
    const res = await VP.api('/admin/bot/status');
    if (res.ok && res.me) {
      PROFILE = res.me;
      PROFILE_AVATAR = res.me.avatar
        ? 'https://cdn.discordapp.com/avatars/' + encodeURIComponent(res.me.id) + '/' + res.me.avatar + (res.me.avatar.startsWith('a_') ? '.gif' : '.png') + '?size=64'
        : 'https://cdn.discordapp.com/embed/avatars/0.png';
      document.getElementById('bp_avatar_img').src = PROFILE_AVATAR;
      const uInput = document.getElementById('bp_username');
      if (!uInput.dataset.dirty) uInput.value = res.me.username || '';
      const fileInput = document.getElementById('bp_file');
      fileInput.value = ''; fileInput.dataset.ready = '';
      document.getElementById('bp_file_name').textContent = '';
    }
    box.innerHTML = res.configured
      ? (res.ok
        ? '<span class="pill pill-green">connected</span> <span class="mono">' + esc(res.me.username) + '</span><span class="muted">#' + esc(res.me.discriminator || res.me.id) + '</span>'
        : '<span class="pill pill-red">token error</span> ' + esc(res.me_error || ''))
      + '<br/><span class="muted text-sm">guild: ' + esc(res.guild_id || 'not set') + ' · guard every ' + esc(res.check_interval_min) + ' min · ' + (res.enabled ? 'enabled' : 'paused') + '</span>'
      + '<br/><span class="muted text-sm">gateway: '
      + (res.gateway && res.gateway.running ? '<span class="pill pill-green">online</span> presenting "' + esc(res.presence || 'Venlix panel') + '"' : (res.gateway && res.gateway.available ? (res.gateway.intended ? '<span class="pill pill-yellow">connecting…</span> waiting on Discord gateway' : '<span class="pill pill-gray">paused</span> bot disabled') : '<span class="pill pill-gray">REST mode</span> offline presence'))
      + '</span>'
      : '<span class="pill pill-red">not configured</span> Add your token in the Configuration card above.';
  } catch (e) { box.textContent = 'Failed: ' + e.message; }
}

async function saveProfile() {
  const patch = {};
  const uInput = document.getElementById('bp_username');
  const newName = uInput.value.trim();
  if (newName && (!PROFILE || newName !== (PROFILE.username || ''))) patch.username = newName;
  const fileInput = document.getElementById('bp_file');
  if (fileInput.dataset.ready) patch.avatar = fileInput.dataset.ready;
  if (!patch.username && !patch.avatar) { VP.toast('Change the username or pick a new avatar first', 'warning'); return; }
  try {
    const res = await VP.api('/admin/bot/profile', { method: 'POST', body: patch });
    if (!res.ok) throw new Error(res.error || 'Profile update failed');
    PROFILE = res.me;
    PROFILE_AVATAR = res.me.avatar
      ? 'https://cdn.discordapp.com/avatars/' + encodeURIComponent(res.me.id) + '/' + res.me.avatar + (res.me.avatar.startsWith('a_') ? '.gif' : '.png') + '?size=64'
      : 'https://cdn.discordapp.com/embed/avatars/0.png';
    document.getElementById('bp_avatar_img').src = PROFILE_AVATAR;
    uInput.dataset.dirty = '';
    uInput.value = res.me.username || '';
    fileInput.value = ''; fileInput.dataset.ready = '';
    document.getElementById('bp_file_name').textContent = '';
    VP.toast('Bot profile updated — the bot may be briefly offline while Discord applies it', 'success');
    loadStatus();
  } catch (e) { VP.toast(e.message, 'error'); }
}

document.addEventListener('change', (ev) => {
  const f = ev.target;
  if (f.id !== 'bp_file' || !f.files || !f.files.length) return;
  const file = f.files[0];
  document.getElementById('bp_file_name').textContent = file.name;
  const reader = new FileReader();
  reader.onload = () => {
    f.dataset.ready = String(reader.result);
    VP.toast('Avatar ready — press Save Bot Profile', 'success');
  };
  reader.readAsDataURL(file);
});

function copyText(t, btn) {
  navigator.clipboard.writeText(t).then(() => { if (btn) { const o = btn.textContent; btn.textContent = 'Copied!'; setTimeout(() => (btn.textContent = o), 1200); } });
}

function buildInvite(btn) {
  const cid = document.getElementById('bc_cid').value.trim();
  const out = document.getElementById('bp_invite');
  const warn = document.getElementById('bp_invite_warn');
  if (!cid) { warn.textContent = 'Add your OAuth Client ID first.'; warn.className = 'text-sm'; return; }
  warn.textContent = '';
  out.value = 'https://discord.com/api/oauth2/authorize?client_id=' + encodeURIComponent(cid) + '&scope=bot&permissions=0';
  copyText(out.value, btn);
  VP.toast('Invite link copied — paste it in a browser and pick your server', 'success');
}

async function testBot() {
  const userId = document.getElementById('bt_user').value.trim();
  const message = document.getElementById('bt_msg').value.trim();
  try {
    const res = await VP.api('/admin/bot/test', { method: 'POST', body: { user_id: userId, message } });
    if (!res.ok) throw new Error(res.error || 'Bot test failed');
    VP.toast('Bot is alive' + (res.dm ? (res.dm.ok ? ' — DM sent' : ' — DM failed: ' + res.dm.error) : ' — no DM target'), 'success');
    loadStatus();
  } catch (e) { VP.toast(e.message, 'error'); }
}

async function loadGuilds() {
  try {
    const res = await VP.api('/admin/bot/guilds');
    if (!res.ok) throw new Error(res.error || 'Failed to load guilds');
    const rows = document.getElementById('guildRows');
    if (!res.guilds || !res.guilds.length) { rows.innerHTML = '<tr><td colspan="5" class="muted">Bot is not in any server.</td></tr>'; return; }
    rows.innerHTML = res.guilds.map((g) =>
      '<tr><td style="font-weight:600">' + esc(g.name) + '</td>'
      + '<td class="mono text-sm">' + esc(g.id) + '</td>'
      + '<td class="text-sm">' + (g.member_count || '?') + '</td>'
      + '<td><button class="btn btn-sm" onclick="copyText(\'' + esc(g.id) + '\', this)">Copy</button></td>'
      + '<td><button class="btn btn-sm" onclick="useGuild(\'' + esc(g.id) + '\')">Invites</button></td>'
      + '</tr>').join('');
  } catch (e) { VP.toast(e.message, 'error'); }
}

async function useGuild(gid) {
  GUILD_ID = gid;
  VP.toast('Selected guild: ' + gid);
  loadInvites(gid);
}

async function loadInvites(gid) {
  const target = gid || GUILD_ID || document.getElementById('bt_user').value.trim();
  if (!target) { VP.toast('Run "Fetch Guilds" first and pick one', 'warning'); return; }
  try {
    const res = await VP.api('/admin/bot/guilds/' + target + '/invites');
    if (!res.ok) throw new Error(res.error || 'Failed to load invites');
    const rows = document.getElementById('inviteRows');
    if (!res.invites || !res.invites.length) { rows.innerHTML = '<tr><td colspan="4" class="muted">No server invites — create one for invite plans to count.</td></tr>'; return; }
    rows.innerHTML = res.invites.map((i) =>
      '<tr><td class="mono text-sm" style="font-weight:600">' + esc(i.code) + '</td>'
      + '<td class="text-sm muted">' + esc(i.channel || '-') + '</td>'
      + '<td class="text-sm">' + i.uses + '</td>'
      + '<td class="text-sm">' + (i.max_uses || '∞') + '</td>'
      + '</tr>').join('');
  } catch (e) { VP.toast(e.message, 'error'); }
}

async function lookupMember() {
  const gid = GUILD_ID || document.getElementById('bt_user').value.trim();
  const uid = document.getElementById('bt_msg').value.trim();
  if (!gid || !uid) { VP.toast('Pick a guild (Invites) and put the Discord user ID in the message box', 'warning'); return; }
  try {
    const res = await VP.api('/admin/bot/guilds/' + gid + '/member/' + uid);
    const box = document.getElementById('memberBox');
    if (!res.ok) box.innerHTML = '<span class="pill pill-red">not found</span> ' + esc(res.error || 'member lookup failed');
    else box.innerHTML = '<span class="pill ' + (res.member.premium_since ? 'pill-green' : 'pill-gray') + '">' + (res.member.premium_since ? 'boosting' : 'not boosting') + '</span> '
      + '<span class="mono">' + esc((res.member.user && (res.member.user.username + '#' + (res.member.user.discriminator || res.member.user.id))) || uid) + '</span> '
      + '<span class="muted text-sm">roles ' + (res.member.roles || []).length + ' · joined ' + (res.member.joined_at ? new Date(res.member.joined_at).toLocaleDateString() : '?') + '</span>';
  } catch (e) { VP.toast(e.message, 'error'); }
}

async function runGuard() {
  const ok = await VP.confirmDialog('Run a PlanGuard sweep right now? It checks every active plan assignment (invite uses, boost status, expiry) and applies warns/suspensions.', { title: 'Run PlanGuard', okText: 'Run Now', danger: false });
  if (!ok) return;
  try {
    const res = await VP.api('/admin/bot/run-guard', { method: 'POST' });
    VP.toast(res.skipped ? 'PlanGuard skipped: ' + res.skipped : 'Checked ' + res.checked + '/' + res.total + ' plan assignments', res.ok ? 'success' : 'error');
  } catch (e) { VP.toast(e.message, 'error'); }
}

loadStatus();
</script>