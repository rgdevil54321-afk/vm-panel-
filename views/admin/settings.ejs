<%- include('../partials/head', { title: 'Settings Management' }) %>
<%- include('../partials/ambient') %>
<%- include('../partials/topbar') %>
<%- include('../partials/sidebar') %>

<style>
.wall-card-modern {
  position: relative;
  border-radius: 14px;
  overflow: hidden;
  border: 1px solid var(--border);
  background: var(--bg-card);
  aspect-ratio: 16/10;
  transition: all 0.25s ease;
  cursor: pointer;
}
.wall-card-modern:hover {
  transform: translateY(-4px);
  border-color: var(--accent);
  box-shadow: 0 12px 32px rgba(0,0,0,0.6);
}
.wall-card-modern img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.35s ease;
}
.wall-card-modern:hover img {
  transform: scale(1.06);
}
.wall-overlay-actions {
  position: absolute;
  inset: 0;
  background: linear-gradient(to top, rgba(6, 9, 19, 0.92) 0%, rgba(6, 9, 19, 0.4) 50%, transparent 100%);
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  padding: 12px;
  opacity: 0;
  transition: opacity 0.2s ease;
}
.wall-card-modern:hover .wall-overlay-actions {
  opacity: 1;
}
.wall-title-badge {
  font-size: 12px;
  font-weight: 700;
  color: #fff;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  text-shadow: 0 2px 4px rgba(0,0,0,0.8);
}
.subtab-btn {
  padding: 8px 16px;
  border-radius: 10px;
  border: 1px solid var(--border);
  background: rgba(0,0,0,0.25);
  color: var(--text-dim);
  font-size: 13px;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.2s ease;
  display: inline-flex;
  align-items: center;
  gap: 6px;
}
.subtab-btn:hover {
  background: rgba(255,255,255,0.06);
  color: #fff;
  border-color: var(--accent);
}
.subtab-btn.active {
  background: var(--accent);
  color: #fff;
  border-color: var(--accent);
  box-shadow: 0 0 14px var(--accent-glow);
}
.range-slider-wrap {
  background: rgba(0,0,0,0.25);
  border: 1px solid var(--border);
  border-radius: 14px;
  padding: 18px 20px;
  transition: border-color 0.2s ease;
}
.range-slider-wrap:hover {
  border-color: rgba(255,255,255,0.15);
}
</style>

<div class="main">
  <div class="flex-between mb-3">
    <div class="flex" style="gap:12px;align-items:center">
      <h2 style="font-size:22px;margin:0">Settings Management</h2>
      <span class="pill pill-blue">Administrator</span>
    </div>
    <div class="flex" style="gap:8px">
      <button type="button" class="btn btn-sm" onclick="resetCustomizationDefaults()" title="Reset Appearance &amp; Sliders to Defaults">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14"><path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/><path d="M3 3v5h5"/></svg>
        Reset to Defaults
      </button>
    </div>
  </div>

  <% if (typeof updated !== 'undefined' && updated) { %><div class="alert alert-success">Settings saved!</div><% } %>

  <!-- Top Main Tabs -->
  <div class="tabs mb-4" id="settingsTabs">
    <button class="tab active" data-tab="general" onclick="showTab('general')">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="15" height="15" style="vertical-align:-2px;margin-right:6px"><path d="M12 2a10 10 0 1 0 10 10A10 10 0 0 0 12 2zm0 18a8 8 0 1 1 8-8 8 8 0 0 1-8 8z"/><circle cx="12" cy="12" r="3"/></svg>
      General
    </button>
    <button class="tab" data-tab="customization" onclick="showTab('customization')">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="15" height="15" style="vertical-align:-2px;margin-right:6px"><circle cx="12" cy="12" r="10"/><path d="M12 2a14.5 14.5 0 0 0 0 20 10 10 0 0 0 9.54-13.88A10 10 0 0 0 12 2z"/></svg>
      Customization &amp; Background
    </button>
    <button class="tab" data-tab="security" onclick="showTab('security')">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="15" height="15" style="vertical-align:-2px;margin-right:6px"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
      Security
    </button>
    <button class="tab" data-tab="vms" onclick="showTab('vms')">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="15" height="15" style="vertical-align:-2px;margin-right:6px"><rect x="2" y="2" width="20" height="8" rx="2"/><rect x="2" y="14" width="20" height="8" rx="2"/><path d="M6 6h.01M6 18h.01"/></svg>
      VM Defaults
    </button>
    <button class="tab" data-tab="mail" onclick="showTab('mail')">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="15" height="15" style="vertical-align:-2px;margin-right:6px"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
      Email (SMTP)
    </button>
    <button class="tab" data-tab="music" onclick="showTab('music')">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="15" height="15" style="vertical-align:-2px;margin-right:6px"><path d="M11 5 6 9H2v6h4l5 4V5z"/><path d="M15.5 8.5a5 5 0 0 1 0 7"/></svg>
      Sound &amp; Privacy
    </button>
  </div>

  <!-- ============ GENERAL SETTINGS ============ -->
  <div class="tab-pane" id="tab-general">
    <div class="card mb-4" style="padding:24px">
      <div class="card-title mb-1" style="font-size:18px">General Settings</div>
      <p class="muted text-sm mb-4">Configure branding, panel identification, logo, and favicon.</p>

      <form method="post" action="/admin/settings/general">
        
        <!-- 1. Panel Name -->
        <div class="form-group mb-4">
          <label style="font-size:14px;font-weight:700;color:#fff">1. Panel Name</label>
          <div class="muted text-sm mb-2">Set the admin panel name displayed across navigation, page titles, and alerts.</div>
          <input name="panel.name" id="panelNameInput" value="<%= all['panel.name'] || 'Venlix Nodes' %>" placeholder="Venlix Nodes" oninput="updatePanelNamePreview(this.value)" style="max-width:500px"/>
        </div>

        <hr class="hr" style="margin:24px 0"/>

        <!-- 2. Discord Community -->
        <div class="form-group mb-4">
          <label style="font-size:14px;font-weight:700;color:#fff">2. Discord Community</label>
          <div class="muted text-sm mb-2">Show a floating Discord button and a background watermark. People click it and get invited to your server.</div>
          <div class="form-group mb-3">
            <label>Discord Invite Link</label>
            <input name="panel.discord_url" id="panelDiscordUrl" value="<%= all['panel.discord_url'] || 'https://discord.gg/venlixnodes' %>" placeholder="https://discord.gg/your-invite" style="max-width:500px"/>
            <div class="form-hint mt-1">Any invite link works: discord.gg/xxxx, discord.com/invite/xxxx, or a full invite URL. Change it anytime — the button updates everywhere.</div>
          </div>
          <div class="grid grid-2" style="gap:24px">
            <div class="form-group">
              <label>Show Floating Discord Button</label>
              <select name="panel.discord_enabled">
                <option value="1" <%= all['panel.discord_enabled'] !== '0' ? 'selected' : '' %>>Enabled (show round Discord button)</option>
                <option value="0" <%= all['panel.discord_enabled'] === '0' ? 'selected' : '' %>>Disabled (hide button)</option>
              </select>
              <div class="form-hint mt-1">Round button appears bottom-right on every page.</div>
            </div>
            <div class="form-group">
              <label>Background Watermark Text</label>
              <input name="panel.discord_code" value="<%= all['panel.discord_code'] || '.gg/venlixnodes' %>" placeholder=".gg/venlixnodes" style="max-width:100%"/>
              <div class="form-hint mt-1">Bold highlighted text shown on the panel background. Leave empty to hide.</div>
            </div>
          </div>
        </div>

        <!-- 3. Panel Logo -->
        <div class="mb-4">
          <label style="font-size:14px;font-weight:700;color:#fff;display:block;margin-bottom:4px">3. Panel Logo</label>
          <div class="muted text-sm mb-3">Upload custom logo image or specify a direct image URL with live preview.</div>
          
          <div class="grid grid-2" style="gap:24px;align-items:start">
            <div style="background:rgba(0,0,0,0.25);border:1px solid var(--border);border-radius:14px;padding:20px">
              <div class="form-group mb-3">
                <label>Logo Input Mode</label>
                <select name="panel.logo_mode" id="panelLogoMode" onchange="toggleLogoMode(this.value)">
                  <option value="url" <%= all['panel.logo_mode'] === 'url' ? 'selected' : '' %>>Logo URL</option>
                  <option value="upload" <%= all['panel.logo_mode'] === 'upload' ? 'selected' : '' %>>Upload Image File</option>
                </select>
              </div>

              <div class="form-group mb-3" id="logoUrlGroup" style="<%= all['panel.logo_mode'] === 'upload' ? 'display:none' : '' %>">
                <label>Logo Direct URL</label>
                <input name="panel.logo_url" id="panelLogoUrl" value="<%= all['panel.logo_url'] || '' %>" placeholder="https://example.com/logo.png" oninput="updateLogoPreview(this.value)"/>
              </div>

              <div class="form-group" id="logoUploadGroup" style="<%= all['panel.logo_mode'] !== 'upload' ? 'display:none' : '' %>">
                <label>Upload Logo Image</label>
                <div class="flex" style="gap:10px;align-items:center;flex-wrap:wrap">
                  <label class="btn btn-sm btn-primary" style="cursor:pointer">
                    <span>Choose Logo File</span>
                    <input type="file" id="logoFile" accept="image/*" style="display:none" onchange="uploadMedia('logo', this)"/>
                  </label>
                  <% if (all['panel.logo_file']) { %>
                    <button type="button" class="btn btn-sm btn-danger" onclick="clearMedia('logo')">Remove Uploaded Logo</button>
                  <% } %>
                </div>
                <div class="form-hint mt-1">Supports PNG, JPG, SVG, WebP</div>
              </div>
            </div>

            <!-- Logo Live Preview Box -->
            <div style="background:rgba(0,0,0,0.25);border:1px solid var(--border);border-radius:14px;padding:20px">
              <div class="flex-between mb-2">
                <label style="margin:0;font-weight:600">Logo Live Preview</label>
                <span class="pill pill-blue" style="font-size:10px">Live</span>
              </div>
              <div class="preview-box" id="logoPreviewBox" style="min-height:90px;background:rgba(0,0,0,0.4);border:1px dashed var(--border);border-radius:10px;display:grid;place-items:center;padding:12px">
                <% const logoP = all['panel.logo_mode'] === 'upload' ? all['panel.logo_file'] : all['panel.logo_url']; %>
                <% if (logoP) { %>
                  <img id="liveLogoImg" src="<%= logoP %>" style="max-height:48px;max-width:100%;object-fit:contain"/>
                <% } else { %>
                  <span id="liveLogoFallback" style="font-size:18px;font-weight:800;letter-spacing:-0.5px;color:var(--text)"><%= all['panel.name'] || 'Venlix Nodes' %></span>
                <% } %>
              </div>
            </div>
          </div>
        </div>

        <hr class="hr" style="margin:24px 0"/>

        <!-- 4. Panel Favicon Name -->
        <div class="form-group mb-4">
          <label style="font-size:14px;font-weight:700;color:#fff">4. Panel Favicon Name</label>
          <div class="muted text-sm mb-2">Set the favicon title/name. Used as fallback letter badge (first letter) when no icon is uploaded.</div>
          <input name="panel.favicon_name" id="panelFaviconName" value="<%= all['panel.favicon_name'] || '' %>" placeholder="V" oninput="updateFaviconNamePreview(this.value)" style="max-width:500px"/>
        </div>

        <hr class="hr" style="margin:24px 0"/>

        <!-- 5. Panel Favicon -->
        <div class="mb-4">
          <label style="font-size:14px;font-weight:700;color:#fff;display:block;margin-bottom:4px">5. Panel Favicon</label>
          <div class="muted text-sm mb-3">Upload custom favicon icon (.ico, .png, .svg) or specify a direct Favicon URL with live preview.</div>
          
          <div class="grid grid-2" style="gap:24px;align-items:start">
            <div style="background:rgba(0,0,0,0.25);border:1px solid var(--border);border-radius:14px;padding:20px">
              <div class="form-group mb-3">
                <label>Favicon Input Mode</label>
                <select name="panel.favicon_mode" id="panelFaviconMode" onchange="toggleFaviconMode(this.value)">
                  <option value="url" <%= all['panel.favicon_mode'] === 'url' ? 'selected' : '' %>>Favicon URL</option>
                  <option value="upload" <%= all['panel.favicon_mode'] === 'upload' ? 'selected' : '' %>>Upload Favicon File</option>
                </select>
              </div>

              <div class="form-group mb-3" id="faviconUrlGroup" style="<%= all['panel.favicon_mode'] === 'upload' ? 'display:none' : '' %>">
                <label>Favicon Direct URL</label>
                <input name="panel.favicon_url" id="panelFaviconUrl" value="<%= all['panel.favicon_url'] || '' %>" placeholder="https://example.com/favicon.ico" oninput="updateFaviconUrlPreview(this.value)"/>
              </div>

              <div class="form-group" id="faviconUploadGroup" style="<%= all['panel.favicon_mode'] !== 'upload' ? 'display:none' : '' %>">
                <label>Upload Favicon File</label>
                <div class="flex" style="gap:10px;align-items:center;flex-wrap:wrap">
                  <label class="btn btn-sm btn-primary" style="cursor:pointer">
                    <span>Choose Favicon</span>
                    <input type="file" id="faviconFile" accept="image/*" style="display:none" onchange="uploadMedia('favicon', this)"/>
                  </label>
                  <% if (all['panel.favicon_file']) { %>
                    <button type="button" class="btn btn-sm btn-danger" onclick="clearMedia('favicon')">Remove Uploaded Favicon</button>
                  <% } %>
                </div>
                <div class="form-hint mt-1">Supports ICO, PNG, SVG</div>
              </div>
            </div>

            <!-- Favicon Live Preview Box -->
            <div style="background:rgba(0,0,0,0.25);border:1px solid var(--border);border-radius:14px;padding:20px">
              <div class="flex-between mb-2">
                <label style="margin:0;font-weight:600">Favicon Live Preview</label>
                <span class="pill pill-green" style="font-size:10px">Live</span>
              </div>
              <div class="preview-box" id="favPreviewBox" style="min-height:90px;background:rgba(0,0,0,0.4);border:1px dashed var(--border);border-radius:10px;display:grid;place-items:center;padding:12px">
                <% const favP = all['panel.favicon_mode'] === 'upload' ? all['panel.favicon_file'] : all['panel.favicon_url']; %>
                <% if (favP) { %>
                  <img id="liveFaviconImg" src="<%= favP %>" style="max-height:36px;max-width:36px;object-fit:contain"/>
                <% } else { %>
                  <span id="liveFaviconBadge" style="font-size:28px;font-weight:900;color:var(--accent);line-height:1"><%= (all['panel.favicon_name'] || 'V')[0].toUpperCase() %></span>
                <% } %>
              </div>
            </div>
          </div>
        </div>

        <div class="mt-4">
          <button class="btn btn-primary" type="submit" style="padding:10px 24px;font-size:14px">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/><polyline points="17 21 17 13 7 13 7 21"/><polyline points="7 3 7 8 15 8"/></svg>
            Save General Settings
          </button>
        </div>
      </form>
    </div>
  </div>

  <!-- ============ CUSTOMIZATION & APPEARANCE ============ -->
  <div class="tab-pane" id="tab-customization" style="display:none">
    
    <!-- 1. SLIDERS & CONTROLS SECTION -->
    <div class="grid grid-2 mb-4" style="gap:20px">
      <!-- Sliders Column -->
      <div style="display:flex;flex-direction:column;gap:14px">
        
        <!-- Blur Slider -->
        <div class="range-slider-wrap">
          <div class="flex-between mb-2">
            <label style="font-weight:700;font-size:14px;color:#fff;margin:0;display:flex;align-items:center;gap:6px">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
              Blur Control (Glassmorphism)
            </label>
            <span id="blurValBadge" class="pill pill-blue mono font-bold"><%= all['panel.bg_blur'] || '16' %>px</span>
          </div>
          <div class="muted text-sm mb-3">CSS <code>backdrop-filter: blur()</code> for cards, sidebar and navigation bars</div>
          <input type="range" id="sliderBlur" min="0" max="40" step="1" value="<%= all['panel.bg_blur'] || '16' %>" oninput="updateLiveBlur(this.value)"/>
          <div class="flex-between mt-2 muted text-sm mono" style="font-size:11px">
            <span>0px (No Blur)</span>
            <span>16px (Default)</span>
            <span>40px (Ultra Blur)</span>
          </div>
        </div>

        <!-- Transparency Slider -->
        <div class="range-slider-wrap">
          <div class="flex-between mb-2">
            <label style="font-weight:700;font-size:14px;color:#fff;margin:0;display:flex;align-items:center;gap:6px">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><line x1="9" y1="3" x2="9" y2="21"/></svg>
              Transparency Control
            </label>
            <span id="transparencyValBadge" class="pill pill-green mono font-bold"><%= all['panel.bg_transparency'] || '65' %>%</span>
          </div>
          <div class="muted text-sm mb-3">Adjust UI card &amp; sidebar background opacity (0% Ultra Clear - 100% Solid)</div>
          <input type="range" id="sliderTransparency" min="10" max="100" step="1" value="<%= all['panel.bg_transparency'] || '65' %>" oninput="updateLiveTransparency(this.value)"/>
          <div class="flex-between mt-2 muted text-sm mono" style="font-size:11px">
            <span>10% (Ultra Clear)</span>
            <span>65% (Balanced)</span>
            <span>100% (Solid)</span>
          </div>
        </div>

        <!-- Dark Overlay Slider -->
        <div class="range-slider-wrap">
          <div class="flex-between mb-2">
            <label style="font-weight:700;font-size:14px;color:#fff;margin:0;display:flex;align-items:center;gap:6px">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16"><circle cx="12" cy="12" r="5"/><path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"/></svg>
              Background Dark Overlay
            </label>
            <span id="overlayValBadge" class="pill pill-yellow mono font-bold"><%= Math.round((parseFloat(all['panel.bg_overlay']) || 0.55) * 100) %>%</span>
          </div>
          <div class="muted text-sm mb-3">Darken image/video background for optimal text contrast and readability</div>
          <input type="range" id="sliderOverlay" min="0" max="0.9" step="0.05" value="<%= all['panel.bg_overlay'] || '0.55' %>" oninput="updateLiveOverlay(this.value)"/>
          <div class="flex-between mt-2 muted text-sm mono" style="font-size:11px">
            <span>0% (Raw Image)</span>
            <span>55% (Standard)</span>
            <span>90% (Deep Dark)</span>
          </div>
        </div>

      </div>

      <!-- Live Inspector & Auto-Save Column -->
      <div class="card" style="padding:22px;background:rgba(0,0,0,0.3);display:flex;flex-direction:column;justify-content:space-between">
        <div>
          <div class="flex-between mb-3">
            <div class="card-title" style="margin:0">Live Glassmorphism Inspector</div>
            <span id="autoSaveIndicator" class="pill pill-green" style="font-size:11px">
              <span class="pulse-dot"></span> Live Auto-Saved
            </span>
          </div>
          
          <div id="inspectorCard" class="card" style="padding:20px;border:1px solid var(--accent);background:var(--bg-card);box-shadow:0 8px 30px rgba(0,0,0,0.5)">
            <div class="flex-between mb-2">
              <span class="font-bold" style="font-size:15px">Venlix Nodes System</span>
              <span class="pill pill-green">Online &amp; Active</span>
            </div>
            <p class="muted text-sm mb-3">This card live-renders your glassmorphism blur and transparency in real-time as you adjust sliders.</p>
            <div class="flex" style="gap:8px">
              <button type="button" class="btn btn-primary btn-sm">Sample Action</button>
              <button type="button" class="btn btn-sm">Details</button>
            </div>
          </div>
        </div>

        <div class="mt-3 flex-between" style="border-top:1px solid var(--border);padding-top:14px">
          <span class="muted text-sm">Changes take effect instantly on all pages</span>
          <button type="button" class="btn btn-primary btn-sm" onclick="saveCustomizationSettings(true)">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/><polyline points="17 21 17 13 7 13 7 21"/><polyline points="7 3 7 8 15 8"/></svg>
            Save All Preferences
          </button>
        </div>
      </div>
    </div>

    <!-- 2. PANEL BACKGROUND SECTION -->
    <div class="card mb-4" style="padding:22px">
      <div class="flex-between mb-3" style="flex-wrap:wrap;gap:12px">
        <div>
          <div class="card-title" style="margin:0;font-size:18px">Panel Background Studio</div>
          <div class="muted text-sm mt-1">Select from curated 4K wallpapers, upload local images/videos, or apply direct URLs</div>
        </div>
        
        <!-- Background Subtabs -->
        <div class="flex flex-wrap" style="gap:8px">
          <button type="button" class="subtab-btn active" id="subtabBtnWp" onclick="switchBgSubtab('wp')">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
            4K Wallpapers (4kwallpapers.com)
          </button>
          <button type="button" class="subtab-btn" id="subtabBtnUpload" onclick="switchBgSubtab('upload')">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M17 8l-5-5-5 5M12 3v12"/></svg>
            Upload Image / Video
          </button>
          <button type="button" class="subtab-btn" id="subtabBtnUrl" onclick="switchBgSubtab('url')">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
            Background via URL
          </button>
          <button type="button" class="subtab-btn" id="subtabBtnFav" onclick="switchBgSubtab('fav')">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
            Favorites (<span id="favCountBadge">0</span>)
          </button>
        </div>
      </div>

      <!-- SUBTAB 1: 4K WALLPAPERS BROWSER -->
      <div id="bgSubPaneWp" class="bg-subpane">
