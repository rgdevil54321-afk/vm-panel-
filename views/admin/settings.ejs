<script>
let currentWpCategory = 'all';
let currentWpPage = 1;
let currentWpQuery = '';
let currentFavorites = JSON.parse(localStorage.getItem('vp_fav_wallpapers') || '[]');
let saveDebounceTimer = null;

function showTab(name) {
  document.querySelectorAll('.tab-pane').forEach((p) => p.style.display = 'none');
  const target = document.getElementById('tab-' + name);
  if (target) target.style.display = 'block';
  document.querySelectorAll('#settingsTabs .tab').forEach((t) => t.classList.toggle('active', t.dataset.tab === name));
}

function switchBgSubtab(subtab) {
  document.querySelectorAll('.subtab-btn').forEach(b => b.classList.remove('active'));
  document.querySelectorAll('.bg-subpane').forEach(p => p.style.display = 'none');

  if (subtab === 'wp') {
    document.getElementById('subtabBtnWp').classList.add('active');
    document.getElementById('bgSubPaneWp').style.display = 'block';
  } else if (subtab === 'upload') {
    document.getElementById('subtabBtnUpload').classList.add('active');
    document.getElementById('bgSubPaneUpload').style.display = 'block';
  } else if (subtab === 'url') {
    document.getElementById('subtabBtnUrl').classList.add('active');
    document.getElementById('bgSubPaneUrl').style.display = 'block';
  } else if (subtab === 'fav') {
    document.getElementById('subtabBtnFav').classList.add('active');
    document.getElementById('bgSubPaneFav').style.display = 'block';
    renderFavorites();
  }
}

function updateFavCountBadge() {
  const el = document.getElementById('favCountBadge');
  if (el) el.textContent = currentFavorites.length;
}

// 4K Wallpapers Loading & Rendering
async function load4kWallpapers() {
  const grid = document.getElementById('wpGalleryGrid');
  if (!grid) return;
  grid.innerHTML = '<div class="empty" style="grid-column:1/-1"><div class="spin mb-2"></div><p class="muted">Fetching 4K wallpapers...</p></div>';

  try {
    const url = `/api/wallpapers?category=${encodeURIComponent(currentWpCategory)}&page=${currentWpPage}&q=${encodeURIComponent(currentWpQuery)}`;
    const res = await fetch(url, { headers: { Authorization: 'Bearer ' + vpToken() } });
    const data = await res.json();

    if (!data.ok || !data.wallpapers || data.wallpapers.length === 0) {
      grid.innerHTML = '<div class="empty" style="grid-column:1/-1"><p class="muted">No wallpapers found for this query.</p></div>';
      return;
    }

    grid.innerHTML = '';
    data.wallpapers.forEach(w => {
      const isFav = currentFavorites.some(f => f.id === w.id);
      const card = document.createElement('div');
      card.className = 'wall-card-modern';
      card.innerHTML = `
        <img src="${w.thumb || w.preview}" alt="${w.title}" loading="lazy" referrerpolicy="no-referrer"/>
        <div class="wall-overlay-actions">
          <div class="flex-between">
            <span class="pill pill-blue" style="font-size:10px;padding:2px 6px">4K UHD</span>
            <button type="button" class="icon-btn" style="width:28px;height:28px;background:rgba(0,0,0,0.6)" onclick="toggleFav(event, ${JSON.stringify(w).replace(/"/g, '&quot;')})">
              ${isFav ? '⭐' : '☆'}
            </button>
          </div>
          <div>
            <div class="wall-title-badge mb-1">${w.title}</div>
            <div class="flex" style="gap:6px">
              <button type="button" class="btn btn-primary btn-sm" style="flex:1;padding:4px 8px;font-size:11.5px" onclick="applyWallpaper('${w.full || w.preview}', '${w.thumb}')">
                Apply
              </button>
              <button type="button" class="btn btn-sm" style="padding:4px 8px;font-size:11.5px" onclick="previewWallpaper('${w.full || w.preview}')">
                Preview
              </button>
              <a class="btn btn-sm" style="padding:4px 8px;font-size:11.5px" href="${w.full || w.preview}" target="_blank" rel="noreferrer" title="View Full Res">
                ⬇
              </a>
            </div>
          </div>
        </div>
      `;
      grid.appendChild(card);
    });

    document.getElementById('wpPageIndicator').textContent = `Page ${currentWpPage}`;
    document.getElementById('btnPrevWp').disabled = currentWpPage <= 1;
    document.getElementById('btnNextWp').disabled = !data.hasNext && data.wallpapers.length < 12;

  } catch (err) {
    grid.innerHTML = `<div class="empty" style="grid-column:1/-1"><p class="muted">Failed to load wallpapers: ${err.message}</p></div>`;
  }
}

function setWpCategory(cat, btn) {
  document.querySelectorAll('#categoryChips .os-filter-btn').forEach(b => b.classList.remove('active'));
  if (btn) btn.classList.add('active');
  currentWpCategory = cat;
  currentWpPage = 1;
  currentWpQuery = '';
  document.getElementById('wpSearchInput').value = '';
  load4kWallpapers();
}

function searchWp() {
  currentWpQuery = document.getElementById('wpSearchInput').value.trim();
  currentWpPage = 1;
  load4kWallpapers();
}

function changeWpPage(delta) {
  currentWpPage = Math.max(1, currentWpPage + delta);
  load4kWallpapers();
}

// Live Preview without saving
function previewWallpaper(url) {
  document.body.classList.add('bg-visible');
  const bg = document.getElementById('bgLayer');
  if (bg) {
    bg.style.backgroundImage = `url('${url}')`;
    bg.style.backgroundSize = 'cover';
    bg.style.backgroundPosition = 'center';
    bg.style.backgroundRepeat = 'no-repeat';
    bg.style.display = 'block';
  }
  const vid = document.getElementById('bgVideo');
  if (vid) vid.style.display = 'none';
  const overlay = document.getElementById('bgOverlay');
  if (overlay) overlay.style.display = 'block';
  VP.toast('Previewing wallpaper in background', 'info');
}

// One-Click Apply & Save
async function applyWallpaper(url, thumb) {
  previewWallpaper(url);
  try {
    const res = await fetch('/api/wallpapers/apply', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + vpToken() },
      body: JSON.stringify({
        url,
        thumbnail: thumb,
        blur: document.getElementById('sliderBlur').value,
        transparency: document.getElementById('sliderTransparency').value,
        overlay: document.getElementById('sliderOverlay').value
      })
    });
    const d = await res.json();
    if (!res.ok || !d.ok) throw new Error(d.error || 'Failed to apply');
    VP.toast('Wallpaper applied & saved successfully!', 'success');
  } catch (e) {
    VP.toast(e.message, 'error');
  }
}

// Sliders Live Handlers & Auto-Save
function updateLiveBlur(val) {
  document.getElementById('blurValBadge').textContent = `${val}px`;
  document.documentElement.style.setProperty('--panel-blur', `${val}px`);
  scheduleAutoSave();
}

function updateLiveTransparency(val) {
  document.getElementById('transparencyValBadge').textContent = `${val}%`;
  document.documentElement.style.setProperty('--panel-transparency', `${val}%`);
  const opacityRatio = (parseFloat(val) / 100).toFixed(2);
  document.documentElement.style.setProperty('--bg-card', `rgba(15, 23, 42, ${opacityRatio})`);
  document.documentElement.style.setProperty('--glass', `rgba(255, 255, 255, ${(0.06 * opacityRatio).toFixed(3)})`);
  scheduleAutoSave();
}

function updateLiveOverlay(val) {
  document.getElementById('overlayValBadge').textContent = `${Math.round(val * 100)}%`;
  document.documentElement.style.setProperty('--bg-overlay-val', val);
  const ov = document.getElementById('bgOverlay');
  if (ov) ov.style.background = `rgba(5,8,18,${val})`;
  scheduleAutoSave();
}

function scheduleAutoSave() {
  clearTimeout(saveDebounceTimer);
  saveDebounceTimer = setTimeout(() => {
    saveCustomizationSettings(false);
  }, 600);
  // ALSO fire an immediate save so a fast page navigation can't lose it
  if (!scheduleAutoSave._syncing) {
    scheduleAutoSave._syncing = true;
    saveCustomizationSettings(false).finally(() => { scheduleAutoSave._syncing = false; });
  }
}

function flushAutoSave() {
  clearTimeout(saveDebounceTimer);
  // sendBeacon survives page unload (unlike fetch)
  try {
    const payload = JSON.stringify({
      'panel.bg_blur': document.getElementById('sliderBlur').value,
      'panel.bg_transparency': document.getElementById('sliderTransparency').value,
      'panel.bg_overlay': document.getElementById('sliderOverlay').value
    });
    navigator.sendBeacon('/api/customization/save-beacon', new Blob([payload], { type: 'application/json' }));
  } catch (_) {}
  saveCustomizationSettings(false);
}

window.addEventListener('beforeunload', () => {
  flushAutoSave();
});

async function saveCustomizationSettings(showToast = true) {
  const blur = document.getElementById('sliderBlur').value;
  const transparency = document.getElementById('sliderTransparency').value;
  const overlay = document.getElementById('sliderOverlay').value;
  try {
    const res = await fetch('/api/customization/save', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + vpToken() },
      body: JSON.stringify({
        'panel.bg_blur': blur,
        'panel.bg_transparency': transparency,
        'panel.bg_overlay': overlay
      })
    });
    const d = await res.json();
    if (!res.ok || !d.ok) throw new Error(d.error || 'Failed to save');
    if (showToast) VP.toast('Customization preferences saved!', 'success');
  } catch (e) {
    if (showToast) VP.toast(e.message, 'error');
  }
}

function resetCustomizationDefaults() {
  updateLiveBlur(16);
  updateLiveTransparency(65);
  updateLiveOverlay(0.55);
  document.getElementById('sliderBlur').value = 16;
  document.getElementById('sliderTransparency').value = 65;
  document.getElementById('sliderOverlay').value = 0.55;
  const bg = document.getElementById('bgLayer');
  if (bg) {
    bg.style.backgroundImage = 'none';
    bg.style.backgroundColor = '#090d19';
  }
  saveCustomizationSettings(true);
  VP.toast('Customization reset to default', 'info');
}

async function saveMusicSfx() {
  const body = {
    'panel.sfx_volume': document.getElementById('sfxVolume').value,
    'panel.secret_blur': document.getElementById('secretBlurEnabled').checked ? '1' : '0',
  };
  try {
    const res = await fetch('/api/customization/save', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + vpToken() },
      body: JSON.stringify(body),
    });
    const d = await res.json();
    if (!res.ok || !d.ok) throw new Error(d.error || 'Failed to save');
    if (window.APP_SETTINGS) {
      window.APP_SETTINGS.sfx_volume = parseInt(body['panel.sfx_volume'], 10);
      window.APP_SETTINGS.secret_blur = body['panel.secret_blur'] === '1';
    }
    if (window.SFX) window.SFX.play('success');
    VP.toast('Settings saved!', 'success');
  } catch (e) {
    if (window.SFX) window.SFX.play('error');
    VP.toast(e.message, 'error');
  }
}

async function uploadMusicFile(input) {
  const f = input.files && input.files[0];
  if (!f) return;
  const fd = new FormData();
  fd.append('file', f);
  try {
    const res = await fetch('/admin/settings/music', {
      method: 'POST',
      headers: { 'Authorization': 'Bearer ' + vpToken() },
      body: fd,
    });
    const d = await res.json();
    if (!res.ok || !d.ok) throw new Error(d.error || 'Upload failed');
    document.getElementById('musicMode').value = 'file';
    if (window.APP_SETTINGS) window.APP_SETTINGS.music_mode = 'file';
    if (window.Music) window.Music.refresh();
    if (window.SFX) window.SFX.play('success');
    VP.toast('Music file uploaded', 'success');
  } catch (e) {
    if (window.SFX) window.SFX.play('error');
    VP.toast(e.message, 'error');
  }
}

// Favorites Management
function toggleFav(e, w) {
  e.stopPropagation();
  const idx = currentFavorites.findIndex(f => f.id === w.id);
  if (idx >= 0) {
    currentFavorites.splice(idx, 1);
    VP.toast('Removed from favorites', 'info');
  } else {
    currentFavorites.push(w);
    VP.toast('Added to favorites!', 'success');
  }
  localStorage.setItem('vp_fav_wallpapers', JSON.stringify(currentFavorites));
  updateFavCountBadge();
  load4kWallpapers();
}

function renderFavorites() {
  const grid = document.getElementById('favGalleryGrid');
  if (currentFavorites.length === 0) {
    grid.innerHTML = '<div class="empty" style="grid-column:1/-1"><p class="muted">No favorites saved yet. Click the star on any wallpaper to add it!</p></div>';
    return;
  }
  grid.innerHTML = '';
  currentFavorites.forEach(w => {
    const card = document.createElement('div');
    card.className = 'wall-card-modern';
    card.innerHTML = `
      <img src="${w.thumb || w.preview}" alt="${w.title}" referrerpolicy="no-referrer"/>
      <div class="wall-overlay-actions">
        <div class="flex-between">
          <span class="pill pill-blue">Favorite</span>
          <button type="button" class="icon-btn" style="width:28px;height:28px;background:rgba(0,0,0,0.6)" onclick="toggleFav(event, ${JSON.stringify(w).replace(/"/g, '&quot;')})">⭐</button>
        </div>
        <div>
          <div class="wall-title-badge mb-1">${w.title}</div>
          <div class="flex" style="gap:6px">
            <button type="button" class="btn btn-primary btn-sm" style="flex:1" onclick="applyWallpaper('${w.full || w.preview}', '${w.thumb}')">Apply</button>
            <button type="button" class="btn btn-sm" onclick="previewWallpaper('${w.full || w.preview}')">Preview</button>
          </div>
        </div>
      </div>
    `;
    grid.appendChild(card);
  });
}

// Local Upload Handlers
async function handleLocalImageUpload(input) {
  const f = input.files[0];
  if (!f) return;
  const reader = new FileReader();
  reader.onload = function(e) { previewWallpaper(e.target.result); };
  reader.readAsDataURL(f);

  const fd = new FormData();
  fd.append('file', f);
  try {
    VP.toast('Uploading image background...', 'info');
    const res = await fetch('/admin/settings/background', { method: 'POST', body: fd });
    const d = await res.json();
    if (!res.ok || !d.ok) throw new Error(d.error || 'Upload failed');
    VP.toast('Background image uploaded & applied!', 'success');
  } catch (e) {
    VP.toast(e.message, 'error');
  }
}

async function handleLocalVideoUpload(input) {
  const f = input.files[0];
  if (!f) return;
  const fd = new FormData();
  fd.append('file', f);
  try {
    VP.toast('Uploading video background...', 'info');
    const res = await fetch('/admin/settings/background', { method: 'POST', body: fd });
    const d = await res.json();
    if (!res.ok || !d.ok) throw new Error(d.error || 'Upload failed');
    const vid = document.getElementById('bgVideo');
    if (vid) {
      vid.src = d.url;
      vid.style.display = 'block';
    }
    VP.toast('Background video uploaded & applied!', 'success');
  } catch (e) {
    VP.toast(e.message, 'error');
  }
}

function previewDirectUrl() {
  const url = document.getElementById('directBgUrl').value.trim();
  const type = document.getElementById('directBgType').value;
  if (!url) return VP.toast('Please enter a valid URL', 'error');

  if (type === 'video') {
    const vid = document.getElementById('bgVideo');
    if (vid) {
      vid.src = url;
      vid.style.display = 'block';
    }
    VP.toast('Previewing video background', 'info');
  } else {
    previewWallpaper(url);
  }
}

async function applyDirectUrl() {
  const url = document.getElementById('directBgUrl').value.trim();
  const type = document.getElementById('directBgType').value;
  if (!url) return VP.toast('Please enter a valid URL', 'error');

  previewDirectUrl();
  try {
    const res = await fetch('/api/wallpapers/apply', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + vpToken() },
      body: JSON.stringify({ url, mode: type })
    });
    const d = await res.json();
    if (!res.ok || !d.ok) throw new Error(d.error || 'Failed to save URL');
    VP.toast('Background URL saved successfully!', 'success');
  } catch (e) {
    VP.toast(e.message, 'error');
  }
}

// General Settings Live Preview & Handlers
function toggleLogoMode(mode) {
  const urlGroup = document.getElementById('logoUrlGroup');
  const uploadGroup = document.getElementById('logoUploadGroup');
  if (urlGroup) urlGroup.style.display = mode === 'url' ? 'block' : 'none';
  if (uploadGroup) uploadGroup.style.display = mode === 'upload' ? 'block' : 'none';
}

function toggleFaviconMode(mode) {
  const urlGroup = document.getElementById('faviconUrlGroup');
  const uploadGroup = document.getElementById('faviconUploadGroup');
  if (urlGroup) urlGroup.style.display = mode === 'url' ? 'block' : 'none';
  if (uploadGroup) uploadGroup.style.display = mode === 'upload' ? 'block' : 'none';
}

function updatePanelNamePreview(val) {
  const fallback = document.getElementById('liveLogoFallback');
  if (fallback) fallback.textContent = val.trim() || 'Venlix Nodes';
}

function updateLogoPreview(url) {
  const box = document.getElementById('logoPreviewBox');
  if (!box) return;
  if (url && url.trim()) {
    box.innerHTML = `<img id="liveLogoImg" src="${url.trim()}" style="max-height:48px;max-width:100%;object-fit:contain" onerror="this.style.display='none'"/>`;
  } else {
    const name = (document.getElementById('panelNameInput') ? document.getElementById('panelNameInput').value : 'Venlix Nodes');
    box.innerHTML = `<span id="liveLogoFallback" style="font-size:18px;font-weight:800;letter-spacing:-0.5px;color:var(--text)">${name}</span>`;
  }
}

function updateFaviconNamePreview(val) {
  const letter = (val.trim() || 'V')[0].toUpperCase();
  const badge = document.getElementById('liveFaviconBadge');
  if (badge) badge.textContent = letter;
}

function updateFaviconUrlPreview(url) {
  const box = document.getElementById('favPreviewBox');
  if (!box) return;
  if (url && url.trim()) {
    box.innerHTML = `<img id="liveFaviconImg" src="${url.trim()}" style="max-height:36px;max-width:36px;object-fit:contain" onerror="this.style.display='none'"/>`;
  } else {
    const name = (document.getElementById('panelFaviconName') ? document.getElementById('panelFaviconName').value : 'V');
    const letter = (name.trim() || 'V')[0].toUpperCase();
    box.innerHTML = `<span id="liveFaviconBadge" style="font-size:28px;font-weight:900;color:var(--accent);line-height:1">${letter}</span>`;
  }
}

async function uploadMedia(type, input) {
  const file = input.files[0];
  if (!file) return;
  const fd = new FormData();
  fd.append('file', file);
  try {
    VP.toast(`Uploading ${type}...`, 'info');
    const res = await fetch('/admin/settings/' + type, { method: 'POST', body: fd });
    const d = await res.json();
    if (!res.ok || !d.ok) throw new Error(d.error || 'Upload failed');
    VP.toast(`${type.toUpperCase()} uploaded successfully!`, 'success');
    if (type === 'logo') {
      const box = document.getElementById('logoPreviewBox');
      if (box) box.innerHTML = `<img id="liveLogoImg" src="${d.url}" style="max-height:48px;max-width:100%;object-fit:contain"/>`;
    } else if (type === 'favicon') {
      const box = document.getElementById('favPreviewBox');
      if (box) box.innerHTML = `<img id="liveFaviconImg" src="${d.url}" style="max-height:36px;max-width:36px;object-fit:contain"/>`;
    }
  } catch (e) {
    VP.toast(e.message, 'error');
  }
}

async function clearMedia(type) {
  try {
    await VP.api('/admin/settings/' + type + '-clear', { method: 'POST' });
    VP.toast(`Removed uploaded ${type}`, 'info');
    setTimeout(() => location.reload(), 600);
  } catch (e) {
    VP.toast(e.message, 'error');
  }
}

// Initial Boot
updateFavCountBadge();
load4kWallpapers();

// Music mode toggle
(function musicModeInit() {
  const modeSel = document.getElementById('musicMode');
  if (!modeSel) return;
  function sync() {
    const v = modeSel.value;
    const urlG = document.getElementById('musicUrlGroup');
    const upG = document.getElementById('musicUploadGroup');
    if (urlG) urlG.style.display = v === 'url' ? '' : 'none';
    if (upG) upG.style.display = v === 'file' ? '' : 'none';
  }
  modeSel.addEventListener('change', sync);
  sync();
})();
</script>
