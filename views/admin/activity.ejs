<%- include('../partials/head', { title: 'Activity Log' }) %>
<%- include('../partials/ambient') %>
<%- include('../partials/topbar') %>
<%- include('../partials/sidebar') %>
<div class="main">
  <h2 style="font-size:22px" class="mb-3">Activity Log</h2>
  <div class="card">
    <div class="table-wrap">
      <table>
        <thead><tr><th>Event</th><th>User</th><th>Server</th><th>Details</th><th>IP</th><th>When</th></tr></thead>
        <tbody>
        <% for (const a of logs) { %>
          <tr>
            <td><span class="pill pill-blue"><%= a.event %></span></td>
            <td><%= a.username || 'System' %></td>
            <td><% if (a.vm_id) { %><a href="/admin/servers/<%= a.vm_id %>"><%= a.vm_name || ('#'+a.vm_id) %></a><% } else { %>-<% } %></td>
            <td class="muted truncate" style="max-width:300px"><%= a.details ? JSON.stringify(a.details) : '-' %></td>
            <td class="muted"><%= a.ip || '-' %></td>
            <td class="muted"><%= new Date(a.created_at).toLocaleString() %></td>
          </tr>
        <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>
<%- include('../partials/music') %>
<%- include('../partials/foot') %>
