<%- include('../partials/head', { title: 'Admin Overview' }) %>
<%- include('../partials/ambient') %>
<%- include('../partials/topbar') %>
<%- include('../partials/sidebar') %>
<div class="main">
  <div class="flex-between mb-4">
    <div>
      <h2 style="font-size:24px;font-weight:800;letter-spacing:-0.4px">Admin Overview</h2>
      <div class="muted" style="margin-top:2px">Cluster management &amp; host health metrics</div>
    </div>
    <a class="btn btn-primary" href="/admin/servers/create">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16"><path d="M12 5v14M5 12h14"/></svg>
      Create Virtual Machine
    </a>
  </div>

  <!-- Admin Stats Grid -->
  <div class="grid grid-4 mb-4">
    <div class="stat">
      <div class="stat-icon" style="background:rgba(99,102,241,0.15);color:#818cf8">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="2" width="20" height="8" rx="2"/><rect x="2" y="14" width="20" height="8" rx="2"/><path d="M6 6h.01M6 18h.01"/></svg>
      </div>
      <div>
        <div class="stat-value"><%= vms.length %></div>
        <div class="stat-label">Total Virtual Machines</div>
      </div>
    </div>

    <div class="stat">
      <div class="stat-icon" style="background:rgba(16,185,129,0.15);color:#34d399">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
      </div>
      <div>
        <div class="stat-value" style="color:#34d399"><%= running %></div>
        <div class="stat-label">Running Online</div>
      </div>
    </div>

    <div class="stat">
      <div class="stat-icon" style="background:rgba(56,189,248,0.15);color:#38bdf8">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/></svg>
      </div>
      <div>
        <div class="stat-value"><%= users.length %></div>
        <div class="stat-label">Registered Users</div>
      </div>
    </div>

    <div class="stat">
      <div class="stat-icon" style="background:rgba(245,158,11,0.15);color:#fbbf24">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12a9 9 0 1 1-2.64-6.36M21 3v6h-6"/></svg>
      </div>
      <div>
        <div class="stat-value"><%= totalDisk %> <span style="font-size:13px;color:var(--text-dim)">GB</span></div>
        <div class="stat-label">Total Allocated Storage</div>
      </div>
    </div>
  </div>

  <!-- Primary Host Node & Live Telemetry -->
  <div class="card mb-4" style="padding:20px;border:1px solid var(--accent);background:linear-gradient(135deg, rgba(15, 23, 42, 0.8) 0%, rgba(6, 9, 19, 0.9) 100%)">
    <div class="flex-between mb-3" style="flex-wrap:wrap;gap:10px">
      <div class="flex" style="gap:12px;align-items:center">
        <div style="width:40px;height:40px;border-radius:12px;background:linear-gradient(135deg, var(--accent), var(--accent-2));display:grid;place-items:center;color:#fff;box-shadow:0 0 16px var(--accent-glow)">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="22" height="22"><rect x="2" y="2" width="20" height="8" rx="2"/><rect x="2" y="14" width="20" height="8" rx="2"/><path d="M6 6h.01M6 18h.01"/></svg>
        </div>
        <div>
          <div class="flex" style="gap:8px;align-items:center">
            <span class="font-bold" style="font-size:16px;color:#fff"><%= nodeStats ? nodeStats.name : 'Primary Host Node' %></span>
            <span class="pill pill-green font-bold"><span class="pulse-dot"></span> Online</span>
          </div>
          <div class="muted text-sm" style="font-size:12px">
            <%= nodeStats ? nodeStats.hostname : 'localhost' %> · <%= nodeStats ? nodeStats.cpu.model : 'x86_64' %> · <%= nodeStats ? nodeStats.cpu.cores : '4' %> Cores
          </div>
        </div>
      </div>
      <a href="/admin/nodes" class="btn btn-primary btn-sm">
        View Node Live Telemetry ↗
      </a>
    </div>

    <div class="grid grid-3" style="gap:14px">
      <div class="flex" style="background:rgba(0,0,0,0.3);border:1px solid var(--border);border-radius:12px;padding:12px 16px">
        <span class="pill <%= usage.qemu ? 'pill-green' : 'pill-red' %>"><%= usage.qemu ? 'Installed' : 'Missing' %></span>
        <div style="margin-left:8px">
          <div style="font-weight:700">QEMU Hypervisor</div>
          <div class="muted text-sm" style="font-size:11px">x86_64 KVM Virtualization Engine</div>
        </div>
      </div>

      <div class="flex" style="background:rgba(0,0,0,0.3);border:1px solid var(--border);border-radius:12px;padding:12px 16px">
        <span class="pill <%= usage.cloudLocalds ? 'pill-green' : 'pill-red' %>"><%= usage.cloudLocalds ? 'Installed' : 'Missing' %></span>
        <div style="margin-left:8px">
          <div style="font-weight:700">Cloud-Init Engine</div>
          <div class="muted text-sm" style="font-size:11px">Seed ISO &amp; metadata generator</div>
        </div>
      </div>

      <div class="flex" style="background:rgba(0,0,0,0.3);border:1px solid var(--border);border-radius:12px;padding:12px 16px">
        <span class="pill pill-blue"><%= nodeStats ? nodeStats.vms.running : '0' %> / <%= nodeStats ? nodeStats.vms.total : '0' %> Running</span>
        <div style="margin-left:8px">
          <div style="font-weight:700">Node VM Density</div>
          <div class="muted text-sm" style="font-size:11px"><%= nodeStats ? nodeStats.vms.allocated_memory_mb : '0' %> MB RAM Allocated</div>
        </div>
      </div>
    </div>
  </div>

  <!-- All Virtual Machines Management Table -->
  <div class="card">
    <div class="flex-between mb-3">
      <div class="card-title" style="margin:0">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18"><rect x="2" y="2" width="20" height="8" rx="2"/><rect x="2" y="14" width="20" height="8" rx="2"/><path d="M6 6h.01M6 18h.01"/></svg>
        All Cluster Virtual Machines
      </div>
      <a href="/admin/servers" class="btn btn-sm">View All Servers</a>
    </div>

    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th>Instance</th>
            <th>Owner</th>
            <th>OS / Distro</th>
            <th>SSH Port</th>
            <th>Status</th>
            <th class="right">Management</th>
          </tr>
        </thead>
        <tbody>
        <% for (const v of vms) { %>
          <tr>
            <td>
              <a href="/admin/servers/<%= v.id %>" style="font-weight:700;color:#fff"><%= v.name %></a>
              <div class="muted text-sm mono" style="font-size:11.5px"><%= v.hostname || 'localhost' %></div>
            </td>
            <td>
              <span class="muted font-bold"><%= v.owner_name || 'Admin' %></span>
            </td>
            <td><span class="pill pill-blue font-bold"><%= v.os_type || '-' %></span></td>
            <td class="mono font-bold" style="color:var(--accent-2)">Port <%= v.ssh_port %></td>
            <td><span class="pill <%= v.status === 'running' ? 'pill-green' : 'pill-gray' %>"><%= v.status %></span></td>
            <td class="right">
              <div class="flex right" style="gap:6px">
                <a class="btn btn-sm" href="/servers/<%= v.id %>/console" title="Open Terminal">Terminal</a>
                <% if (v.status === 'running') { %>
                  <button class="btn btn-sm btn-danger" onclick="action(<%= v.id %>,'stop')">Stop</button>
                  <button class="btn btn-sm" onclick="action(<%= v.id %>,'restart')">Restart</button>
                <% } else { %>
                  <button class="btn btn-sm btn-green" onclick="action(<%= v.id %>,'start')">Start</button>
                <% } %>
                <a class="btn btn-sm btn-primary" href="/admin/servers/<%= v.id %>">Manage</a>
              </div>
            </td>
          </tr>
        <% } %>
        </tbody>
      </table>
    </div>
  </div>

  <!-- Recent Global Audit Logs -->
  <div class="card mt-4">
    <div class="card-title">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18"><path d="M12 8v4l3 3M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20z"/></svg>
      Recent Global Audit Logs
    </div>
    <div class="table-wrap">
      <table>
        <thead><tr><th>Event</th><th>User</th><th>Details</th><th>Timestamp</th></tr></thead>
        <tbody>
        <% for (const a of recentLogs.slice(0, 10)) { %>
          <tr>
            <td><span class="pill pill-blue mono font-bold"><%= a.event %></span></td>
            <td style="font-weight:600"><%= a.username || 'System' %></td>
            <td class="muted mono text-sm truncate" style="max-width:340px"><%= a.details ? JSON.stringify(a.details) : '—' %></td>
            <td class="muted text-sm"><%= new Date(a.created_at).toLocaleString() %></td>
          </tr>
        <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>
<%- include('../partials/music') %>
<%- include('../partials/foot') %>

<script>
async function action(id, a) {
  try {
    VP.toast(`Executing ${a}...`, 'info');
    await VP.api('/admin/servers/' + id + '/action', { method: 'POST', body: { action: a } });
    VP.toast(`Action ${a} completed`, 'success');
    setTimeout(() => location.reload(), 700);
  } catch (e) {
    VP.toast(e.message, 'error');
  }
}
</script>
