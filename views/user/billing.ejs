<%- include('../partials/head', { title: 'Billing & Quotas' }) %>
<%- include('../partials/ambient') %>
<%- include('../partials/topbar') %>
<%- include('../partials/sidebar') %>
<div class="main">
  <h2 style="font-size:22px">Billing &amp; Quotas</h2>

  <% if (billingEnabled) { %>
  <div class="grid grid-2 mt-3">
    <div class="card" style="padding:24px">
      <div class="card-title" style="margin:0">Credits Balance</div>
      <div style="font-size:46px;font-weight:800;color:var(--accent-2);margin:14px 0"><%= q.credits.toFixed(2) %></div>
      <% if (bonusEnabled) { %>
        <% if (canClaim) { %>
          <button class="btn btn-primary" onclick="claimBonus()">Claim Daily Bonus (+<%= prices.bonus %>)</button>
        <% } else { %>
          <div class="muted text-sm">Bonus claimed. Next available in <span id="bonusCountdown" data-at="<%= nextBonusAt %>">…</span></div>
        <% } %>
      <% } %>
      <div class="muted text-sm" style="margin-top:10px">Credits are deducted when you create a VM. Ask an admin to top up your balance.</div>
    </div>
    <div class="card" style="padding:24px">
      <div class="card-title" style="margin:0">Resource Usage</div>
      <% const lim = (v) => (v < 0 ? 'Unlimited' : String(v)); %>
      <table style="width:100%;margin-top:12px">
        <tbody>
          <tr><td>VMs</td><td class="mono"><%= q.used_vms %> / <%= lim(q.max_vms) %></td></tr>
          <tr><td>CPU cores</td><td class="mono"><%= q.used_cpu %> / <%= lim(q.max_cpu) %></td></tr>
          <tr><td>RAM</td><td class="mono"><%= q.used_mem_mb %> MB / <%= lim(q.max_mem_mb) %></td></tr>
          <tr><td>Disk</td><td class="mono"><%= q.used_disk_gb.toFixed(1) %> GB / <%= lim(q.max_disk_gb) %></td></tr>
        </tbody>
      </table>
    </div>
  </div>

  <div class="card mt-3" style="padding:24px">
    <div class="card-title" style="margin:0">Pricing</div>
    <p class="muted text-sm" style="margin:8px 0">A new VM costs: <span class="mono"><%= prices.base %> base + <%= prices.ram %> × RAM(GB) + <%= prices.disk %> × Disk(GB)</span> credits.</p>
    <div class="grid grid-3" style="gap:12px">
      <div class="stat" style="padding:14px"><div class="stat-value" style="font-size:22px"><%= prices.base %></div><div class="stat-label">Base price per VM</div></div>
      <div class="stat" style="padding:14px"><div class="stat-value" style="font-size:22px"><%= prices.ram %></div><div class="stat-label">Per 1 GB RAM</div></div>
      <div class="stat" style="padding:14px"><div class="stat-value" style="font-size:22px"><%= prices.disk %></div><div class="stat-label">Per 1 GB disk</div></div>
    </div>
  </div>
  <% } else { %>
  <div class="card mt-3" style="padding:24px">
    <div class="muted">Billing is currently disabled by the administrator.</div>
  </div>
  <% } %>

  <div class="card mt-3">
    <div class="card-title">Your Plan &amp; Discord</div>
    <div class="grid grid-2" style="gap:18px;margin-top:6px">
      <div>
        <% if (activePlan) { %>
          <% const st = activePlan.status; %>
          <div>
            <span class="pill <%= st === 'active' ? 'pill-green' : st === 'warned' ? 'pill-yellow' : st === 'suspended' ? 'pill-red' : 'pill-gray' %>"><%= st %></span>
            <span style="font-weight:700;font-size:18px"><%= activePlan.plan_name %></span>
            <span class="muted text-sm">/ <%= activePlan.plan_kind %></span>
          </div>
          <div class="muted text-sm" style="margin-top:8px;line-height:1.7">
            <% if (activePlan.plan_kind === 'invite') { %>
              Invite <code class="mono"><%= activePlan.invite_code || '—' %></code> must reach <b><%= activePlan.invites_required %></b> uses from your linked Discord account.
            <% } else if (activePlan.plan_kind === 'booster') { %>
              Your linked Discord account must be boosting the server.
            <% } else if (activePlan.expires_at) { %>
              Paid until <b><%= new Date(activePlan.expires_at).toLocaleDateString() %></b> · <%= activePlan.renewals %> renewal(s).
            <% } else { %>
              No expiry.
            <% } %>
          </div>
          <% if (st === 'warned') { %><p class="muted text-sm" style="color:var(--yellow)">Warning: meeting your plan requirement keeps servers running. Suspension happens after the grace period.</p>
          <% } else if (st === 'suspended') { %><p class="muted text-sm" style="color:var(--red)">Your servers are suspended until the plan requirement is met again.</p>
          <% } %>
          <% if (activePlan.plan_kind === 'paid' && activePlan.renewable === 1 && activePlan.duration_days) { %>
            <button class="btn btn-sm btn-primary" style="margin-top:10px" onclick="renewPlan()">Renew +<%= activePlan.duration_days %> days</button>
          <% } %>
        <% } else { %>
          <p class="muted text-sm">No plan assigned yet. Contact an administrator to activate invite, booster or paid perks.</p>
        <% } %>
      </div>
      <div>
        <div class="card-title" style="font-size:14px;margin-bottom:6px">Discord account</div>
        <p class="muted text-sm" style="margin:0 0 10px">Required for invite &amp; booster plans, and so the bot can DM you about plan warnings.</p>
        <% if (user.discord_id) { %>
          <div class="flex" style="gap:10px;align-items:center">
            <% if (user.discord_avatar) { %><img src="<%= user.discord_avatar %>" style="width:34px;height:34px;border-radius:50%" alt=""/><% } %>
            <div>
              <div style="font-weight:600"><%= user.discord_name || user.discord_id %></div>
              <div class="muted text-sm"><%= user.discord_id %><% if (user.discord_linked_at) { %> · linked <%= new Date(user.discord_linked_at).toLocaleDateString() %><% } %></div>
            </div>
          </div>
        <% } else { %>
          <div class="muted text-sm">Not linked yet.</div>
        <% } %>
        <a class="btn btn-sm btn-primary" style="margin-top:12px" href="/settings"><%= user.discord_id ? 'Manage in Settings' : 'Link Discord in Settings' %></a>
      </div>
    </div>
  </div>

  <div class="card mt-3">
    <div class="card-title">Redeem Coupon</div>
    <p class="muted text-sm mb-2">Enter a coupon code to add credits to your balance. Each code can be used once per account.</p>
    <div class="flex" style="gap:8px;align-items:flex-end;margin-top:10px">
      <div class="form-group" style="margin:0">
        <label>Code</label>
        <input id="couponCode" class="input" placeholder="WELCOME25" />
      </div>
      <button class="btn btn-primary" onclick="redeemCoupon()">Redeem</button>
    </div>
  </div>

  <div class="card mt-3">
    <div class="card-title">Your Invoices</div>
    <div class="table-wrap" style="margin-top:10px">
      <table>
        <thead><tr><th>#</th><th>Description</th><th>Amount</th><th>Status</th><th>Date</th></tr></thead>
        <tbody id="invRows"><tr><td colspan="5" class="muted">Loading…</td></tr></tbody>
      </table>
    </div>
  </div>
</div>
<%- include('../partials/music') %>
<%- include('../partials/foot') %>
<script>
async function claimBonus() {
  try {
    const d = await VP.api('/billing/claim', { method: 'POST' });
    VP.toast('+' + d.amount + ' credits claimed!', 'success');
    setTimeout(() => location.reload(), 900);
  } catch (e) { VP.toast(e.message, 'error'); }
}
(function tick() {
  const el = document.getElementById('bonusCountdown');
  if (!el) return;
  const target = new Date(el.dataset.at).getTime();
  const upd = () => {
    const ms = target - Date.now();
    if (ms <= 0) return location.reload();
    const h = Math.floor(ms / 3600000), m = Math.floor((ms % 3600000) / 60000);
    el.textContent = h + 'h ' + m + 'm';
  };
  upd(); setInterval(upd, 30000);
})();

async function redeemCoupon() {
  const code = document.getElementById('couponCode').value.trim();
  if (!code) { VP.toast('Enter a coupon code', 'warning'); return; }
  try {
    const res = await VP.api('/billing/coupon/redeem', { method: 'POST', body: { code } });
    VP.toast('+' + res.result.amount + ' credits credited!', 'success');
    setTimeout(() => location.reload(), 800);
  } catch (e) { VP.toast(e.message, 'error'); }
}

async function renewPlan() {
  const ok = await VP.confirmDialog('Renew your plan now (extends from today) and clear any suspension?', { title: 'Renew Plan', okText: 'Renew', danger: false });
  if (!ok) return;
  try {
    const r = await VP.api('/billing/plan/renew', { method: 'POST', body: {} });
    VP.toast('Renewed — valid until ' + new Date(r.plan.expires_at).toLocaleDateString(), 'success');
    setTimeout(() => location.reload(), 700);
  } catch (e) { VP.toast(e.message, 'error'); }
}

async function loadInvoices() {
  const rows = document.getElementById('invRows');
  if (!rows) return;
  try {
    const res = await VP.api('/billing/invoices');
    const inv = res.invoices || [];
    if (!inv.length) { rows.innerHTML = '<tr><td colspan="5" class="muted">No invoices yet.</td></tr>'; return; }
    rows.innerHTML = inv.map((i) => {
      const paid = i.status === 'paid';
      return '<tr>'
        + '<td class="mono">#' + i.id + '</td>'
        + '<td class="text-sm">' + (i.description || '-') + '</td>'
        + '<td class="mono" style="font-weight:600">' + i.amount + ' ' + (i.currency || 'credits') + '</td>'
        + '<td>' + (paid ? '<span class="pill pill-green">paid</span>' : '<span class="pill pill-gray">pending</span>') + '</td>'
        + '<td class="text-sm muted">' + new Date(i.created_at).toLocaleString() + '</td>'
        + '</tr>';
    }).join('');
  } catch (e) { rows.innerHTML = '<tr><td colspan="5" class="muted">Failed to load invoices.</td></tr>'; }
}
loadInvoices();
</script>