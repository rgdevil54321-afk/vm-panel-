<%- include('../partials/head', { title: 'Dashboard' }) %>
<%- include('../partials/ambient') %>
<%- include('../partials/topbar') %>
<%- include('../partials/sidebar') %>
<div class="main">
  <div class="flex-between mb-4">
    <div>
      <h2 style="font-size:24px;font-weight:800;letter-spacing:-0.4px">Dashboard</h2>
      <div class="muted" style="margin-top:2px">Welcome back, <%= user.username %> · Overview of your virtual instances</div>
    </div>
    <% if (user && (user.role === 'admin' || user.root_admin)) { %>
      <a class="btn btn-primary" href="/admin/servers/create">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16"><path d="M12 5v14M5 12h14"/></svg>
        Create Virtual Machine
      </a>
    <% } %>
  </div>

  <!-- Hero Metrics -->
  <div class="grid grid-4 mb-4">
    <div class="stat">
      <div class="stat-icon" style="background:linear-gradient(135deg, rgba(99,102,241,0.18), rgba(99,102,241,0.06));color:#818cf8">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="2" width="20" height="8" rx="2"/><rect x="2" y="14" width="20" height="8" rx="2"/><path d="M6 6h.01M6 18h.01"/></svg>
      </div>
      <div>
        <div class="stat-value"><%= vms.length %></div>
        <div class="stat-label">Total Servers</div>
      </div>
    </div>

    <div class="stat">
      <div class="stat-icon" style="background:linear-gradient(135deg, rgba(16,185,129,0.18), rgba(16,185,129,0.06));color:#34d399">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M13 2 3 14h9l-1 8 10-12h-9l1-8z"/></svg>
      </div>
      <div>
        <div class="stat-value" style="color:#34d399"><%= running %></div>
        <div class="stat-label">Active &amp; Online</div>
      </div>
    </div>

    <div class="stat">
      <div class="stat-icon" style="background:linear-gradient(135deg, rgba(56,189,248,0.18), rgba(56,189,248,0.06));color:#38bdf8">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
      </div>
      <div>
        <div class="stat-value"><%= vms.reduce((a,v)=>a+v.cpus,0) %></div>
        <div class="stat-label">vCPU Cores</div>
      </div>
    </div>

    <div class="stat">
      <div class="stat-icon" style="background:linear-gradient(135deg, rgba(245,158,11,0.18), rgba(245,158,11,0.06));color:#fbbf24">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12a9 9 0 1 1-2.64-6.36M21 3v6h-6"/></svg>
      </div>
      <div>
        <div class="stat-value"><%= (vms.reduce((a,v)=>a+v.memory,0)/1024).toFixed(1) %> GB</div>
        <div class="stat-label">RAM Allocated</div>
      </div>
    </div>
  </div>

  <!-- Servers Table Card -->
  <div class="card">
    <div class="flex-between mb-3">
      <div class="card-title" style="margin:0">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18"><rect x="2" y="2" width="20" height="8" rx="2"/><rect x="2" y="14" width="20" height="8" rx="2"/><path d="M6 6h.01M6 18h.01"/></svg>
        Virtual Machines
      </div>
      <span class="muted text-sm"><%= vms.length %> instance<%= vms.length === 1 ? '' : 's' %> configured</span>
    </div>

    <% if (vms.length === 0) { %>
      <div class="empty">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="2" y="2" width="20" height="8" rx="2"/><rect x="2" y="14" width="20" height="8" rx="2"/><path d="M6 6h.01M6 18h.01"/></svg>
        <p style="font-weight:600;font-size:15px;color:var(--text);margin-bottom:4px">No servers deployed yet</p>
        <p class="muted">Deploy your first virtual machine to get started with instant cloud environments.</p>
        <% if (user && (user.role === 'admin' || user.root_admin)) { %>
          <div class="mt-3"><a href="/admin/servers/create" class="btn btn-primary">Deploy First Virtual Machine</a></div>
        <% } %>
      </div>
    <% } else { %>
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>Instance</th>
              <th>OS / Distro</th>
              <th>SSH &amp; Ports</th>
              <th>Specs (vCPU / RAM / Disk)</th>
              <th>Status</th>
              <th class="right">Management</th>
            </tr>
          </thead>
          <tbody>
          <% for (const v of vms) { %>
            <tr id="vm-row-<%= v.id %>">
              <td>
                <div class="flex" style="gap:10px">
                  <div style="width:34px;height:34px;border-radius:10px;background:var(--glass);display:grid;place-items:center;border:1px solid var(--border)">
                    <svg viewBox="0 0 24 24" fill="none" stroke="var(--accent-2)" stroke-width="2" width="18" height="18"><rect x="2" y="2" width="20" height="8" rx="2"/><rect x="2" y="14" width="20" height="8" rx="2"/><path d="M6 6h.01M6 18h.01"/></svg>
                  </div>
                  <div>
                    <a href="/servers/<%= v.id %>" style="font-weight:700;color:#fff;font-size:14px"><%= v.name %></a>
                    <div class="muted text-sm mono" style="font-size:11.5px"><%= v.username %>@<%= v.hostname || 'localhost' %></div>
                  </div>
                </div>
              </td>
              <td>
                <span class="pill pill-blue font-bold"><%= v.os_type || 'linux' %></span>
              </td>
              <td class="mono">
                <span style="color:var(--accent-2);font-weight:600">Port <%= v.ssh_port %></span>
                <div class="muted text-sm">ssh -p <%= v.ssh_port %> <%= v.username %>@localhost</div>
              </td>
              <td>
                <div style="font-weight:600"><%= v.cpus %> vCPU · <%= v.memory %> MB</div>
                <div class="muted text-sm"><%= v.disk_size %> Storage</div>
              </td>
              <td>
                <span class="pill <%= v.status === 'running' ? 'pill-green' : 'pill-gray' %>">
                  <%= v.status %>
                </span>
              </td>
              <td class="right">
                <div class="flex right" style="gap:6px">
                  <a class="btn btn-sm" href="/servers/<%= v.id %>/console" title="Open Web Terminal">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="13" height="13"><path d="M4 17l6-5-6-5M12 19h8"/></svg>
                    Terminal
                  </a>
                  <a class="btn btn-sm" href="/servers/<%= v.id %>/files" title="Open File Manager">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="13" height="13"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/></svg>
                  </a>
                  <% if (v.status === 'running') { %>
                    <button class="btn btn-sm btn-danger" onclick="power(<%= v.id %>,'stop')" title="Stop VM">Stop</button>
                    <button class="btn btn-sm" onclick="power(<%= v.id %>,'restart')" title="Restart VM">Restart</button>
                  <% } else { %>
                    <button class="btn btn-sm btn-green" onclick="power(<%= v.id %>,'start')" title="Start VM">Start</button>
                  <% } %>
                  <a class="btn btn-sm btn-primary" href="/servers/<%= v.id %>">Manage</a>
                </div>
              </td>
            </tr>
          <% } %>
          </tbody>
        </table>
      </div>
    <% } %>
  </div>

  <% if (subVms && subVms.length > 0) { %>
  <div class="card mt-4">
    <div class="card-title">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2M9 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8zM23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/></svg>
      Shared Virtual Machines
    </div>
    <div class="table-wrap">
      <table>
        <thead><tr><th>Server</th><th>Owner</th><th>Status</th><th class="right">Action</th></tr></thead>
        <tbody>
        <% for (const v of subVms) { %>
          <tr>
            <td><a href="/servers/<%= v.id %>" style="font-weight:700;color:var(--text)"><%= v.name %></a></td>
            <td><span class="muted"><%= v.owner_name %></span></td>
            <td><span class="pill <%= v.status === 'running' ? 'pill-green' : 'pill-gray' %>"><%= v.status %></span></td>
            <td class="right"><a class="btn btn-sm btn-primary" href="/servers/<%= v.id %>">Open Server</a></td>
          </tr>
        <% } %>
        </tbody>
      </table>
    </div>
  </div>
  <% } %>

  <!-- Recent Activity Feed -->
  <div class="card mt-4">
    <div class="card-title">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18"><path d="M12 8v4l3 3M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20z"/></svg>
      Recent Activity
    </div>
    <% if (recentActivity.length === 0) { %>
      <div class="empty" style="padding:28px"><p class="muted">No activity logged yet.</p></div>
    <% } else { %>
      <div class="table-wrap">
        <table>
          <thead><tr><th>Event</th><th>Details</th><th>Timestamp</th></tr></thead>
          <tbody>
          <% for (const a of recentActivity.slice(0, 8)) { %>
            <tr>
              <td>
                <span class="pill pill-blue mono font-bold"><%= a.event %></span>
              </td>
              <td class="muted mono text-sm truncate" style="max-width:380px">
                <%= a.details ? JSON.stringify(a.details) : '—' %>
              </td>
              <td class="muted text-sm"><%= new Date(a.created_at).toLocaleString() %></td>
            </tr>
          <% } %>
          </tbody>
        </table>
      </div>
    <% } %>
  </div>
</div>
<%- include('../partials/music') %>
<%- include('../partials/foot') %>

<script>
async function power(id, action) {
  try {
    VP.toast(`Sending ${action} command...`, 'info');
    await VP.api(`/servers/${id}/power`, { method: 'POST', body: { action } });
    VP.toast(`Server ${action} successful`, 'success');
    setTimeout(() => location.reload(), 600);
  } catch (e) {
    VP.toast(e.message, 'error');
  }
}

document.getElementById('globalSearch')?.addEventListener('input', function () {
  const q = this.value.toLowerCase().trim();
  document.querySelectorAll('tbody tr').forEach((tr) => {
    tr.style.display = tr.textContent.toLowerCase().includes(q) ? '' : 'none';
  });
});
</script>
