<%- include('../../partials/head', { title: vm.name + ' - Activity' }) %>
<%- include('../../partials/ambient') %>
<%- include('../../partials/topbar') %>
<%- include('../../partials/sidebar') %>
<div class="main">
  <div class="flex-between mb-3">
    <h2 style="font-size:22px">Activity · <%= vm.name %></h2>
    <a class="btn btn-sm" href="/servers/<%= vm.id %>">Back</a>
  </div>
  <%- include('_tabs') %>

  <div class="card">
    <% if (logs.length === 0) { %><div class="empty"><p>No activity recorded for this server.</p></div><% } else { %>
    <div class="table-wrap">
      <table>
        <thead><tr><th>Event</th><th>User</th><th>Details</th><th>IP</th><th>When</th></tr></thead>
        <tbody>
        <% for (const a of logs) { %>
          <tr>
            <td><span class="pill pill-blue"><%= a.event %></span></td>
            <td><%= a.username || 'System' %></td>
            <td class="muted truncate" style="max-width:320px"><%= a.details ? JSON.stringify(a.details) : '-' %></td>
            <td class="muted"><%= a.ip || '-' %></td>
            <td class="muted"><%= new Date(a.created_at).toLocaleString() %></td>
          </tr>
        <% } %>
        </tbody>
      </table>
    </div>
    <% } %>
  </div>
</div>
<%- include('../../partials/music') %>
<%- include('../../partials/foot') %>
