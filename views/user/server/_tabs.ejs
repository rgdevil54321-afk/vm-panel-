<%
const tabs = [
  ['overview', 'Overview', '/servers/' + vm.id],
  ['console', 'Terminal', '/servers/' + vm.id + '/console'],
  ['files', 'File Manager', '/servers/' + vm.id + '/files'],
  ['backups', 'Backups', '/servers/' + vm.id + '/backups'],
  ['schedules', 'Schedules', '/servers/' + vm.id + '/schedules'],
  ['startup', 'Startup', '/servers/' + vm.id + '/startup'],
  ['settings', 'Settings', '/servers/' + vm.id + '/settings'],
  ['subusers', 'Subusers', '/servers/' + vm.id + '/subusers'],
  ['activity', 'Activity', '/servers/' + vm.id + '/activity'],
];
%>
<div class="tabs">
  <% for (const [key, label, href] of tabs) { %>
    <a class="tab <%= key === page ? 'active' : '' %>" href="<%= href %>"><%= label %></a>
  <% } %>
</div>
