<%- include('../../partials/head', { title: vm.name + ' - Terminal & Boot Logs', styles: ['/vendor/xterm.min.css'], scripts: ['/socket.io/socket.io.js', '/vendor/xterm.min.js', '/vendor/addon-fit.min.js'] }) %>
<%- include('../../partials/ambient') %>
<%- include('../../partials/topbar') %>
<%- include('../../partials/sidebar') %>

<style>
.pulse-dot {
  display: inline-block;
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: #22c55e;
  margin-right: 6px;
  box-shadow: 0 0 8px rgba(34, 197, 94, 0.8);
  animation: pulse-live 1.5s infinite ease-in-out;
}
@keyframes pulse-live {
  0% { transform: scale(0.9); opacity: 0.7; }
  50% { transform: scale(1.3); opacity: 1; box-shadow: 0 0 12px rgba(34, 197, 94, 1); }
  100% { transform: scale(0.9); opacity: 0.7; }
}
.console-tabs {
  display: flex;
  gap: 8px;
  border-bottom: 1px solid var(--border);
  padding-bottom: 10px;
}
.console-tab {
  background: rgba(15, 23, 42, 0.6);
  border: 1px solid var(--border);
  color: var(--text-muted);
  padding: 8px 16px;
  border-radius: var(--radius-sm);
  font-size: 13px;
  font-weight: 600;
  cursor: pointer;
  display: inline-flex;
  align-items: center;
  transition: all 0.2s ease;
}
.console-tab:hover {
  background: rgba(30, 41, 59, 0.8);
  color: #fff;
  border-color: var(--border-hover);
}
.console-tab.active {
  background: var(--accent);
  color: #fff;
  border-color: var(--accent-light);
  box-shadow: 0 0 14px var(--accent-glow);
}
.log-search-input {
  background: #060913;
  border: 1px solid var(--border);
  color: #f8fafc;
  padding: 5px 10px;
  border-radius: 6px;
  font-size: 12px;
  width: 170px;
  outline: none;
  transition: border-color 0.15s ease;
}
.log-search-input:focus {
  border-color: var(--accent-2);
}

/* Session tabs inside the terminal pane */
.session-tabs {
  display: flex;
  gap: 6px;
  align-items: center;
  flex-wrap: wrap;
  margin-bottom: 12px;
}
.session-tab {
  display: inline-flex;
  align-items: center;
  gap: 7px;
  background: rgba(15, 23, 42, 0.6);
  border: 1px solid var(--border);
  border-radius: 8px;
  padding: 5px 9px 5px 12px;
  font-size: 12px;
  font-weight: 600;
  color: var(--text-muted);
  cursor: pointer;
  transition: all 0.15s ease;
}
.session-tab:hover { color: #fff; border-color: var(--border-hover); }
.session-tab.active {
  background: var(--accent);
  color: #fff;
  border-color: var(--accent-light);
  box-shadow: 0 0 12px var(--accent-glow);
}
.session-tab.closed { opacity: 0.55; text-decoration: line-through; }
.session-tab .session-close {
  width: 16px; height: 16px;
  display: inline-flex; align-items: center; justify-content: center;
  border-radius: 4px;
  font-size: 11px;
  line-height: 1;
  color: var(--text-muted);
}
.session-tab .session-close:hover { background: rgba(248,113,113,0.2); color: #f87171; }
.btn-add-term {
  background: transparent;
  border: 1px dashed var(--border-hover);
  color: var(--text-muted);
  width: 30px; height: 28px;
  border-radius: 8px;
  font-size: 16px;
  font-weight: 700;
  cursor: pointer;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  transition: all 0.15s ease;
}
.btn-add-term:hover { color: #fff; border-color: var(--accent-2); border-style: solid; background: rgba(56,189,248,0.1); }

/* Resizable Terminal Wrapper & 4-Corner Handles */
.terminal-wrapper {
  position: relative;
  min-height: 360px;
  min-width: 380px;
  height: calc(100vh - 350px);
  width: 100%;
  background: #060913;
  border-radius: 12px;
  border: 1px solid var(--border);
  overflow: hidden;
  box-shadow: 0 4px 20px rgba(0,0,0,0.3);
  transition: border-color 0.2s ease, box-shadow 0.2s ease;
}
.terminal-wrapper.is-resizing {
  user-select: none;
  border-color: var(--accent-2) !important;
  box-shadow: 0 0 24px rgba(56, 189, 248, 0.3) !important;
}
.terminal-wrapper .terminal {
  width: 100%;
  height: 100%;
  padding: 8px;
  box-sizing: border-box;
}
.term-pane {
  display: none;
}
.term-pane.show { display: block; }

/* 4 Corner Resize Handles */
.resize-handle {
  position: absolute;
  z-index: 60;
  opacity: 0.5;
  transition: opacity 0.2s, transform 0.15s ease;
}
.resize-handle:hover, .terminal-wrapper.is-resizing .resize-handle {
  opacity: 1;
}

/* Top-Left Corner */
.rh-tl {
  left: 3px;
  top: 3px;
  width: 14px;
  height: 14px;
  cursor: nwse-resize;
  border-left: 2px solid var(--accent-2);
  border-top: 2px solid var(--accent-2);
  border-top-left-radius: 4px;
}
/* Top-Right Corner */
.rh-tr {
  right: 3px;
  top: 3px;
  width: 14px;
  height: 14px;
  cursor: nesw-resize;
  border-right: 2px solid var(--accent-2);
  border-top: 2px solid var(--accent-2);
  border-top-right-radius: 4px;
}
/* Bottom-Left Corner */
.rh-bl {
  left: 3px;
  bottom: 3px;
  width: 14px;
  height: 14px;
  cursor: nesw-resize;
  border-left: 2px solid var(--accent-2);
  border-bottom: 2px solid var(--accent-2);
  border-bottom-left-radius: 4px;
}
/* Bottom-Right Corner (Grip Accent) */
.rh-br {
  right: 3px;
  bottom: 3px;
  width: 16px;
  height: 16px;
  cursor: nwse-resize;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--accent-2);
  border-right: 2px solid var(--accent-2);
  border-bottom: 2px solid var(--accent-2);
  border-bottom-right-radius: 4px;
}
/* Bottom Edge Bar */
.rh-b {
  bottom: 0;
  left: 20px;
  right: 20px;
  height: 6px;
  cursor: ns-resize;
}
.rh-b:hover {
  background: rgba(56, 189, 248, 0.3);
}

.fullscreen-pane {
  position: fixed !important;
  left: 0 !important;
  top: 0 !important;
  width: 100% !important;
  max-width: 100% !important;
  height: 100% !important;
  max-height: 100% !important;
  margin: 0 !important;
  z-index: 99999 !important;
  border-radius: 0 !important;
  background: #060913 !important;
  box-sizing: border-box !important;
  display: flex !important;
  flex-direction: column !important;
  gap: 10px !important;
  padding: 14px 18px 18px !important;
  overflow: hidden !important;
}
.fullscreen-pane .terminal-wrapper {
  flex: 1 1 auto !important;
  min-width: 0 !important;
  min-height: 0 !important;
  width: 100% !important;
  height: auto !important;
}
.fullscreen-pane #termPanes {
  flex: 1 1 auto !important;
  min-height: 0 !important;
  display: flex !important;
  flex-direction: column !important;
}
.fullscreen-pane .term-pane.show {
  flex: 1 1 auto !important;
  min-height: 0 !important;
}
body.term-fullscreen { overflow: hidden !important; }
body.term-fullscreen .sidebar,
body.term-fullscreen .topbar,
body.term-fullscreen .vx-discord-fab,
body.term-fullscreen .vx-watermark,
body.term-fullscreen #bgLayer,
body.term-fullscreen #bgOverlay {
  display: none !important;
}
</style>

<div class="main">
  <div class="flex-between mb-3">
    <div>
      <div class="muted text-sm" style="margin-bottom:2px">
        <a href="/servers/<%= vm.id %>" style="color:var(--text-dim)"><%= vm.name %></a> / Terminal &amp; Boot Logs
      </div>
      <h2 style="font-size:22px;font-weight:800;letter-spacing:-0.3px;display:flex;align-items:center;gap:10px">
        <%= vm.name %>
        <span id="headerStatusPill" class="pill <%= vm.status === 'running' ? 'pill-green' : 'pill-gray' %>"><%= vm.status %></span>
      </h2>
    </div>
    <div class="flex" style="gap:8px">
      <a class="btn btn-sm" href="/servers/<%= vm.id %>">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
        Back to overview
      </a>
    </div>
  </div>
  <%- include('_tabs') %>

  <div class="console-tabs" style="margin-bottom:14px">
    <button class="console-tab active" id="tabTerminal" onclick="switchView('terminal')">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14" style="vertical-align:-2px;margin-right:6px"><path d="M4 17l6-5-6-5M12 19h8"/></svg>
      SSH Terminal
    </button>
    <button class="console-tab" id="tabBootLog" onclick="switchView('bootlog')">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14" style="vertical-align:-2px;margin-right:6px"><path d="M13 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9z"/><polyline points="13 2 13 9 20 9"/></svg>
      Live Boot Logs
      <span class="pulse-dot" style="margin-left:6px;margin-right:0"></span>
    </button>
    <button class="console-tab" id="tabVnc" onclick="switchView('vnc')">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14" style="vertical-align:-2px;margin-right:6px"><rect x="2" y="3" width="20" height="14" rx="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>
      Graphical (VNC)
    </button>
  </div>

  <!-- SSH Terminal Pane (multi-session) -->
  <div id="paneTerminal" class="card" style="padding:16px">
    <div id="sshBootBanner" style="display:none;background:rgba(56,189,248,0.1);border:1px solid rgba(56,189,248,0.25);border-radius:10px;padding:10px 14px;margin-bottom:12px;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:10px">
      <div class="flex" style="gap:8px;align-items:center">
        <svg viewBox="0 0 24 24" fill="none" stroke="#38bdf8" stroke-width="2" width="18" height="18"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 14 14"/></svg>
        <span style="font-size:13px;color:#e2e8f0">Server is offline or initializing SSH. You can monitor the startup sequence live!</span>
      </div>
      <button class="btn btn-sm btn-primary" onclick="switchView('bootlog')">
        <span class="pulse-dot"></span> View Live Boot Logs
      </button>
    </div>

    <div class="flex-between" style="margin-bottom:12px;flex-wrap:wrap;gap:8px">
      <div class="session-tabs" id="sessionTabs"></div>
      <button class="btn-add-term" id="btnNewTerm" onclick="newTerminal()" title="Open a new terminal session">+</button>
    </div>

    <div class="console-toolbar flex-between" style="margin-bottom:12px;flex-wrap:wrap;gap:8px">
      <div class="flex" style="gap:8px;align-items:center;flex-wrap:wrap">
        <span id="connState" class="pill pill-yellow">connecting...</span>
        <button class="btn btn-sm" id="btnReconnect" onclick="reconnectActive()">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14"><path d="M23 4v6h-6M1 20v-6h6M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"/></svg>
          Reconnect
        </button>
        <button class="btn btn-sm" onclick="clearActiveTerm()">Clear</button>
        <button class="btn btn-sm" onclick="sendCtrlC()" title="Send Interrupt Signal (Ctrl+C)">Ctrl+C</button>
        <button class="btn btn-sm" onclick="sendCtrlD()" title="Send EOF (Ctrl+D)">Ctrl+D</button>
      </div>

      <div class="flex" style="gap:8px;align-items:center;flex-wrap:wrap">
        <span id="termSizeBadge" class="mono muted text-sm" style="font-size:11.5px">Auto Size</span>
        <button class="btn btn-sm" id="btnTermAutoSize" onclick="resetActiveToAutoSize()" title="Reset to default responsive Auto Size">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14"><path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7"/></svg>
          Auto Size
        </button>
        <button class="btn btn-sm" onclick="fitActiveTerm()">Fit</button>
        <button class="btn btn-sm" onclick="toggleFullscreen('paneTerminal')" title="Toggle Full Screen">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14"><path d="M8 3H5a2 2 0 0 0-2 2v3m18 0V5a2 2 0 0 0-2-2h-3m0 18h3a2 2 0 0 0 2-2v-3M3 16v3a2 2 0 0 0 2 2h3"/></svg>
          Full
        </button>
      </div>
    </div>

    <div id="termPanes"></div>
  </div>

  <!-- Live Boot Logs Pane -->
  <div id="paneBootLog" class="card" style="padding:16px;display:none">
    <div class="console-toolbar flex-between" style="margin-bottom:12px;flex-wrap:wrap;gap:10px">
      <div class="flex" style="gap:8px;align-items:center;flex-wrap:wrap">
        <span id="bootState" class="pill pill-green"><span class="pulse-dot"></span> Live Streaming</span>
        <% if (vm.status !== 'running') { %>
          <button class="btn btn-sm btn-green" id="btnStartFromBoot" onclick="startAndStream()">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14"><polygon points="5 3 19 12 5 21 5 3"/></svg>
            Start &amp; Stream Boot
          </button>
        <% } %>
        <button class="btn btn-sm" id="btnToggleScroll" onclick="toggleAutoScroll()">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14"><line x1="12" y1="5" x2="12" y2="19"/><polyline points="19 12 12 19 5 12"/></svg>
          <span id="autoScrollLabel">Auto-Scroll: ON</span>
        </button>
        <button class="btn btn-sm" id="btnToggleView" onclick="toggleViewMode()">
          <span id="viewModeLabel">Raw View</span>
        </button>
        <button class="btn btn-sm" onclick="clearBootDisplay()">Clear Display</button>
        <button class="btn btn-sm" onclick="clearBootServerLog()" title="Clear log file on server">Clear File</button>
        <button class="btn btn-sm" onclick="aiDiagnoseBoot()" title="Analyze the boot log for common failure causes" style="border-color:color-mix(in srgb, var(--accent) 60%, transparent)">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14" style="vertical-align:-2px;margin-right:5px"><path d="M9.5 2A2.5 2.5 0 0 1 12 4.5v9a2.5 2.5 0 0 1-5 0v-9A2.5 2.5 0 0 1 9.5 2z"/><path d="M6 10a3.5 3.5 0 0 1-2.5-5.5A3.5 3.5 0 0 0 6 8.5M13 11.5a3.5 3.5 0 0 1 2.5-5.5A3.5 3.5 0 0 0 13 11z"/></svg>
          AI Diagnose
        </button>
      </div>
      <div class="flex" style="gap:8px;align-items:center;flex-wrap:wrap">
        <input type="text" id="logSearch" class="log-search-input" placeholder="Filter boot logs..." oninput="onSearchInput(this.value)" />
        <button class="btn btn-sm" onclick="copyBootLog()">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
          Copy
        </button>
        <button class="btn btn-sm" onclick="downloadBootLog()">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
          Download
        </button>
        <button class="btn btn-sm" id="btnBootAutoSize" onclick="resetToAutoSize('bootTermWrapper')" title="Reset to default responsive Auto Size">
          Auto Size
        </button>
        <button class="btn btn-sm" onclick="fitBootTerm()">Fit</button>
        <button class="btn btn-sm" onclick="toggleFullscreen('paneBootLog')" title="Toggle Full Screen">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14"><path d="M8 3H5a2 2 0 0 0-2 2v3m18 0V5a2 2 0 0 0-2-2h-3m0 18h3a2 2 0 0 0 2-2v-3M3 16v3a2 2 0 0 0 2 2h3"/></svg>
          Full
        </button>
      </div>
    </div>

    <!-- 4-Corner Resizable Wrapper for Live Boot Terminal -->
    <div class="terminal-wrapper" id="bootTermWrapper">
      <div id="bootTerminal" class="terminal"></div>
      <pre id="bootRawContent" style="display:none;width:100%;height:100%;background:#060913;color:#38bdf8;padding:16px;box-sizing:border-box;font-family:JetBrains Mono, Menlo, Monaco, Consolas, monospace;font-size:13px;line-height:1.45;overflow:auto;white-space:pre-wrap;word-break:break-all;margin:0"></pre>

      <!-- 4 Corner Mouse Drag Handles -->
      <div class="resize-handle rh-tl" data-target="bootTermWrapper" data-dir="tl" title="Drag to resize (Top-Left)"></div>
      <div class="resize-handle rh-tr" data-target="bootTermWrapper" data-dir="tr" title="Drag to resize (Top-Right)"></div>
      <div class="resize-handle rh-bl" data-target="bootTermWrapper" data-dir="bl" title="Drag to resize (Bottom-Left)"></div>
      <div class="resize-handle rh-br" data-target="bootTermWrapper" data-dir="br" title="Drag to resize (Bottom-Right)"></div>
      <div class="resize-handle rh-b" data-target="bootTermWrapper" data-dir="b" title="Drag to resize height (Bottom)"></div>
    </div>
  </div>

  <!-- Graphical (noVNC) Pane -->
  <div id="paneVnc" class="card" style="padding:16px;display:none">
    <div class="console-toolbar flex-between" style="margin-bottom:12px;flex-wrap:wrap;gap:10px">
      <div class="flex" style="gap:8px;align-items:center;flex-wrap:wrap">
        <span id="vncState" class="pill pill-gray">not connected</span>
        <% if (vm.vnc_port) { %>
          <span class="muted text-sm mono" style="font-size:11px">VNC port: <%= vm.vnc_port %></span>
        <% } %>
      </div>
      <div class="flex" style="gap:8px;align-items:center;flex-wrap:wrap">
        <button class="btn btn-sm" onclick="vncConnect()">Connect</button>
        <button class="btn btn-sm" onclick="vncDisconnect()">Disconnect</button>
        <button class="btn btn-sm btn-primary" onclick="toggleFullscreen('paneVnc')">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14"><path d="M8 3H5a2 2 0 0 0-2 2v3m18 0V5a2 2 0 0 0-2-2h-3m0 18h3a2 2 0 0 0 2-2v-3M3 16v3a2 2 0 0 0 2 2h3"/></svg>
          Full
        </button>
      </div>
    </div>
    <div id="vncScreenWrap" style="width:100%;height:calc(100vh - 350px);min-height:380px;background:#060913;border-radius:12px;border:1px solid var(--border);overflow:hidden;position:relative">
      <div id="vncStatusMsg" style="position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:10px;color:var(--text-muted);text-align:center;padding:20px">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="40" height="40"><rect x="2" y="3" width="20" height="14" rx="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>
        <span>Graphical console.<br/>Start the server, then click Connect. Requires VNC support and a display configured on the hypervisor.</span>
      </div>
      <canvas id="vncScreen" style="display:none;width:100%;height:100%"></canvas>
    </div>
  </div>
</div>

<%- include('../../partials/music') %>
<%- include('../../partials/foot') %>

<script>
(function () {
  const VM_ID = <%= vm.id %>;
  const isVmRunning = <%= vm.status === 'running' ? 'true' : 'false' %>;
  const bootTermEl = document.getElementById('bootTerminal');
  const rawBootEl = document.getElementById('bootRawContent');
  const stateEl = document.getElementById('connState');
  const bootStateEl = document.getElementById('bootState');
  const sshBootBanner = document.getElementById('sshBootBanner');
  const termSizeBadge = document.getElementById('termSizeBadge');
  const sessionTabsEl = document.getElementById('sessionTabs');
  const termPanesEl = document.getElementById('termPanes');

  // ---------- Session state: multiple terminals per VM ----------
  const terms = new Map();   // sessionId -> { term, fit, wrapper, tab, closed }
  const sessionState = new Map(); // sessionId -> { text, cls }
  let activeSid = null;

  // Live "connecting…" countdown (deadline is an absolute epoch-ms from the server)
  let waitTimer = null;
  let waitDeadline = 0;
  let waitReason = '';

  let bootTerm, bootFit;
  let socket = null;
  let connected = false;
  let activeTab = 'terminal';
  let bootStreaming = false;
  let autoScroll = true;
  let rawView = false;
  let rawBootBuffer = '';
  let sseSource = null;

  const termTheme = {
    background: '#060913',
    foreground: '#e2e8f0',
    cursor: '#38bdf8',
    cursorAccent: '#060913',
    selectionBackground: 'rgba(56, 189, 248, 0.3)',
    black: '#1e293b',
    red: '#f87171',
    green: '#4ade80',
    yellow: '#facc15',
    blue: '#60a5fa',
    magenta: '#c084fc',
    cyan: '#38bdf8',
    white: '#f8fafc',
    brightBlack: '#475569',
    brightRed: '#ef4444',
    brightGreen: '#22c55e',
    brightYellow: '#eab308',
    brightBlue: '#3b82f6',
    brightMagenta: '#a855f7',
    brightCyan: '#06b6d4',
    brightWhite: '#ffffff'
  };

  const HANDLES_HTML =
    '<div class="resize-handle rh-tl" data-target="{WRAP}" data-dir="tl" title="Drag to resize (Top-Left)"></div>' +
    '<div class="resize-handle rh-tr" data-target="{WRAP}" data-dir="tr" title="Drag to resize (Top-Right)"></div>' +
    '<div class="resize-handle rh-bl" data-target="{WRAP}" data-dir="bl" title="Drag to resize (Bottom-Left)"></div>' +
    '<div class="resize-handle rh-br" data-target="{WRAP}" data-dir="br" title="Drag to resize (Bottom-Right)"></div>' +
    '<div class="resize-handle rh-b" data-target="{WRAP}" data-dir="b" title="Drag to resize height (Bottom)"></div>';

  function newSid() {
    return 't' + Date.now().toString(36) + Math.random().toString(36).slice(2, 7);
  }

  function setState(text, cls, banner) {
    if (stateEl) {
      stateEl.textContent = text;
      stateEl.className = 'pill ' + (cls || 'pill-yellow');
    }
    if (sshBootBanner) {
      if (banner === true || (cls === 'pill-red' && text.includes('failed'))) {
        sshBootBanner.style.display = 'flex';
      } else if (banner === false || cls === 'pill-green') {
        sshBootBanner.style.display = 'none';
      }
    }
  }

  function setSessionState(sid, text, cls, banner) {
    sessionState.set(sid, { text, cls });
    if (sid === activeSid) setState(text, cls, banner);
  }

  function fmtWait(ms) {
    const s = Math.max(0, Math.ceil(ms / 1000));
    if (s >= 60) return Math.floor(s / 60) + 'm ' + String(s % 60).padStart(2, '0') + 's';
    return s + 's';
  }

  function clearWaitTimer() {
    if (waitTimer) { clearInterval(waitTimer); waitTimer = null; }
    waitDeadline = 0;
    waitReason = '';
  }

  function renderWait() {
    if (activeTab !== 'terminal') return;
    const left = waitDeadline - Date.now();
    const reason = waitReason ? ' · ' + waitReason : '';
    if (left <= 0) {
      clearWaitTimer();
      const txt = 'connection failed' + reason;
      setState(txt, 'pill-red', true);
      if (activeSid) setSessionState(activeSid, txt, 'pill-red', true);
      return;
    }
    const txt = 'connecting… ' + fmtWait(left) + reason;
    setState(txt, 'pill-yellow', true);
    if (activeSid) setSessionState(activeSid, txt, 'pill-yellow', true);
  }

  function startWaitTimer(deadline, reason) {
    if (deadline) waitDeadline = deadline;
    if (!waitDeadline) waitDeadline = Date.now() + 180000;
    if (reason) waitReason = reason;
    if (waitTimer) { renderWait(); return; }
    renderWait();
    waitTimer = setInterval(renderWait, 1000);
  }

  function updateSizeBadge(term, isCustom) {
    if (!termSizeBadge || !term) return;
    if (isCustom) {
      termSizeBadge.textContent = 'Custom (' + term.cols + '×' + term.rows + ')';
      termSizeBadge.style.color = 'var(--accent-2)';
    } else {
      termSizeBadge.textContent = 'Auto (' + term.cols + '×' + term.rows + ')';
      termSizeBadge.style.color = 'var(--text-dim)';
    }
  }

  function createTerminalPane(sid) {
    if (terms.has(sid)) return terms.get(sid);
    const idx = terms.size + 1;

    // tab button
    const tab = document.createElement('button');
    tab.className = 'session-tab';
    tab.id = 'seesion-tab-' + sid;
    tab.innerHTML = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="12" height="12"><path d="M4 17l6-5-6-5M12 19h8"/></svg><span>Terminal ' + idx + '</span><span class="session-close" title="Close this session">✕</span>';
    tab.addEventListener('click', (e) => {
      if (e.target.classList.contains('session-close')) { killSession(sid); return; }
      activateSession(sid);
    });
    sessionTabsEl.appendChild(tab);

    // wrapper + terminal
    const wrapId = 'tw-' + sid;
    const wrapper = document.createElement('div');
    wrapper.className = 'terminal-wrapper term-pane';
    wrapper.id = wrapId;
    const termDiv = document.createElement('div');
    termDiv.className = 'terminal';
    wrapper.appendChild(termDiv);
    wrapper.insertAdjacentHTML('beforeend', HANDLES_HTML.split('{WRAP}').join(wrapId));
    termPanesEl.appendChild(wrapper);

    const term = new Terminal({
      cursorBlink: true,
      cursorStyle: 'block',
      fontSize: 14,
      fontFamily: 'JetBrains Mono, Menlo, Monaco, Consolas, "Courier New", monospace',
      letterSpacing: 0,
      lineHeight: 1.2,
      theme: termTheme,
      scrollback: 10000,
      convertEol: true,
    });
    const fit = new FitAddon.FitAddon();
    term.loadAddon(fit);
    term.open(termDiv);
    setTimeout(() => { try { fit.fit(); } catch (_) {} }, 100);

    term.onData((data) => {
      if (connected && socket) socket.emit('console:input', { sessionId: sid, data });
    });
    term.onResize(({ cols, rows }) => {
      if (connected && socket) socket.emit('console:resize', { sessionId: sid, cols, rows });
    });

    const entry = { term, fit, wrapper, tab, closed: false };
    terms.set(sid, entry);
    return entry;
  }

  function activateSession(sid) {
    const entry = createTerminalPane(sid);
    activeSid = sid;
    for (const [id, t] of terms) {
      t.wrapper.classList.toggle('show', id === sid);
      t.tab.classList.toggle('active', id === sid);
    }
    const st = sessionState.get(sid) || { text: 'connecting...', cls: 'pill-yellow' };
    setState(st.text, st.cls, st.cls === 'pill-green' ? false : undefined);
    setTimeout(() => {
      try { entry.fit.fit(); sendResize(sid); updateSizeBadge(entry.term, false); } catch (_) {}
      entry.term.focus();
    }, 80);
  }

  function removeSession(sid) {
    const entry = terms.get(sid);
    if (!entry) return;
    try { entry.term.dispose(); } catch (_) {}
    entry.wrapper.remove();
    entry.tab.remove();
    terms.delete(sid);
    sessionState.delete(sid);
  }

  window.killSession = function (sid) {
    if (socket && connected) socket.emit('console:kill', { sessionId: sid });
    removeSession(sid);
    if (activeSid === sid) {
      activeSid = null;
      const first = terms.keys().next();
      if (!first.done) activateSession(first.value);
      else {
        setState('offline', 'pill-gray');
        if (isVmRunning) window.newTerminal();
      }
    }
  };

  window.newTerminal = function () {
    const sid = newSid();
    createTerminalPane(sid);
    activateSession(sid);
    joinSession(sid, false);
  };

  window.reconnectActive = function () {
    if (activeSid) joinSession(activeSid, true);
    else if (isVmRunning) window.newTerminal();
    else setState('offline', 'pill-gray');
  };

  function joinSession(sid, reattach) {
    if (!terms.has(sid)) createTerminalPane(sid);
    if (!socket || !connected) {
      setupSocket();
      setTimeout(() => { if (socket && connected) doJoin(sid, reattach); else setTimeout(() => doJoinWhenReady(sid, reattach), 2500); }, 300);
      return;
    }
    doJoin(sid, reattach);
  }

  function doJoinWhenReady(sid, reattach) {
    if (connected && socket) doJoin(sid, reattach);
  }

  function doJoin(sid, reattach) {
    clearWaitTimer();
    setSessionState(sid, 'connecting...', 'pill-yellow');
    socket.emit('console:join', { vmId: VM_ID, terminalId: sid, reattach: !!reattach });
  }

  function sendResize(sid) {
    const entry = terms.get(sid);
    if (entry && socket && connected) {
      socket.emit('console:resize', { sessionId: sid, cols: entry.term.cols, rows: entry.term.rows });
    }
  }

  function markSessionClosed(sid, reason) {
    const entry = terms.get(sid);
    if (!entry) return;
    entry.closed = true;
    entry.tab.classList.add('closed');
    entry.term.writeln('\r\n\x1b[33m[Session closed' + (reason === 'server-stopped' ? ' — server stopped' : '') + '. Click Reconnect to start a new one.]\x1b[0m\r\n');
    setSessionState(sid, 'closed', 'pill-gray', true);
  }

  // ---------- Boot terminal (unchanged behavior) ----------
  function initBootTerm() {
    if (bootTerm) { bootTerm.dispose(); bootTerm = null; }
    bootTerm = new Terminal({
      cursorBlink: false,
      disableStdin: true,
      fontSize: 13,
      fontFamily: 'JetBrains Mono, Menlo, Monaco, Consolas, "Courier New", monospace',
      letterSpacing: 0,
      lineHeight: 1.3,
      theme: termTheme,
      scrollback: 20000,
      convertEol: true,
    });
    bootFit = new FitAddon.FitAddon();
    bootTerm.loadAddon(bootFit);
    bootTerm.open(bootTermEl);
    setTimeout(() => { try { bootFit.fit(); } catch (_) {} }, 100);
  }

  function setBootState(text, cls, showPulse = true) {
    if (bootStateEl) {
      bootStateEl.innerHTML = (showPulse ? '<span class="pulse-dot"></span> ' : '') + text;
      bootStateEl.className = 'pill ' + (cls || 'pill-blue');
    }
  }

  // ---------- Socket setup ----------
  function setupSocket() {
    if (socket) return;
    socket = io({
      transports: ['websocket', 'polling'],
      auth: { token: vpToken() },
      reconnection: true,
      reconnectionDelay: 2000,
    });

    socket.on('connect', () => {
      connected = true;
      if (activeTab === 'terminal') {
        if (isVmRunning) {
          if (terms.size === 0) window.newTerminal();
          else {
            // re-join all existing tabs after a socket reconnect (lossless via replay)
            for (const sid of Array.from(terms.keys())) doJoin(sid, true);
          }
        } else {
          setState('offline', 'pill-gray');
        }
      } else if (activeTab === 'bootlog') {
        joinBootLog();
      }
    });

    socket.on('console:buffer', ({ sessionId, text }) => {
      const entry = createTerminalPane(sessionId);
      try { entry.term.clear(); entry.term.write(text || ''); } catch (_) {}
    });

    socket.on('console:ready', ({ sessionId, replayed }) => {
      clearWaitTimer();
      const entry = createTerminalPane(sessionId);
      if (activeSid === null) activateSession(sessionId);
      entry.closed = false;
      if (!replayed) { try { entry.term.clear(); } catch (_) {} }
      setSessionState(sessionId, 'streaming', 'pill-green', false);
      try { entry.fit.fit(); sendResize(sessionId); updateSizeBadge(entry.term, false); } catch (_) {}
      if (activeSid === sessionId) entry.term.focus();
    });

    socket.on('console:data', ({ sessionId, text }) => {
      const entry = terms.get(sessionId);
      if (entry) entry.term.write(text);
    });

    socket.on('console:close', ({ sessionId, reason }) => {
      markSessionClosed(sessionId, reason);
    });

    socket.on('console:offline', () => {
      clearWaitTimer();
      if (activeTab === 'terminal') {
        setState('offline', 'pill-gray', true);
        if (terms.has(activeSid)) setSessionState(activeSid, 'offline', 'pill-gray', true);
      }
    });

    socket.on('console:waiting', ({ error, deadline }) => {
      if (activeTab !== 'terminal') return;
      const why = String(error || '').replace(/SSH connection timed out/g, 'sshd not yet reachable').replace(/Connection lost before handshake/g, 'connection dropped before handshake');
      const short = why.length > 60 ? why.slice(0, 57) + '...' : why;
      startWaitTimer(deadline, short);
    });

    socket.on('console:error', (m) => {
      clearWaitTimer();
      if (activeTab === 'terminal') {
        setState('connection failed', 'pill-red', true);
        const entry = terms.get(activeSid);
        if (entry) entry.term.writeln('\r\n\x1b[31m[Error] ' + m + '\x1b[0m\r\n');
        if (activeSid) setSessionState(activeSid, 'connection failed', 'pill-red', true);
      }
    });

    // Live Boot Log events
    socket.on('bootlog:ready', () => {
      setBootState('Live Streaming', 'pill-green', true);
      bootStreaming = true;
      setTimeout(() => { try { bootFit.fit(); } catch (_) {} }, 100);
    });

    socket.on('bootlog:data', ({ text, init }) => {
      if (init) {
        rawBootBuffer = text || '';
        if (bootTerm) { bootTerm.clear(); bootTerm.write(rawBootBuffer); }
        if (rawBootEl) rawBootEl.textContent = rawBootBuffer;
      } else {
        rawBootBuffer += text;
        if (bootTerm) bootTerm.write(text);
        if (rawBootEl) rawBootEl.textContent = rawBootBuffer;
      }
      if (autoScroll) {
        if (bootTerm) bootTerm.scrollToBottom();
        if (rawBootEl && rawView) rawBootEl.scrollTop = rawBootEl.scrollHeight;
      }
    });

    socket.on('bootlog:cleared', () => {
      rawBootBuffer = '';
      if (bootTerm) bootTerm.clear();
      if (rawBootEl) rawBootEl.textContent = '';
      if (window.VP) VP.toast('Boot logs cleared', 'info');
    });

    socket.on('bootlog:error', () => {
      setBootState('Stream Error', 'pill-red', false);
    });

    socket.on('bootlog:close', () => {
      setBootState('Stream Closed', 'pill-gray', false);
      bootStreaming = false;
    });

    socket.on('disconnect', () => {
      connected = false;
      clearWaitTimer();
      if (activeTab === 'terminal') {
        if (isVmRunning) setState('reconnecting...', 'pill-yellow');
        else setState('offline', 'pill-gray');
      } else {
        setBootState('Connecting stream...', 'pill-blue', true);
      }
    });

    socket.on('connect_error', () => {
      if (activeTab === 'terminal') {
        if (isVmRunning) setState('reconnecting...', 'pill-yellow');
        else setState('offline', 'pill-gray');
      } else {
        setBootState('Connecting stream...', 'pill-blue', true);
        if (!sseSource) startSseFallback();
      }
    });
  }

  // ---------- Boot log helpers ----------
  function joinBootLog() {
    if (sseSource) { sseSource.close(); sseSource = null; }
    if (!socket || !connected) { setupSocket(); return; }
    setBootState('Connecting stream...', 'pill-blue', true);
    socket.emit('bootlog:join', { vmId: VM_ID });
    setTimeout(() => { try { bootFit.fit(); } catch (_) {} }, 150);
  }

  function leaveBootLog() {
    if (socket && connected) socket.emit('bootlog:leave');
    if (sseSource) { sseSource.close(); sseSource = null; }
  }

  function startSseFallback() {
    if (sseSource) return;
    setBootState('Live (HTTP SSE)', 'pill-green', true);
    sseSource = new EventSource('/servers/<%= vm.id %>/bootlog/stream');
    sseSource.addEventListener('log', (e) => {
      try {
        const data = JSON.parse(e.data);
        if (data.init) {
          rawBootBuffer = data.text || '';
          if (bootTerm) { bootTerm.clear(); bootTerm.write(rawBootBuffer); }
          if (rawBootEl) rawBootEl.textContent = rawBootBuffer;
        } else if (data.text) {
          rawBootBuffer += data.text;
          if (bootTerm) bootTerm.write(data.text);
          if (rawBootEl) rawBootEl.textContent = rawBootBuffer;
        }
        if (autoScroll) {
          if (bootTerm) bootTerm.scrollToBottom();
          if (rawBootEl && rawView) rawBootEl.scrollTop = rawBootEl.scrollHeight;
        }
      } catch (_) {}
    });
    sseSource.addEventListener('error', () => {
      setBootState('SSE Disconnected', 'pill-yellow', false);
    });
  }

  // ---------- Window / actions ----------
  window.addEventListener('resize', () => {
    if (activeTab === 'terminal') {
      const entry = terms.get(activeSid);
      if (entry) { try { entry.fit.fit(); sendResize(activeSid); } catch (_) {} }
    } else if (activeTab === 'bootlog') {
      try { bootFit.fit(); } catch (_) {}
    }
  });

  window.clearActiveTerm = function () {
    const entry = terms.get(activeSid);
    if (entry) entry.term.clear();
  };

  window.fitActiveTerm = function () {
    const entry = terms.get(activeSid);
    if (entry) { try { entry.fit.fit(); sendResize(activeSid); entry.term.focus(); updateSizeBadge(entry.term, false); } catch (_) {} }
  };

  window.fitBootTerm = function () {
    if (bootFit && bootTerm) { try { bootFit.fit(); } catch (_) {} }
  };

  window.sendCtrlC = function () {
    if (connected && socket && activeSid) { socket.emit('console:input', { sessionId: activeSid, data: '\x03' }); const e = terms.get(activeSid); if (e) e.term.focus(); }
  };

  window.sendCtrlD = function () {
    if (connected && socket && activeSid) { socket.emit('console:input', { sessionId: activeSid, data: '\x04' }); const e = terms.get(activeSid); if (e) e.term.focus(); }
  };

  window.toggleFullscreen = function (paneId) {
    const pane = document.getElementById(paneId);
    if (!pane) return;
    pane.classList.toggle('fullscreen-pane');
    document.body.classList.toggle('term-fullscreen', !!document.querySelector('.fullscreen-pane'));
    setTimeout(() => {
      if (paneId === 'paneTerminal') {
        const entry = terms.get(activeSid);
        if (entry) { try { entry.fit.fit(); sendResize(activeSid); entry.term.focus(); updateSizeBadge(entry.term, false); } catch (_) {} }
      } else if (paneId === 'paneBootLog' && bootFit) {
        bootFit.fit();
      }
    }, 150);
  };

  window.resetToAutoSize = function (wrapperId) {
    const wrapper = document.getElementById(wrapperId);
    if (!wrapper) return;
    wrapper.style.width = '100%';
    wrapper.style.height = 'calc(100vh - 350px)';
    setTimeout(() => {
      if (wrapperId === 'bootTermWrapper') {
        if (bootFit) bootFit.fit();
      } else {
        const entry = terms.get(activeSid);
        if (entry) { try { entry.fit.fit(); sendResize(activeSid); updateSizeBadge(entry.term, false); } catch (_) {} entry.term.focus(); }
      }
      if (window.VP) VP.toast('Reset to default Auto Size', 'info');
    }, 50);
  };

  window.resetActiveToAutoSize = function () {
    window.resetToAutoSize('tw-' + activeSid);
  };

  // 4-corner resizing, event delegation (works for dynamically added panes)
  document.addEventListener('mousedown', function (e) {
    const handle = e.target.closest('.resize-handle');
    if (!handle) return;
    e.preventDefault();
    e.stopPropagation();

    const targetId = handle.dataset.target;
    const dir = handle.dataset.dir;
    const wrapper = document.getElementById(targetId);
    if (!wrapper) return;

    wrapper.classList.add('is-resizing');
    const startX = e.clientX;
    const startY = e.clientY;
    const startWidth = wrapper.offsetWidth;
    const startHeight = wrapper.offsetHeight;

    function onMouseMove(moveEvent) {
      moveEvent.preventDefault();
      const deltaX = moveEvent.clientX - startX;
      const deltaY = moveEvent.clientY - startY;
      let newWidth = startWidth;
      let newHeight = startHeight;

      if (dir === 'br') { newWidth = startWidth + deltaX; newHeight = startHeight + deltaY; }
      else if (dir === 'bl') { newWidth = startWidth - deltaX; newHeight = startHeight + deltaY; }
      else if (dir === 'tr') { newWidth = startWidth + deltaX; newHeight = startHeight - deltaY; }
      else if (dir === 'tl') { newWidth = startWidth - deltaX; newHeight = startHeight - deltaY; }
      else if (dir === 'b') { newHeight = startHeight + deltaY; }

      const minW = 320, minH = 260;
      const maxW = window.innerWidth - 60, maxH = window.innerHeight - 100;
      newWidth = Math.max(minW, Math.min(maxW, newWidth));
      newHeight = Math.max(minH, Math.min(maxH, newHeight));

      if (dir !== 'b') wrapper.style.width = newWidth + 'px';
      wrapper.style.height = newHeight + 'px';

      const sid = targetId.slice(3); // strip 'tw-'
      if (targetId !== 'bootTermWrapper' && terms.has(sid)) {
        const entry = terms.get(sid);
        if (entry) { try { entry.fit.fit(); sendResize(sid); updateSizeBadge(entry.term, true); } catch (_) {} }
      } else if (targetId === 'bootTermWrapper' && bootFit) {
        bootFit.fit();
      }
    }

    function onMouseUp() {
      wrapper.classList.remove('is-resizing');
      document.removeEventListener('mousemove', onMouseMove);
      document.removeEventListener('mouseup', onMouseUp);

      const sid = targetId.slice(3);
      if (targetId !== 'bootTermWrapper' && terms.has(sid)) {
        const entry = terms.get(sid);
        if (entry) { try { entry.fit.fit(); sendResize(sid); updateSizeBadge(entry.term, true); entry.term.focus(); } catch (_) {} }
      } else if (targetId === 'bootTermWrapper' && bootFit) {
        bootFit.fit();
      }
    }

    document.addEventListener('mousemove', onMouseMove);
    document.addEventListener('mouseup', onMouseUp);
  });

  // ---------------- Boot Logs Actions ----------------
  window.toggleAutoScroll = function () {
    autoScroll = !autoScroll;
    const lbl = document.getElementById('autoScrollLabel');
    const btn = document.getElementById('btnToggleScroll');
    if (lbl) lbl.textContent = 'Auto-Scroll: ' + (autoScroll ? 'ON' : 'OFF');
    if (btn) btn.classList.toggle('btn-primary', autoScroll);
    if (autoScroll && bootTerm) bootTerm.scrollToBottom();
  };

  window.toggleViewMode = function () {
    rawView = !rawView;
    const lbl = document.getElementById('viewModeLabel');
    const termDiv = document.getElementById('bootTerminal');
    const rawDiv = document.getElementById('bootRawContent');
    if (rawView) {
      termDiv.style.display = 'none';
      rawDiv.style.display = 'block';
      rawDiv.textContent = rawBootBuffer || '[Boot Log] No boot output recorded yet.';
      if (lbl) lbl.textContent = 'Terminal View';
      if (autoScroll) rawDiv.scrollTop = rawDiv.scrollHeight;
    } else {
      rawDiv.style.display = 'none';
      termDiv.style.display = 'block';
      if (lbl) lbl.textContent = 'Raw View';
      if (bootFit) bootFit.fit();
      if (autoScroll && bootTerm) bootTerm.scrollToBottom();
    }
  };

  window.clearBootDisplay = function () {
    if (bootTerm) bootTerm.clear();
    if (rawBootEl) rawBootEl.textContent = '';
    rawBootBuffer = '';
    if (window.VP) VP.toast('Boot terminal display cleared', 'info');
  };

  window.clearBootServerLog = async function () {
    const ok = await VP.confirmDialog('Clear boot log files on server?', { title: 'Clear Server Logs' });
    if (!ok) return;
    if (socket && connected) {
      socket.emit('bootlog:clear', { vmId: VM_ID });
    } else {
      try {
        await VP.api('/servers/<%= vm.id %>/bootlog/clear', { method: 'POST' });
        clearBootDisplay();
        VP.toast('Boot logs cleared on server', 'success');
      } catch (e) { VP.toast(e.message, 'error'); }
    }
  };

  window.aiDiagnoseBoot = async function () {
    try {
      const res = await VP.api('/servers/<%= vm.id %>/bootlog/diagnose');
      const f = res.findings || [];
      let html = '<div style="display:flex;flex-direction:column;gap:8px;max-height:60vh;overflow:auto">';
      html += '<div style="font-weight:700;font-size:15px">AI Boot Diagnostics — status: <span style="color:' + (res.state === 'healthy' ? 'var(--green)' : res.state === 'critical' ? 'var(--red)' : 'var(--yellow)') + '">' + res.state + '</span></div>';
      if (!res.has_log) {
        html += '<div class="muted text-sm">No boot log found yet. Start the server first.</div>';
      } else if (!f.length) {
        html += '<div class="muted text-sm">No common failure patterns detected (' + res.metrics.lines + ' log lines). Under the hood this is a heuristic scan.</div>';
      } else {
        f.forEach((item) => {
          const color = item.severity === 'critical' ? 'var(--red)' : item.severity === 'high' ? 'var(--orange, var(--yellow))' : item.severity === 'medium' ? 'var(--yellow)' : 'var(--green)';
          html += '<div class="card" style="padding:12px;border-left:3px solid ' + color + ';background:var(--glass)">'
            + '<div class="flex-between"><b style="color:' + color + '">' + item.label + '</b><span class="pill pill-gray mono" style="font-size:10px">' + Math.round(item.confidence * 100) + '%</span></div>'
            + '<div class="muted text-sm mt-1" style="line-height:1.5">' + item.hint + '</div>'
            + (item.match ? '<div class="mono text-sm mt-1" style="font-size:11px;color:var(--text-dim);word-break:break-all">"…' + item.match + '…"</div>' : '')
            + '</div>';
        });
      }
      html += '</div>';
      await VP.confirmDialog(html, { title: 'Boot Log AI Diagnose', html: true, danger: false, okText: 'Close', width: 'min(640px,92vw)' });
    } catch (e) { VP.toast('Diagnostic failed: ' + e.message, 'error'); }
  };

  window.copyBootLog = function () {
    if (!rawBootBuffer) { VP.toast('No boot log output to copy', 'warning'); return; }
    navigator.clipboard.writeText(rawBootBuffer)
      .then(() => VP.toast('Boot logs copied to clipboard!', 'success'))
      .catch(() => VP.toast('Failed to copy', 'error'));
  };

  window.downloadBootLog = function () {
    if (!rawBootBuffer) { VP.toast('No boot log output to download', 'warning'); return; }
    const blob = new Blob([rawBootBuffer], { type: 'text/plain;charset=utf-8' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = '<%= vm.name %>-boot-' + new Date().toISOString().replace(/[:.]/g, '-') + '.log';
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
    URL.revokeObjectURL(url);
    VP.toast('Boot log download started', 'success');
  };

  window.startAndStream = async function () {
    const btn = document.getElementById('btnStartFromBoot');
    if (btn) btn.disabled = true;
    try {
      VP.toast('Starting server...', 'info');
      await VP.api('/servers/<%= vm.id %>/power', { method: 'POST', body: { action: 'start' } });
      VP.toast('Server started! Streaming boot logs...', 'success');
      const pill = document.getElementById('headerStatusPill');
      if (pill) { pill.textContent = 'running'; pill.className = 'pill pill-green'; }
      if (btn) btn.style.display = 'none';
      joinBootLog();
    } catch (e) { VP.toast(e.message, 'error'); if (btn) btn.disabled = false; }
  };

  window.onSearchInput = function (query) {
    if (!query) {
      if (rawView && rawBootEl) rawBootEl.textContent = rawBootBuffer;
      return;
    }
    const q = query.toLowerCase();
    if (rawView && rawBootEl) {
      const lines = rawBootBuffer.split('\n');
      const filtered = lines.filter(l => l.toLowerCase().includes(q));
      rawBootEl.textContent = filtered.join('\n') || '[No lines matching "' + query + '"]';
    }
  };

  // ---------------- View switching ----------------
  window.switchView = function switchView(tab) {
    activeTab = tab;
    document.getElementById('tabTerminal').classList.toggle('active', tab === 'terminal');
    document.getElementById('tabBootLog').classList.toggle('active', tab === 'bootlog');
    document.getElementById('tabVnc').classList.toggle('active', tab === 'vnc');
    document.getElementById('paneTerminal').style.display = tab === 'terminal' ? 'block' : 'none';
    document.getElementById('paneBootLog').style.display = tab === 'bootlog' ? 'block' : 'none';
    if (document.getElementById('paneVnc')) document.getElementById('paneVnc').style.display = tab === 'vnc' ? 'block' : 'none';

    if (history.replaceState) {
      const q = tab === 'bootlog' ? '?tab=bootlog' : tab === 'vnc' ? '?tab=vnc' : '?tab=terminal';
      history.replaceState(null, null, q);
    }

    if (tab === 'terminal') {
      window.vncDisconnect && window.vncDisconnect();
      leaveBootLog();
      if (terms.size === 0) {
        if (isVmRunning) window.newTerminal();
        else setState('offline', 'pill-gray');
      } else {
        activateSession(activeSid || Array.from(terms.keys())[0]);
      }
    } else if (tab === 'bootlog') {
      window.vncDisconnect && window.vncDisconnect();
      setTimeout(() => { try { bootFit.fit(); } catch (_) {} }, 100);
      joinBootLog();
    } else if (tab === 'vnc') {
      leaveBootLog();
      window.vncConnect && window.vncConnect();
    }
  };

  // ================= noVNC Graphical Console =================
  let vnc = null;
  const vncStateEl = document.getElementById('vncState');
  const vncScreen = document.getElementById('vncScreen');
  const vncMsg = document.getElementById('vncStatusMsg');

  function setVncState(label, cls) {
    if (!vncStateEl) return;
    vncStateEl.textContent = label;
    vncStateEl.className = 'pill ' + (cls || 'pill-gray');
  }

  window.initVnc = function initVnc() {
    if (!vncScreen) return;
    vncScreen.style.display = 'none';
    if (vncMsg) vncMsg.style.display = 'flex';
  };

  window.vncConnect = function vncConnect() {
    if (!vncScreen || !isVmRunning) {
      if (!isVmRunning) { if (window.VP && VP.toast) VP.toast('Start the server first', 'warn'); }
      return;
    }
    const wsProto = location.protocol === 'https:' ? 'wss://' : 'ws://';
    const url = wsProto + location.host + '/vncws/<%= vm.id %>?token=' + encodeURIComponent(vpToken());

    function loadRfb() {
      import('/vendor/novnc/core/rfb.js').then((mod) => {
        try { vncConnectWith(mod.RFB || mod.default); } catch (e) { tryConnectFail(e); }
      }).catch((e) => tryConnectFail(e));
    }

    function tryConnectFail(e) {
      if (window.VP && VP.toast) VP.toast('Could not load noVNC: ' + e.message, 'error');
      setVncState('noVNC unavailable', 'pill-red');
    }

    window.vncConnectWith = function vncConnectWith(RFB) {
      if (vnc) { try { vnc.disconnect(); } catch (_) {} vnc = null; }
      if (vncScreen) vncScreen.style.display = 'block';
      if (vncMsg) vncMsg.style.display = 'none';
      const rfb = new RFB(vncScreen, url, { credentials: { password: '' } });
      vnc = rfb;
      setVncState('connecting', 'pill-yellow');
      rfb.addEventListener('connect', () => setVncState('connected', 'pill-green'));
      rfb.addEventListener('disconnect', () => {
        setVncState('disconnected', 'pill-gray');
        if (vncMsg) vncMsg.style.display = 'flex';
        if (vncScreen) vncScreen.style.display = 'none';
        vnc = null;
      });
      rfb.addEventListener('securityfailure', () => setVncState('auth failed', 'pill-red'));
    };

    loadRfb();
  };

  window.vncDisconnect = function vncDisconnect() {
    if (vnc) { try { vnc.disconnect(); } catch (_) {} vnc = null; }
    if (vncMsg) vncMsg.style.display = 'flex';
    if (vncScreen) vncScreen.style.display = 'none';
    setVncState('disconnected', 'pill-gray');
  };

  // ---------------- Init ----------------
  const urlParams = new URLSearchParams(window.location.search);
  const initialTab = (urlParams.get('tab') === 'bootlog' || window.location.hash === '#bootlog') ? 'bootlog'
    : (urlParams.get('tab') === 'vnc' || window.location.hash === '#vnc') ? 'vnc'
    : 'terminal';

  initBootTerm();
  initVnc();

  if (initialTab === 'bootlog') {
    switchView('bootlog');
    setupSocket();
  } else if (initialTab === 'vnc') {
    switchView('vnc');
    setupSocket();
  } else {
    if (isVmRunning) {
      setupSocket();
    } else {
      const sid0 = 't' + newSid();
      const entry0 = createTerminalPane(sid0);
      setSessionState(sid0, 'offline', 'pill-gray', true);
      activateSession(sid0);
      entry0.term.writeln('\r\n\x1b[33m[Notice] Server is offline. Start the server to launch SSH session or monitor Live Boot Logs.\x1b[0m\r\n');
      setupSocket();
    }
  }
})();
</script>