<%- include('../../partials/head', { title: vm.name + ' - Overview' }) %>
<%- include('../../partials/ambient') %>
<%- include('../../partials/topbar') %>
<%- include('../../partials/sidebar') %>

<style>
.pulse-dot {
  display: inline-block;
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: #22c55e;
  margin-right: 6px;
  box-shadow: 0 0 8px rgba(34, 197, 94, 0.8);
  animation: pulse-live 1.5s infinite ease-in-out;
}
@keyframes pulse-live {
  0% { transform: scale(0.9); opacity: 0.7; }
  50% { transform: scale(1.3); opacity: 1; box-shadow: 0 0 12px rgba(34, 197, 94, 1); }
  100% { transform: scale(0.9); opacity: 0.7; }
}
.stat-live-badge {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 6px;
  font-size: 12px;
}
</style>

<div class="main">
  <div class="flex-between mb-3">
    <div>
      <div class="muted text-sm" style="margin-bottom:2px">
        <a href="/dashboard" style="color:var(--text-dim)">Servers</a> / <%= vm.name %>
      </div>
      <h2 style="font-size:24px;font-weight:800;letter-spacing:-0.3px;display:flex;align-items:center;gap:12px">
        <%= vm.name %>
        <span id="statusPill" class="pill <%= vm.status === 'running' ? 'pill-green' : 'pill-gray' %>">
          <span id="pulseDot" class="pulse-dot" style="<%= vm.status === 'running' ? 'display:inline-block' : 'display:none' %>"></span>
          <span id="statusText"><%= vm.status %></span>
        </span>
      </h2>
    </div>

    <!-- Power Controls Bar -->
    <div class="flex" id="powerControls" style="gap:8px">
      <% if (vm.status === 'running') { %>
        <button class="btn btn-sm btn-danger" id="btnStop" onclick="power('stop')">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14"><rect x="6" y="6" width="12" height="12" rx="2"/></svg>
          Stop
        </button>
        <button class="btn btn-sm btn-primary" id="btnRestart" onclick="power('restart')">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14"><path d="M23 4v6h-6M1 20v-6h6M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"/></svg>
          Restart
        </button>
      <% } else { %>
        <button class="btn btn-sm btn-green" id="btnStart" onclick="power('start')">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14"><polygon points="5 3 19 12 5 21 5 3"/></svg>
          Start Server
        </button>
      <% } %>
      <a class="btn btn-sm" href="/servers/<%= vm.id %>/console">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14"><path d="M4 17l6-5-6-5M12 19h8"/></svg>
        Terminal
      </a>
      <a class="btn btn-sm" href="/servers/<%= vm.id %>/console?tab=bootlog" title="View Real-Time Live Boot Logs">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14"><path d="M13 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9z"/><polyline points="13 2 13 9 20 9"/></svg>
        Boot Logs
      </a>
    </div>
  </div>

  <%- include('_tabs') %>

  <!-- Spec & Live Metrics Cards -->
  <div class="grid grid-4 mb-4">
    <div class="stat">
      <div class="stat-icon" style="background:rgba(99,102,241,0.15);color:#818cf8">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
      </div>
      <div style="flex:1">
        <div class="flex-between">
          <div class="stat-value"><%= vm.cpus %> vCPU</div>
          <span id="liveCpuBadge" class="pill pill-sm pill-blue" style="font-size:11px;padding:2px 7px">0% Load</span>
        </div>
        <div class="stat-label">Processor Load</div>
        <div style="height:4px;background:rgba(255,255,255,0.08);border-radius:2px;margin-top:8px;overflow:hidden">
          <div id="liveCpuBar" style="height:100%;width:0%;background:linear-gradient(90deg, #6366f1, #818cf8);transition:width 0.4s ease"></div>
        </div>
      </div>
    </div>

    <div class="stat">
      <div class="stat-icon" style="background:rgba(56,189,248,0.15);color:#38bdf8">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="2" width="20" height="8" rx="2"/><rect x="2" y="14" width="20" height="8" rx="2"/><path d="M6 6h.01M6 18h.01"/></svg>
      </div>
      <div style="flex:1">
        <div class="flex-between">
          <div class="stat-value" id="statMemVal"><%= vm.memory %> MB</div>
          <span id="liveMemBadge" style="font-size:11px;color:#38bdf8;font-weight:600">0%</span>
        </div>
        <div class="stat-label" id="statMemLabel">Memory (<%= (vm.memory/1024).toFixed(1) %> GB)</div>
        <div style="height:4px;background:rgba(255,255,255,0.08);border-radius:2px;margin-top:8px;overflow:hidden">
          <div id="liveMemBar" style="height:100%;width:0%;background:linear-gradient(90deg, #38bdf8, #818cf8);transition:width 0.4s ease"></div>
        </div>
      </div>
    </div>

    <div class="stat">
      <div class="stat-icon" style="background:rgba(245,158,11,0.15);color:#fbbf24">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12a9 9 0 1 1-2.64-6.36M21 3v6h-6"/></svg>
      </div>
      <div style="flex:1">
        <div class="flex-between">
          <div class="stat-value"><%= vm.disk_size %></div>
          <span id="liveDiskBadge" style="font-size:11px;color:#fbbf24;font-weight:600">0%</span>
        </div>
        <div class="stat-label" id="statDiskLabel">Disk (<span id="liveDiskActual">-- MB</span> on host)</div>
        <div style="height:4px;background:rgba(255,255,255,0.08);border-radius:2px;margin-top:8px;overflow:hidden">
          <div id="liveDiskBar" style="height:100%;width:0%;background:linear-gradient(90deg, #f59e0b, #fbbf24);transition:width 0.4s ease"></div>
        </div>
      </div>
    </div>

    <div class="stat">
      <div class="stat-icon" style="background:rgba(16,185,129,0.15);color:#34d399">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 8v4l2 2M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20z"/></svg>
      </div>
      <div style="flex:1">
        <div class="flex-between">
          <div class="stat-value" id="statUptime"><%= vm.status === 'running' ? 'Active' : 'Offline' %></div>
          <span id="liveHealthBadge" class="pill pill-sm <%= vm.status === 'running' ? 'pill-green' : 'pill-gray' %>" style="font-size:11px;padding:2px 7px">
            <%= vm.status === 'running' ? 'Healthy' : 'Offline' %>
          </span>
        </div>
        <div class="stat-label" id="livePidLabel">Uptime &amp; Process State</div>
        <div style="height:4px;background:rgba(255,255,255,0.08);border-radius:2px;margin-top:8px;overflow:hidden">
          <div id="liveHealthBar" style="height:100%;width:<%= vm.status === 'running' ? '100%' : '0%' %>;background:linear-gradient(90deg, #10b981, #34d399);transition:width 0.4s ease"></div>
        </div>
      </div>
    </div>
  </div>

  <div class="grid grid-2">
    <!-- Server Details & Live Telemetry -->
    <div class="card">
      <div class="card-title">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18"><rect x="2" y="2" width="20" height="8" rx="2"/><rect x="2" y="14" width="20" height="8" rx="2"/><path d="M6 6h.01M6 18h.01"/></svg>
        Instance Specifications &amp; Live Telemetry
      </div>
      <div class="table-wrap">
        <table>
          <tbody>
            <tr><td class="muted" style="width:140px">UUID</td><td class="mono"><%= vm.uuid %></td></tr>
            <tr><td class="muted">Live Status</td><td><span id="tableStatusPill" class="pill <%= vm.status === 'running' ? 'pill-green' : 'pill-gray' %> font-bold"><%= vm.status %></span></td></tr>
            <tr>
              <td class="muted">Assigned Owner</td>
              <td>
                <div class="flex-between">
                  <div>
                    <span class="font-bold text-white"><%= vm.owner_name || 'Administrator' %></span>
                    <% if (vm.owner_email) { %>
                      <span class="muted text-sm">&lt;<%= vm.owner_email %>&gt;</span>
                    <% } %>
                  </div>
                  <% if (typeof allUsers !== 'undefined' && allUsers.length > 1 && (user.role === 'admin' || user.root_admin)) { %>
                    <button type="button" class="btn btn-sm" onclick="openTransferModal()" style="font-size:11.5px;padding:2px 8px">
                      Transfer Owner
                    </button>
                  <% } %>
                </div>
              </td>
            </tr>
            <tr><td class="muted">QEMU Process PID</td><td class="mono font-bold" id="tablePid"><%= vm.status === 'running' ? 'Active' : 'Not running' %></td></tr>
            <tr><td class="muted">Operating System</td><td><span class="pill pill-blue font-bold"><%= vm.os_type %> <%= vm.codename %></span></td></tr>
            <tr><td class="muted">Hostname</td><td class="mono"><%= vm.hostname %></td></tr>
            <tr><td class="muted">Username</td><td class="mono font-bold" style="color:#fff"><%= vm.username %></td></tr>
            <tr><td class="muted">SSH Port</td><td class="mono"><span style="color:var(--accent-2);font-weight:700">Port <%= vm.ssh_port %></span></td></tr>
            <tr><td class="muted">VNC Port</td><td class="mono"><%= vm.vnc_port ? ('Port ' + vm.vnc_port) : 'Dynamic' %></td></tr>
            <tr><td class="muted">Web Terminal</td><td><a href="/servers/<%= vm.id %>/console" class="btn btn-sm">Launch Terminal</a></td></tr>
            <tr><td class="muted">Live Boot Output</td><td><a href="/servers/<%= vm.id %>/console?tab=bootlog" class="btn btn-sm btn-primary">Stream Boot Logs</a></td></tr>
            <tr><td class="muted">Port Forwards</td><td class="mono"><% if (vm.port_forwards && vm.port_forwards.length) { %><% for (const f of vm.port_forwards) { %><span class="pill pill-gray" style="margin-right:4px"><%= f.host %>:<%= f.guest %></span><% } %><% } else { %><span class="muted">None configured</span><% } %></td></tr>
            <tr><td class="muted">Created At</td><td class="muted"><%= new Date(vm.created_at).toLocaleString() %></td></tr>
            <tr><td class="muted">Start on Panel Boot</td><td><%= vm.start_on_boot ? 'Yes (Automatic)' : 'No (Manual)' %></td></tr>
          </tbody>
        </table>
      </div>
    </div>

    <!-- Quick Actions & Credentials -->
    <div class="card">
      <div class="card-title">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
        Quick Actions &amp; Management
      </div>
      <div class="flex flex-wrap mb-3" style="gap:10px">
        <a class="btn btn-primary" href="/servers/<%= vm.id %>/console">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="15" height="15"><path d="M4 17l6-5-6-5M12 19h8"/></svg>
          Open Terminal
        </a>
        <a class="btn" href="/servers/<%= vm.id %>/console?tab=bootlog">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="15" height="15"><path d="M13 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9z"/><polyline points="13 2 13 9 20 9"/></svg>
          Live Boot Logs
        </a>
        <a class="btn" href="/servers/<%= vm.id %>/files">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="15" height="15"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/></svg>
          File Manager
        </a>
        <a class="btn" href="/servers/<%= vm.id %>/backups">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="15" height="15"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/><polyline points="17 21 17 13 7 13 7 21"/><polyline points="7 3 7 8 15 8"/></svg>
          Backups
        </a>
        <a class="btn" href="/servers/<%= vm.id %>/schedules">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="15" height="15"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
          Schedules
        </a>
        <a class="btn" href="/servers/<%= vm.id %>/settings">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="15" height="15"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
          Settings
        </a>
        <button class="btn btn-danger" onclick="delServer()">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="15" height="15"><path d="M3 6h18M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2m3 0v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6"/></svg>
          Delete Server
        </button>
      </div>

      <hr class="hr"/>

      <!-- SSH Access Card Box -->
      <div style="background:rgba(0,0,0,0.3);border:1px solid var(--border);border-radius:12px;padding:16px">
        <div class="flex-between mb-2">
          <div style="font-weight:700;font-size:13px;color:#fff">Remote SSH Access</div>
          <div class="flex" style="gap:6px">
            <button class="btn btn-sm btn-primary" id="tmateBtn" onclick="loadTmate(false, this)">Get SSH Command</button>
            <button class="btn btn-sm" id="tmateRegenBtn" onclick="loadTmate(true, this)" title="Start a fresh session and get a new address" style="display:none">↻ New</button>
          </div>
        </div>
        <div class="mono" id="tmateCmd" style="background:#060913;padding:10px 14px;border-radius:8px;border:1px solid rgba(255,255,255,0.06);color:var(--accent-2);font-size:13px;word-break:break-all">
          ssh ****@tmate.io — click "Get SSH Command"
        </div>
        <div class="muted mt-1" style="font-size:11px">Works from anywhere — no port forwarding needed. Run it in any terminal to control this server.</div>
        <hr class="hr" style="margin:12px 0"/>
        <div class="flex-between" style="font-size:12.5px">
          <span class="muted">Default Password:</span>
          <div class="flex" style="gap:6px">
            <span class="mono font-bold" style="color:#fff"><%= vm.password %></span>
            <button class="icon-btn" style="width:24px;height:24px" onclick="copyText('<%= vm.password %>')" title="Copy password">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="12" height="12"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
            </button>
          </div>
        </div>
        <div class="flex-between mt-2" style="font-size:12.5px">
          <span class="muted">Node Port SSH (local network):</span>
          <div class="flex" style="gap:6px">
            <span class="mono" style="color:var(--accent-2)">ssh -p <%= vm.ssh_port %> <%= vm.username %>@<%= (vm.node_host || 'node-ip') %></span>
            <button class="icon-btn" style="width:24px;height:24px" onclick="copyText('ssh -p <%= vm.ssh_port %> <%= vm.username %>@<%= (vm.node_host || 'node-ip') %>')" title="Copy">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="12" height="12"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<% if (typeof allUsers !== 'undefined' && allUsers.length > 1 && (user.role === 'admin' || user.root_admin)) { %>
<!-- Transfer Ownership Modal -->
<div id="transferModal" style="display:none">
  <div style="position:fixed;inset:0;background:rgba(0,0,0,0.75);z-index:200;display:grid;place-items:center;padding:20px;backdrop-filter:blur(8px)">
    <div class="card" style="width:min(460px,94vw);box-shadow:0 24px 60px rgba(0,0,0,0.6)">
      <div class="flex-between mb-3">
        <h3 style="font-size:18px;font-weight:700;margin:0">Transfer Server Ownership</h3>
        <button type="button" class="btn btn-sm" onclick="closeTransferModal()">✕</button>
      </div>
      <p class="muted text-sm mb-3">Transfer ownership of <strong><%= vm.name %></strong> to another registered user account.</p>
      
      <div class="form-group mb-4">
        <label>Select New Owner</label>
        <select id="transferOwnerSelect" style="width:100%;padding:10px;border-radius:8px">
          <% for (const u of allUsers) { %>
            <option value="<%= u.id %>" <%= u.id === vm.owner_id ? 'selected disabled' : '' %>>
              <%= u.username %> (<%= u.email %>) <%= u.id === vm.owner_id ? '— Current Owner' : '' %>
            </option>
          <% } %>
        </select>
      </div>

      <div class="flex right" style="gap:8px">
        <button type="button" class="btn" onclick="closeTransferModal()">Cancel</button>
        <button type="button" class="btn btn-primary" onclick="submitTransfer()">Confirm Transfer</button>
      </div>
    </div>
  </div>
</div>
<% } %>

<%- include('../../partials/music') %>
<%- include('../../partials/foot') %>

<script>
function openTransferModal() {
  const m = document.getElementById('transferModal');
  if (m) m.style.display = 'block';
}

function closeTransferModal() {
  const m = document.getElementById('transferModal');
  if (m) m.style.display = 'none';
}

async function submitTransfer() {
  const sel = document.getElementById('transferOwnerSelect');
  if (!sel || !sel.value) return;
  try {
    const res = await fetch('/servers/<%= vm.id %>/transfer', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + vpToken() },
      body: JSON.stringify({ owner_id: sel.value })
    });
    const d = await res.json();
    if (!res.ok || !d.ok) throw new Error(d.error || 'Failed to transfer VM');
    VP.toast('Ownership transferred successfully', 'success');
    setTimeout(() => location.reload(), 700);
  } catch (e) {
    VP.toast(e.message, 'error');
  }
}

function copyText(t) {
  navigator.clipboard.writeText(t)
    .then(() => VP.toast('Copied to clipboard!', 'success'))
    .catch(() => VP.toast('Failed to copy', 'error'));
}

// Remote SSH via tmate — works from anywhere, no port forwarding needed
async function loadTmate(regen, btn) {
  const el = document.getElementById('tmateCmd');
  const regenBtn = document.getElementById('tmateRegenBtn');
  if (btn) { btn.disabled = true; btn.textContent = regen ? 'Generating...' : 'Getting...'; }
  el.textContent = 'Connecting to the VM (first boot takes 1-3 min for SSH to come up; installing tmate adds ~30s)...';
  try {
    const r = await VP.api('/servers/<%= vm.id %>/power', { method: 'POST', body: { action: 'tmate', regen: !!regen } });
    const ssh = r.ssh;
    el.textContent = 'ssh ' + ssh;
    el.onclick = () => copyText('ssh ' + ssh);
    el.style.cursor = 'pointer';
    el.title = 'Click to copy';
    if (regenBtn) regenBtn.style.display = 'inline-flex';
    VP.toast(regen ? 'New SSH command generated' : 'SSH command ready — click it to copy', 'success');
  } catch (e) {
    el.textContent = 'Could not get SSH command: ' + e.message;
    VP.toast(e.message, 'error');
  } finally {
    if (btn) { btn.disabled = false; btn.textContent = regen ? '↻ New' : 'Get SSH Command'; }
  }
}

async function power(action) {
  const btn = document.getElementById(action === 'stop' ? 'btnStop' : action === 'restart' ? 'btnRestart' : 'btnStart');
  if (btn) btn.disabled = true;
  try {
    VP.toast(`Sending ${action} command...`, 'info');
    await VP.api(`/servers/<%= vm.id %>/power`, { method: 'POST', body: { action } });
    VP.toast(`Server ${action} command sent successfully`, 'success');
    if (action === 'start' || action === 'restart') {
      setTimeout(() => updateLiveStats(), 500);
    }
    setTimeout(() => updateLiveStats(), 1500);
  } catch (e) {
    VP.toast(e.message, 'error');
    if (btn) btn.disabled = false;
  }
}

async function delServer() {
  const ok = await VP.confirmDialog('This will permanently delete <%= vm.name %> and ALL disk images and backups. This cannot be undone!', { title: 'Delete server?' });
  if (!ok) return;
  try {
    await VP.api(`/servers/<%= vm.id %>/delete`, { method: 'POST' });
    VP.toast('Server deleted', 'success');
    setTimeout(() => location.href = '/dashboard', 800);
  } catch (e) {
    VP.toast(e.message, 'error');
  }
}

// ---------------- Live State & Resource Bars Updater ----------------
let lastStatus = '<%= vm.status %>';

async function updateLiveStats() {
  try {
    const res = await fetch('/servers/<%= vm.id %>/status', {
      headers: { Authorization: 'Bearer ' + vpToken() }
    });
    const data = await res.json();
    if (!data || !data.stats) return;
    const stats = data.stats;

    // 1. Status Pill & Pulse Dot
    const statusPill = document.getElementById('statusPill');
    const statusText = document.getElementById('statusText');
    const pulseDot = document.getElementById('pulseDot');
    const resourcePulseDot = document.getElementById('resourcePulseDot');
    const tableStatusPill = document.getElementById('tableStatusPill');
    const isRunning = stats.status === 'running';

    if (statusPill && statusText) {
      statusText.textContent = stats.status;
      statusPill.className = 'pill ' + (isRunning ? 'pill-green' : 'pill-gray');
      if (pulseDot) pulseDot.style.display = isRunning ? 'inline-block' : 'none';
      if (resourcePulseDot) resourcePulseDot.style.display = isRunning ? 'inline-block' : 'none';
    }
    if (tableStatusPill) {
      tableStatusPill.textContent = stats.status;
      tableStatusPill.className = 'pill font-bold ' + (isRunning ? 'pill-green' : 'pill-gray');
    }

    // 2. CPU Load & CPU Bar
    const cpuBadge = document.getElementById('liveCpuBadge');
    const liveCpuBar = document.getElementById('liveCpuBar');

    const cpuPct = stats.cpu ? stats.cpu.percent : 0;
    if (cpuBadge) {
      cpuBadge.textContent = isRunning ? `${cpuPct}% Load` : '0% (Offline)';
      cpuBadge.className = 'pill pill-sm ' + (cpuPct > 75 ? 'pill-red' : cpuPct > 40 ? 'pill-yellow' : 'pill-blue');
    }
    if (liveCpuBar) liveCpuBar.style.width = isRunning ? `${Math.min(100, Math.max(cpuPct, 2))}%` : '0%';

    // 3. Memory Stats & Progress Bar
    const memBadge = document.getElementById('liveMemBadge');
    const liveMemBar = document.getElementById('liveMemBar');
    const memVal = document.getElementById('statMemVal');
    const memLabel = document.getElementById('statMemLabel');

    if (stats.memory) {
      const usedMb = stats.memory.used_mb || 0;
      const totalMb = stats.memory.total_mb || <%= vm.memory %>;
      const memPct = stats.memory.percent || 0;

      if (memBadge) memBadge.textContent = isRunning ? `${usedMb} MB (${memPct}%)` : '0 MB (0%)';
      if (liveMemBar) liveMemBar.style.width = isRunning ? `${memPct}%` : '0%';
      if (memLabel) memLabel.textContent = isRunning ? `Memory: ${usedMb} MB used` : `Memory (${(totalMb/1024).toFixed(1)} GB)`;
    }

    // 4. Actual Disk Usage & Disk Bar
    const diskAct = document.getElementById('liveDiskActual');
    const diskBadge = document.getElementById('liveDiskBadge');
    const liveDiskBar = document.getElementById('liveDiskBar');

    if (stats.disk) {
      const actMb = stats.disk.actual_mb || 0;
      const diskPct = stats.disk.percent || 0;
      if (diskAct) diskAct.textContent = actMb ? `${actMb} MB` : '0 MB';
      if (diskBadge) diskBadge.textContent = `${diskPct}%`;
      if (liveDiskBar) liveDiskBar.style.width = `${Math.min(100, Math.max(diskPct, 3))}%`;
    }

    // 5. Uptime, Health Bar & PID
    const upEl = document.getElementById('statUptime');
    const pidLabel = document.getElementById('livePidLabel');
    const tablePid = document.getElementById('tablePid');
    const healthBadge = document.getElementById('liveHealthBadge');
    const liveHealthBar = document.getElementById('liveHealthBar');

    if (upEl) {
      if (isRunning && stats.uptime) {
        const h = Math.floor(stats.uptime / 3600);
        const m = Math.floor((stats.uptime % 3600) / 60);
        const s = stats.uptime % 60;
        upEl.textContent = h ? `${h}h ${m}m ${s}s` : `${m}m ${s}s`;
      } else {
        upEl.textContent = isRunning ? 'Active' : 'Offline';
      }
    }

    if (healthBadge) {
      healthBadge.textContent = isRunning ? 'Healthy' : 'Offline';
      healthBadge.className = 'pill pill-sm ' + (isRunning ? 'pill-green' : 'pill-gray');
    }
    if (liveHealthBar) {
      liveHealthBar.style.width = isRunning ? '100%' : '0%';
    }

    if (pidLabel) {
      pidLabel.textContent = isRunning && stats.pid ? `PID: ${stats.pid} (Running)` : 'Status: Offline';
    }
    if (tablePid) {
      tablePid.textContent = isRunning && stats.pid ? `${stats.pid} (Active)` : 'Not running';
      tablePid.style.color = isRunning ? '#4ade80' : 'var(--text-dim)';
    }

    // 6. Dynamically update power buttons if state changed
    if (lastStatus !== stats.status) {
      lastStatus = stats.status;
      const ctrl = document.getElementById('powerControls');
      if (ctrl) {
        if (isRunning) {
          ctrl.innerHTML = `
            <button class="btn btn-sm btn-danger" id="btnStop" onclick="power('stop')">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14"><rect x="6" y="6" width="12" height="12" rx="2"/></svg>
              Stop
            </button>
            <button class="btn btn-sm btn-primary" id="btnRestart" onclick="power('restart')">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14"><path d="M23 4v6h-6M1 20v-6h6M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"/></svg>
              Restart
            </button>
            <a class="btn btn-sm" href="/servers/<%= vm.id %>/console">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14"><path d="M4 17l6-5-6-5M12 19h8"/></svg>
              Terminal
            </a>
            <a class="btn btn-sm" href="/servers/<%= vm.id %>/console?tab=bootlog" title="View Real-Time Live Boot Logs">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14"><path d="M13 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9z"/><polyline points="13 2 13 9 20 9"/></svg>
              Boot Logs
            </a>
          `;
        } else {
          ctrl.innerHTML = `
            <button class="btn btn-sm btn-green" id="btnStart" onclick="power('start')">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14"><polygon points="5 3 19 12 5 21 5 3"/></svg>
              Start Server
            </button>
            <a class="btn btn-sm" href="/servers/<%= vm.id %>/console">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14"><path d="M4 17l6-5-6-5M12 19h8"/></svg>
              Terminal
            </a>
            <a class="btn btn-sm" href="/servers/<%= vm.id %>/console?tab=bootlog" title="View Real-Time Live Boot Logs">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14"><path d="M13 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9z"/><polyline points="13 2 13 9 20 9"/></svg>
              Boot Logs
            </a>
          `;
        }
      }
    }
  } catch (_) {}
}

// Initial fetch and continuous live state polling every 2.5 seconds
updateLiveStats();
setInterval(updateLiveStats, 2500);
</script>
