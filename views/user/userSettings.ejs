<%- include('../partials/head', { title: 'Settings' }) %>
<%- include('../partials/ambient') %>
<%- include('../partials/topbar') %>
<%- include('../partials/sidebar') %>
<style>
  /* In-page settings sections - same look as the console tabs */
  .set-tabs { display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 18px; }
  .set-tab {
    background: rgba(15, 23, 42, 0.6);
    border: 1px solid var(--border);
    color: var(--text-muted);
    padding: 8px 16px;
    border-radius: var(--radius-sm);
    font-size: 13px;
    font-weight: 600;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    transition: all 0.2s ease;
  }
  .set-tab:hover { background: rgba(30, 41, 59, 0.8); color: #fff; border-color: var(--border-hover); }
  .set-tab.active { background: var(--accent); color: #fff; border-color: var(--accent-light); box-shadow: 0 0 14px var(--accent-glow); }
  .set-panel { display: none; }
  .set-panel.active { display: block; }
</style>
<div class="main">
  <h2 style="font-size:22px" class="mb-3">Settings</h2>
  <% if (typeof error !== 'undefined' && error) { %><div class="alert alert-error"><%= error %></div><% } %>
  <% if (typeof success !== 'undefined' && success) { %><div class="alert alert-success"><%= success %></div><% } %>

  <div class="set-tabs">
    <button type="button" class="set-tab active" data-settab="general">General</button>
    <button type="button" class="set-tab" data-settab="security">Security</button>
    <button type="button" class="set-tab" data-settab="integrations">Integrations</button>
    <button type="button" class="set-tab" data-settab="developer">Developer</button>
  </div>

  <!-- ======================= GENERAL ======================= -->
  <div class="set-panel active" id="setp-general">
    <div class="grid grid-2">
      <div class="card">
        <div class="card-title">Preferences</div>
        <form method="post" action="/settings">
          <div class="form-group"><label>Language</label>
            <select name="language">
              <option value="en" <%= user.language === 'en' ? 'selected' : '' %>>English</option>
              <option value="hi" <%= user.language === 'hi' ? 'selected' : '' %>>हिन्दी</option>
              <option value="es" <%= user.language === 'es' ? 'selected' : '' %>>Español</option>
              <option value="de" <%= user.language === 'de' ? 'selected' : '' %>>Deutsch</option>
              <option value="ar" <%= user.language === 'ar' ? 'selected' : '' %>>العربية</option>
            </select>
          </div>
          <button class="btn btn-primary" type="submit">Save Preferences</button>
        </form>
      </div>

      <div class="card">
        <div class="card-title">Music &amp; Sound</div>
        <p class="muted mb-2 text-sm">Soft calm ambient music while you work — no custom songs, just on/off and volume.</p>
        <div class="flex-between mb-2" style="gap:10px">
          <span class="text-sm" style="font-weight:600">Ambient Music</span>
          <label class="switch"><input type="checkbox" id="ambientMusicSwitch" <%= (user.music_enabled === 1 || user.music_enabled === '1' || user.music_enabled === true) ? 'checked' : '' %>/><span class="switch-slider"></span></label>
        </div>
        <div class="mb-3" id="ambientVolWrap" style="<%= (user.music_enabled === 1 || user.music_enabled === '1' || user.music_enabled === true) ? '' : 'opacity:0.4' %>">
          <div class="flex-between mb-1">
            <span class="text-sm">Music Volume</span>
            <span class="pill pill-green mono font-bold" id="ambientVolBadge"><%= (user.music_volume !== undefined && user.music_volume !== null) ? user.music_volume : '35' %>%</span>
          </div>
          <input type="range" id="ambientVol" min="0" max="100" step="1" value="<%= (user.music_volume !== undefined && user.music_volume !== null) ? user.music_volume : '35' %>"/>
        </div>
        <hr class="hr" style="margin:14px 0"/>
        <div class="flex-between mb-2" style="gap:10px">
          <span class="text-sm" style="font-weight:600">UI Sound Effects (clicks, toasts)</span>
          <label class="switch"><input type="checkbox" id="sfxToggle" <%= (user.sfx_enabled === undefined || user.sfx_enabled === 1 || user.sfx_enabled === '1' || user.sfx_enabled === true) ? 'checked' : '' %>/><span class="switch-slider"></span></label>
        </div>
        <div id="sfxVolWrap" style="<%= (user.sfx_enabled === undefined || user.sfx_enabled === 1 || user.sfx_enabled === '1' || user.sfx_enabled === true) ? '' : 'opacity:0.4' %>">
          <div class="flex-between mb-1">
            <span class="text-sm">Effects Volume</span>
            <span class="pill pill-blue mono font-bold" id="sfxVolBadge"><%= (user.sfx_volume !== undefined && user.sfx_volume !== null) ? user.sfx_volume : '40' %>%</span>
          </div>
          <input type="range" id="sfxVol" min="0" max="100" step="1" value="<%= (user.sfx_volume !== undefined && user.sfx_volume !== null) ? user.sfx_volume : '40' %>"/>
        </div>
      </div>

      <div class="card">
        <div class="card-title">Privacy</div>
        <p class="muted mb-2 text-sm">Blur sensitive information (passwords, tokens, API keys) on screen to protect against screen sharing. Hover a blurred value to briefly reveal it.</p>
        <div class="flex-between" style="gap:10px">
          <span class="text-sm" style="font-weight:600">Secret Blur</span>
          <label class="switch"><input type="checkbox" id="secretBlurToggle" data-sb-toggle <%= (user.secret_blur_set === 1 ? (user.secret_blur === 1 || user.secret_blur === '1' || user.secret_blur === true) : (String(settings['panel.secret_blur']) === '1' || settings['panel.secret_blur'] === true)) ? 'checked' : '' %>/><span class="switch-slider"></span></label>
        </div>
      </div>
    </div>
  </div>

  <!-- ======================= SECURITY ======================= -->
  <div class="set-panel" id="setp-security">
    <div class="card" style="max-width:640px">
      <div class="card-title">Two-Factor Authentication (2FA)</div>
      <% if (typeof tfaSetup !== 'undefined' && tfaSetup) { %>
        <div class="alert alert-info">
          Scan the QR code with your authenticator app (Google Authenticator, Authy, etc), then enter the 6-digit code below.
        </div>
        <div class="right mb-2"><img id="qrcode" src="/qrcode?data=<%= encodeURIComponent(tfaSetup.otpauth_url) %>" alt="QR code" style="background:#fff;border-radius:10px;padding:8px"/></div>
        <div class="form-group"><label>Code</label><input id="tfaCode" inputmode="numeric" placeholder="6-digit code"/></div>
        <div class="flex">
          <button class="btn btn-primary" onclick="enableTfa()">Enable 2FA</button>
          <button class="btn" onclick="window.location='/settings?tab=security'">Cancel</button>
        </div>
      <% } else { %>
        <% if (user.tfa_enabled) { %>
          <p class="muted mb-2">2FA is currently <strong>enabled</strong>. To disable, enter a current code.</p>
          <div class="form-group"><label>Code</label><input id="tfaCode2" inputmode="numeric" placeholder="6-digit code"/></div>
          <button class="btn btn-danger" onclick="disableTfa()">Disable 2FA</button>
        <% } else { %>
          <p class="muted mb-2">2FA is disabled. Protect your account with a TOTP authenticator app.</p>
          <a class="btn btn-primary" href="/settings/tfa/setup">Set up 2FA</a>
        <% } %>
      <% } %>
    </div>
  </div>

  <!-- ======================= INTEGRATIONS ======================= -->
  <%
    // ---- External providers. To add a new integration, drop one entry into
    // ---- this array - the row below renders for each of them automatically.
    var _providers = [
      {
        key: 'discord', name: 'Discord',
        linked: !!user.discord_id, ready: !!(String(settings['oauth.discord_client_id'] || settings['bot.client_id'] || '') && String(settings['oauth.discord_client_secret'] || settings['bot.client_secret'] || '')),
        avatar: user.discord_avatar, initial: (user.discord_name || user.discord_id || 'D')[0],
        label: user.discord_name || 'Discord user', pid: user.discord_id, linkedAt: user.discord_linked_at,
        href: '/settings/discord/link', unlinkFn: 'unlinkDiscord()', unlinkTitle: 'Unlink Discord',
        unlinkMsg: 'Unlink your Discord account? Invite and booster plans may stop counting until you link again.',
        blurb: 'Sign in with Discord, have invite / booster plans counted automatically, and receive DMs about plan warnings.'
      },
      {
        key: 'google', name: 'Google',
        linked: !!user.google_id, ready: !!(String(settings['google.client_id'] || '') && String(settings['google.client_secret'] || '')),
        avatar: user.google_avatar, initial: (user.google_name || user.google_id || 'G')[0],
        label: user.google_name || 'Google user', pid: user.google_id, linkedAt: user.google_linked_at,
        href: '/settings/google/link', unlinkFn: 'unlinkGoogle()', unlinkTitle: 'Unlink Google',
        unlinkMsg: 'Unlink your Google account? You will no longer be able to sign in with Google.',
        blurb: 'Sign in with your Google account — no password needed on shared devices.'
      }
    ];
    var _linkedCount = _providers.filter(function (p) { return p.linked; }).length;
  %>
  <div class="set-panel" id="setp-integrations">
    <div class="card">
      <div class="flex-between mb-1" style="align-items:center">
        <div class="card-title" style="margin:0">Connected Accounts</div>
        <span class="pill <%= _linkedCount === _providers.length ? 'pill-green' : (_linkedCount > 0 ? 'pill-yellow' : 'pill-red') %>"><%= _linkedCount %>/<%= _providers.length %> linked</span>
      </div>
      <p class="muted mb-2 text-sm">External accounts you can connect to the panel. Linked accounts let plans and sign-in follow you between services.</p>

      <div style="border-top:1px solid var(--border)">
        <% _providers.forEach(function (p) { %>
        <div class="flex-between" style="gap:12px;padding:14px 0;<%= p.key !== _providers[0].key ? 'border-top:1px solid var(--border);' : '' %>flex-wrap:wrap">
          <div class="flex" style="gap:12px;align-items:center;min-width:0">
            <% if (p.linked && p.avatar) { %><img src="<%= p.avatar %>" style="width:36px;height:36px;border-radius:50%;flex-shrink:0" alt="<%= p.name %> avatar"/><% } else { %><div class="avatar" style="width:36px;height:36px;font-size:15px;flex-shrink:0<%= p.linked ? '' : ';background:rgba(255,255,255,0.06);color:var(--muted)' %>"><%= p.linked ? p.initial : p.name[0] %></div><% } %>
            <div style="min-width:0">
              <div style="font-weight:600"><%= p.name %></div>
              <% if (p.linked) { %>
                <div class="muted text-sm" style="overflow:hidden;text-overflow:ellipsis;white-space:nowrap"><%= p.label %> &middot; <span class="mono"><%= p.pid %></span></div>
                <% if (p.linkedAt) { %><div class="muted text-sm">Linked <%= new Date(p.linkedAt).toLocaleDateString() %></div><% } %>
              <% } else { %>
                <div class="muted text-sm">Not linked</div>
              <% } %>
            </div>
          </div>
          <div class="flex" style="gap:8px;flex-shrink:0">
            <% if (p.linked) { %>
              <a class="btn btn-sm" href="<%= p.href %>">Re-authorize</a>
              <button class="btn btn-sm btn-danger" onclick="<%= p.unlinkFn %>">Unlink</button>
            <% } else if (p.ready) { %>
              <a class="btn btn-sm btn-primary" href="<%= p.href %>">Link</a>
            <% } else { %>
              <span class="muted text-sm">Not configured</span>
            <% } %>
          </div>
        </div>
        <% }) %>
      </div>
      <p class="muted text-sm" style="margin-top:12px">More integrations are on the way — new services will appear on this page as they arrive.</p>
    </div>
  </div>

  <!-- ======================= DEVELOPER ======================= -->
  <div class="set-panel" id="setp-developer">
    <div class="card">
      <div class="card-title">API Keys</div>
      <p class="muted mb-2 text-sm">Personal API keys with prefix <code class="mono">vp_live_</code>. Use them with <code class="mono">Authorization: Bearer &lt;key&gt;</code> for the Venlix REST API. Keys are shown once at creation.</p>
      <div class="table-wrap" style="margin-top:10px">
        <table>
          <thead><tr><th>Name</th><th>Prefix</th><th>Scopes</th><th>Last Used</th><th>Created</th><th class="right">Actions</th></tr></thead>
          <tbody id="apikeyRows">
            <tr><td colspan="6" class="muted">Loading…</td></tr>
          </tbody>
        </table>
      </div>
      <div class="grid grid-3" style="gap:12px;margin-top:14px">
        <div class="form-group" style="margin:0">
          <label>Name</label>
          <input id="ak_name" class="input" placeholder="e.g. ci-deploy" />
        </div>
        <div class="form-group" style="margin:0">
          <label>Scopes (comma-separated)</label>
          <input id="ak_scopes" class="input" placeholder="r_servers" value="r_servers" />
          <div class="muted mt-1">Enforced. <code>r_</code> scopes are read-only; any <code>w_</code> scope unlocks POST/PUT/PATCH/DELETE. <code>*</code> grants everything including <code>/admin</code>. Keys with only <code>r_</code> scopes cannot reach <code>/admin</code> at all.</div>
        </div>
        <div class="flex" style="align-items:flex-end">
          <button class="btn btn-primary" onclick="createApiKey()">Create Key</button>
        </div>
      </div>
    </div>
  </div>
</div>
<%- include('../partials/music') %>
<%- include('../partials/foot') %>
<script>
// ---------------- Section tabs (deep-linkable via ?tab=) ----------------
function switchSetTab(tab, push) {
  const known = ['general', 'security', 'integrations', 'developer'];
  if (known.indexOf(tab) === -1) tab = 'general';
  document.querySelectorAll('.set-tab').forEach((b) => b.classList.toggle('active', b.getAttribute('data-settab') === tab));
  document.querySelectorAll('.set-panel').forEach((p) => p.classList.toggle('active', p.id === 'setp-' + tab));
  if (history.replaceState) history.replaceState(null, null, '?tab=' + tab);
}
document.querySelectorAll('.set-tab').forEach((b) => b.addEventListener('click', () => switchSetTab(b.getAttribute('data-settab'))));

async function unlinkDiscord() {
  const ok = await VP.confirmDialog('Unlink your Discord account? Invite and booster plans may stop counting until you link again.', { title: 'Unlink Discord' });
  if (!ok) return;
  try {
    await VP.api('/settings/discord/unlink', { method: 'POST' });
    VP.toast('Discord account unlinked', 'success');
    setTimeout(() => location.reload(), 600);
  } catch (e) { VP.toast(e.message, 'error'); }
}
async function unlinkGoogle() {
  const ok = await VP.confirmDialog('Unlink your Google account? You will no longer be able to sign in with Google.', { title: 'Unlink Google' });
  if (!ok) return;
  try {
    await VP.api('/settings/google/unlink', { method: 'POST' });
    VP.toast('Google account unlinked', 'success');
    setTimeout(() => location.reload(), 600);
  } catch (e) { VP.toast(e.message, 'error'); }
}
async function enableTfa() {
  const code = document.getElementById('tfaCode').value;
  try {
    await VP.api('/settings/tfa/enable', { method: 'POST', body: { code } });
    VP.toast('2FA enabled', 'success');
    setTimeout(() => location.href = '/settings?tab=security', 700);
  } catch (e) { VP.toast(e.message, 'error'); }
}
async function disableTfa() {
  const code = (document.getElementById('tfaCode2') || {}).value;
  try {
    await VP.api('/settings/tfa/disable', { method: 'POST', body: { code } });
    VP.toast('2FA disabled', 'success');
    setTimeout(() => location.reload(), 700);
  } catch (e) { VP.toast(e.message, 'error'); }
}

// ---------- API Keys ----------
async function loadApiKeys() {
  const rows = document.getElementById('apikeyRows');
  const esc = (s) => String(s || '').replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
  try {
    const res = await VP.api('/api-keys');
    const keys = res.keys || [];
    if (!keys.length) {
      rows.innerHTML = '<tr><td colspan="6" class="muted">No API keys yet.</td></tr>';
      return;
    }
    rows.innerHTML = keys.map((k) => {
      const lastUsed = k.last_used_at ? new Date(k.last_used_at).toLocaleString() : 'never';
      return '<tr>'
        + '<td class="text-sm" style="font-weight:600">' + esc(k.name) + '</td>'
        + '<td class="mono text-sm">' + esc(k.key_prefix) + '…</td>'
        + '<td class="text-sm"><span class="pill pill-gray">' + esc(k.scopes || 'r_servers') + '</span></td>'
        + '<td class="text-sm">' + lastUsed + '</td>'
        + '<td class="text-sm">' + new Date(k.created_at).toLocaleDateString() + '</td>'
        + '<td class="right"><button class="btn btn-sm btn-danger" onclick="revokeApiKey(' + k.id + ',\'' + esc(k.name || '') + '\')">Revoke</button></td>'
        + '</tr>';
    }).join('');
  } catch (e) {
    rows.innerHTML = '<tr><td colspan="6" class="muted">Failed to load: ' + esc(e.message) + '</td></tr>';
  }
}
async function createApiKey() {
  const name = document.getElementById('ak_name').value.trim();
  const scopes = document.getElementById('ak_scopes').value.trim() || 'r_servers';
  if (!name) { VP.toast('Enter a name for the key', 'warning'); return; }
  try {
    const res = await VP.api('/api-keys', { method: 'POST', body: { name, scopes } });
    const html = '<div style="line-height:1.7">'
      + '<div style="font-weight:700;margin-bottom:6px;color:var(--red)">Copy this key now — it will not be shown again.</div>'
      + '<div class="mono" style="padding:10px;border:1px dashed var(--border);border-radius:8px;word-break:break-all;background:var(--glass)">' + res.key + '</div>'
      + '<div class="muted text-sm mt-2">Prefix: <code class="mono">' + res.prefix + '…</code></div>'
      + '</div>';
    await VP.confirmDialog(html, { title: 'API Key Created', html: true, danger: false, okText: 'I saved it', width: 'min(560px,92vw)' });
    loadApiKeys();
  } catch (e) { VP.toast(e.message, 'error'); }
}
async function revokeApiKey(id, name) {
  const ok = await VP.confirmDialog('Revoke API key' + (name ? ' “' + name + '”' : '') + '? This cannot be undone.', { title: 'Revoke API Key' });
  if (!ok) return;
  try {
    await VP.api('/api-keys/' + id, { method: 'DELETE' });
    VP.toast('API key revoked', 'success');
    loadApiKeys();
  } catch (e) { VP.toast(e.message, 'error'); }
}

// ---------------- Init ----------------
(function () {
  const p = new URLSearchParams(window.location.search).get('tab');
  switchSetTab(p || 'general'); // also normalises unknown values
})();
loadApiKeys();
</script>
